@@ -0,0 +1,73 @@
+"""Regression coverage for Gemma 4 packed BF16 expert checkpoints."""
+
+import os
+import sys
+import unittest
+
+import torch
+
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), ".."))
+from ci.ci_register import register_cpu_ci
+
+register_cpu_ci(est_time=5, suite="default")
+
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), "..", "..", "python", "utils"))
+import loader
+
+BF16SafeTensorLoader = loader.BF16SafeTensorLoader
+
+
+class _StubBF16Loader(BF16SafeTensorLoader):
+    def __init__(self, tensors):
+        self._tensors = tensors
+        self.tensor_file_map = {key: "stub.safetensors" for key in tensors}
+        self.file_handle_map = {}
+        self.tensor_type_map = {}
+        self.tensor_device_map = {}
+        self._detected_format = None
+        self._detect_format()
+
+    def load_tensor(self, key: str, device: str = "cpu"):
+        tensor = self._tensors[key]
+        return tensor if device == "cpu" else tensor.to(device)
+
+
+def _packed_tensors(prefix):
+    gate_up = torch.arange(2 * 6 * 4, dtype=torch.float32).to(torch.bfloat16).reshape(2, 6, 4)
+    down = torch.arange(2 * 4 * 3, dtype=torch.float32).to(torch.bfloat16).reshape(2, 4, 3)
+    return {
+        f"{prefix}.gate_up_proj": gate_up,
+        f"{prefix}.down_proj": down,
+    }
+
+
+class TestGemma4PackedBF16Loader(unittest.TestCase):
+    def test_detects_and_loads_direct_gemma4_prefix(self):
+        prefix = "model.language_model.layers.0.experts"
+        tensors = _packed_tensors(prefix)
+        stub = _StubBF16Loader(tensors)
+
+        self.assertEqual(stub._detected_format, "packed")
+        weights = stub.load_experts("model.language_model.layers.0")
+
+        self.assertEqual(len(weights["gate"]), 2)
+        self.assertEqual(tuple(weights["gate"][0].shape), (3, 4))
+        self.assertEqual(tuple(weights["up"][0].shape), (3, 4))
+        self.assertEqual(tuple(weights["down"][0].shape), (4, 3))
+        torch.testing.assert_close(
+            weights["gate"][0], tensors[f"{prefix}.gate_up_proj"][0, :3]
+        )
+
+    def test_resolves_model_layers_through_language_model(self):
+        prefix = "model.language_model.layers.7.experts"
+        tensors = _packed_tensors(prefix)
+        stub = _StubBF16Loader(tensors)
+
+        weights = stub.load_experts("model.layers.7")
+
+        torch.testing.assert_close(weights["gate"][1], tensors[f"{prefix}.gate_up_proj"][1, :3])
+        torch.testing.assert_close(weights["up"][1], tensors[f"{prefix}.gate_up_proj"][1, 3:])
+        torch.testing.assert_close(weights["down"][1], tensors[f"{prefix}.down_proj"][1])
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/kt-kernel/test/per_commit/test_moe_avx2_bf16_geglu.py b/kt-kernel/test/per_commit/test_moe_avx2_bf16_geglu.py
