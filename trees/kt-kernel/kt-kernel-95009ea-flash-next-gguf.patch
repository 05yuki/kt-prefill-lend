+// IQ4_NL: 32-wide blocks with a fp16 scale and a 16-entry non-linear LUT.
+// The LUT values reach |127|, so the Q4_0 accumulation (which packs 32-bit
+// partial sums to 16 bits) would saturate; this goes through Sum4_Q8, the
+// Q8_0 x Q8_0 accumulation that keeps 32-bit sums.
+static inline __m256i load_iq4nl_values_signed() {
+    static const int8_t kvalues[16] = {-127, -104, -83, -65, -49, -35, -22, -10, 1, 13, 25, 38, 53, 69, 89, 113};
+    auto v128 = _mm_loadu_si128((const __m128i *)kvalues);
+    return MM256_SET1_M128I(v128);
+}
+
+struct IQ4_NL_Dequantizer {
+    Dequantizer4bit b4;
+    const __m256i values = load_iq4nl_values_signed();
+    inline __m256i dequant(const block_iq4_nl * x) const {
+        return _mm256_shuffle_epi8(values, b4.dequant(x->qs));
+    }
+};
+
+struct IQ4_NL_Unpacker final : public Q_Unpacker<block_iq4_nl, ScaleHelperQ_0, IQ4_NL_Dequantizer> {
+    IQ4_NL_Unpacker(const void * vx, size_t bx) : Q_Unpacker(vx, bx) {}
+    inline static int block_size() { return QK4_NL; }
+};
+
+template <int nrc_y>
+void mul_mat_iq4_nl_q8_0_T(int n, const void * vx, size_t bx, const DataInfo& info, int nrc_x) {
+    assert(n%IQ4_NL_Unpacker::block_size() == 0);
+    Q8<nrc_y, block_q8_0> q8(info);
+    int nb = n/IQ4_NL_Unpacker::block_size();
+    if (nb%4 == 0) {
+        mul_mat_qX_q8_Helper<IQ4_NL_Unpacker, Sum4_Q8, AccumType0<nrc_y, true>, ScaleHelperQ_0, block_q8_0, nrc_y>(
+                nb, vx, bx, info, q8.y, nrc_x
+        );
+    } else {
+        mul_mat_qX_q8_Helper<IQ4_NL_Unpacker, Sum4_Q8, AccumType0<nrc_y, false>, ScaleHelperQ_0, block_q8_0, nrc_y>(
+                nb, vx, bx, info, q8.y, nrc_x
+        );
+    }
+}
+
+// Q2_0 (ggml type 42): 64 weights per block, one fp16 scale, 2-bit codes
+// 00/01/10/11 = -1/0/+1/+2 stored element-major (element j in byte j/4, bits
+// 2*(j%4)). One block pairs with two Q8_0 activation blocks. The codes are
+// unpacked to element order through 16-bit lanes (shift left by a per-position
+// factor, then a common shift right), minus one gives signed int8 in -1..2,
+// and SignedDot does the rest.
+struct Q2_0_Kernel {};
+
+struct Q2_0_Unpack {
+    // byte b of the 8-byte group is spread to elements 4b..4b+3
+    const __m128i rep_lo = _mm_set_epi8(3,3,3,3, 2,2,2,2, 1,1,1,1, 0,0,0,0);
+    const __m128i rep_hi = _mm_set_epi8(7,7,7,7, 6,6,6,6, 5,5,5,5, 4,4,4,4);
+    // element 4b+s needs (byte >> 2s): multiply by 2^(6-2s) then >> 6
+    const __m256i factors = _mm256_set_epi16(1,4,16,64, 1,4,16,64, 1,4,16,64, 1,4,16,64);
+    const __m256i m3 = _mm256_set1_epi16(3);
+    const __m256i mone = _mm256_set1_epi8(1);
+    inline __m256i codes16(__m128i bytes8, __m128i rep) const {
+        auto spread = _mm256_cvtepu8_epi16(_mm_shuffle_epi8(bytes8, rep));
+        return _mm256_and_si256(_mm256_srli_epi16(_mm256_mullo_epi16(spread, factors), 6), m3);
+    }
+    // 8 packed bytes -> 32 signed int8 values (code - 1) in element order
+    inline __m256i unpack32(const uint8_t * qs) const {
+        auto bytes8 = _mm_loadl_epi64((const __m128i *)qs);
+        auto lo = codes16(bytes8, rep_lo);
+        auto hi = codes16(bytes8, rep_hi);
+        auto packed = _mm256_permute4x64_epi64(_mm256_packus_epi16(lo, hi), 0xd8);
+        return _mm256_sub_epi8(packed, mone);
+    }
+};
+
+template <int nrc_y>
+void mul_mat_q2_0_q8_0_T(int n, const void * vx, size_t bx, const DataInfo& info, int nrc_x) {
+    assert(n%QK2_0 == 0);
+    const int nb = n/QK2_0;
+    Q8<nrc_y, block_q8_0> q8(info);
+    Q2_0_Unpack unpack;
+    SignedDot dot;
+    __m256 acc[nrc_y];
+    for (int ix = 0; ix < nrc_x; ++ix) {
+        const block_q2_0 * x = (const block_q2_0 *)((const char *)vx + ix*bx);
+        for (int iy = 0; iy < nrc_y; ++iy) acc[iy] = _mm256_setzero_ps();
+        for (int i = 0; i < nb; ++i) {
+            const float dx = GGML_FP16_TO_FP32(x[i].d);
+            auto q0 = unpack.unpack32(x[i].qs + 0);
+            auto q1 = unpack.unpack32(x[i].qs + 8);
+            for (int iy = 0; iy < nrc_y; ++iy) {
+                const block_q8_0 * y = q8.y[iy] + 2*i;
+                auto p0 = dot.compute(q0, _mm256_loadu_si256((const __m256i *)y[0].qs));
+                auto p1 = dot.compute(q1, _mm256_loadu_si256((const __m256i *)y[1].qs));
+                acc[iy] = _mm256_fmadd_ps(_mm256_set1_ps(dx*GGML_FP16_TO_FP32(y[0].d)), _mm256_cvtepi32_ps(p0), acc[iy]);
+                acc[iy] = _mm256_fmadd_ps(_mm256_set1_ps(dx*GGML_FP16_TO_FP32(y[1].d)), _mm256_cvtepi32_ps(p1), acc[iy]);
+            }
+        }
+        for (int iy = 0; iy < nrc_y; ++iy) info.store(ix, iy, hsum_float_8(acc[iy]));
+    }
+}
