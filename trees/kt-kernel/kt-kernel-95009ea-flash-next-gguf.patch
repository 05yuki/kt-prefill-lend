+    mversion_.fetch_add(1, std::memory_order_release);
+    return idx;
+  }
+
+  void memop_poller() {
+    std::vector<MemopEntry> snap;
+    uint64_t seen = ~0ull;
+    while (!mstop_.load(std::memory_order_relaxed)) {
+      const uint64_t v = mversion_.load(std::memory_order_acquire);
+      if (v != seen) {
+        std::lock_guard<std::mutex> g(mmtx_);
+        snap = mentries_;
+        seen = mversion_.load(std::memory_order_acquire);
+      }
+      std::vector<int> retire;
+      // Arming order is stream order, so within one scan a submit is handled
+      // before the sync that follows it.
+      for (const MemopEntry& e : snap) {
+        if (*req_host(e.idx) != 1) continue;
+        *req_host(e.idx) = 0;
+        if (!e.sync) {
+          e.func(e.args);
+        } else {
+          task_queue_->sync(e.allow);
+          std::atomic_thread_fence(std::memory_order_release);
+          *done_host(e.idx) = 1;
+        }
+        if (!e.permanent) retire.push_back(e.idx);
+      }
+      __builtin_ia32_pause();
+      if (!retire.empty()) {
+        std::lock_guard<std::mutex> g(mmtx_);
+        for (int idx : retire) {
+          for (size_t i = 0; i < mentries_.size(); i++) {
+            if (!mentries_[i].permanent && mentries_[i].idx == idx) {
+              mentries_.erase(mentries_.begin() + i);
+              break;
+            }
+          }
+        }
+        mversion_.fetch_add(1, std::memory_order_release);
+      }
+    }
+  }
 };
 
 #endif
diff --git a/kt-kernel/cpu_backend/kt_knobs.h b/kt-kernel/cpu_backend/kt_knobs.h
new file mode 100644
index 0000000..ba6e454
--- /dev/null
+++ b/kt-kernel/cpu_backend/kt_knobs.h
@@ -0,0 +1,44 @@
+// kt-kernel-live-knobs.py: named int knobs that can change at run time
+#pragma once
+#include <atomic>
+#include <cstdlib>
+#include <map>
+#include <mutex>
+#include <string>
+
+inline std::mutex& kt_knobs_mutex() {
+  static std::mutex m;
+  return m;
+}
+inline std::map<std::string, std::atomic<int>*>& kt_knobs_table() {
+  static std::map<std::string, std::atomic<int>*> t;
+  return t;
+}
+// the cell for `name`, created from the environment (or dflt) on first use;
+// callers keep the reference in a function-local static and load() it per call
+inline std::atomic<int>& kt_knob(const char* name, int dflt) {
+  std::lock_guard<std::mutex> g(kt_knobs_mutex());
+  auto& t = kt_knobs_table();
+  auto it = t.find(name);
+  if (it == t.end()) {
+    const char* e = getenv(name);
+    it = t.emplace(name, new std::atomic<int>(e ? atoi(e) : dflt)).first;
+  }
+  return *it->second;
+}
+inline void kt_knob_set(const std::string& name, int v) {
+  std::lock_guard<std::mutex> g(kt_knobs_mutex());
+  auto& t = kt_knobs_table();
+  auto it = t.find(name);
+  if (it == t.end()) {
+    t.emplace(name, new std::atomic<int>(v));
+  } else {
+    it->second->store(v, std::memory_order_relaxed);
+  }
+}
+inline int kt_knob_get(const std::string& name) {
+  std::lock_guard<std::mutex> g(kt_knobs_mutex());
+  auto& t = kt_knobs_table();
+  auto it = t.find(name);
+  return it == t.end() ? -1 : it->second->load(std::memory_order_relaxed);
+}
