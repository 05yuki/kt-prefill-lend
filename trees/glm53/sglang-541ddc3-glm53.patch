+++ b/python/sglang/srt/layers/moe/glm53_nvfp4_to_fp8.py
@@ -0,0 +1,137 @@
+"""NVFP4 -> FP8 block expansion for the GPU prefill slot.
+
+v1 kept contiguous access and decoded E2M1 with a chain of seven selects:
+128 GB/s. v2 replaced the chain with a 16-entry table and paid for it — a
+table read is a gather, which is the same trap that was closed on the CPU side
+this morning, and splitting the store by nibble parity made the writes
+strided: 42 GB/s.
+
+So: v1's access pattern, with the two things that were actually expensive
+removed. The division by the block scale becomes one reciprocal and a
+multiply, and E2M1 becomes its float bits assembled directly —
+
+    e = code >> 1, m = code & 1
+    e == 0 : 0 or 0.5
+    e  > 0 : exponent field 126 + e, mantissa bit m << 22
+
+which is five operations and no memory at all.
+"""
+
+import torch
+import triton
+import triton.language as tl
+
+FP8_MAX = 448.0
+BLOCK = 128
+GROUP = 16
+
+
+@triton.jit
+def _expand(
+    packed_ptr,      # uint8 [N, K // 2], low nibble is the even k
+    s16_ptr,         # float32 [N, K // GROUP]
+    out_ptr,         # float8_e4m3 [N, K]
+    oscale_ptr,      # float32 [N // BLOCK, K // BLOCK]
+    N, K,
+    packed_sn, s16_sn, out_sn, oscale_sn,
+    BLOCK_N: tl.constexpr,
+    BLOCK_K: tl.constexpr,
+    GROUP_K: tl.constexpr,
+):
+    pid_n = tl.program_id(0)
+    pid_k = tl.program_id(1)
+    rn = pid_n * BLOCK_N + tl.arange(0, BLOCK_N)
+    rk = pid_k * BLOCK_K + tl.arange(0, BLOCK_K)
+    mask = (rn < N)[:, None] & (rk < K)[None, :]
+
+    byte = tl.load(packed_ptr + rn[:, None] * packed_sn + (rk[None, :] // 2),
+                   mask=mask, other=0).to(tl.int32)
+    code = tl.where((rk[None, :] % 2) == 0, byte & 0x0F, (byte >> 4) & 0x0F)
+
+    e = (code >> 1) & 3
+    m = code & 1
+    bits = tl.where(e == 0,
+                    tl.where(m == 1, 0x3F000000, 0),
+                    ((126 + e) << 23) | (m << 22))
+    val = bits.to(tl.uint32, bitcast=True).to(tl.float32, bitcast=True)
+    val = tl.where((code & 8) != 0, -val, val)
+
+    s = tl.load(s16_ptr + rn[:, None] * s16_sn + (rk[None, :] // GROUP_K),
+                mask=mask, other=0.0)
+    w = val * s
+
+    amax = tl.max(tl.abs(tl.where(mask, w, 0.0)))
+    scale = amax / 448.0
+    scale = tl.where(scale > 0, scale, 1.0)
+    inv = 1.0 / scale
+
+    q = tl.minimum(tl.maximum(w * inv, -448.0), 448.0)
+    tl.store(out_ptr + rn[:, None] * out_sn + rk[None, :],
+             q.to(tl.float8e4nv), mask=mask)
+    tl.store(oscale_ptr + pid_n * oscale_sn + pid_k, scale)
+
+
+def nvfp4_to_fp8_block(packed, s16, out=None, oscale=None, num_warps=8):
+    assert packed.dtype == torch.uint8 and s16.dtype == torch.float32
+    N = packed.shape[0]
+    K = packed.shape[1] * 2
+    assert s16.shape == (N, K // GROUP), (s16.shape, (N, K // GROUP))
+    assert N % BLOCK == 0 and K % BLOCK == 0, (N, K)
+    if out is None:
+        out = torch.empty((N, K), dtype=torch.float8_e4m3fn, device=packed.device)
+    if oscale is None:
+        oscale = torch.empty((N // BLOCK, K // BLOCK), dtype=torch.float32,
+                             device=packed.device)
+    _expand[(N // BLOCK, K // BLOCK)](
+        packed, s16, out, oscale,
+        N, K,
+        packed.stride(0), s16.stride(0), out.stride(0), oscale.stride(0),
+        BLOCK_N=BLOCK, BLOCK_K=BLOCK, GROUP_K=GROUP,
+        num_warps=num_warps,
+    )
+    return out, oscale
+
+
+if __name__ == "__main__":
+    import sys
+    import time
+
+    sys.path.insert(0, "/tmp")
+    from glm53_nvfp4_reference import dequant, reference
+
+    torch.manual_seed(0)
+    dev = "cuda"
+    for N, K in ((256, 512), (2048, 4096), (4096, 1024)):
+        packed = torch.randint(0, 256, (N, K // 2), dtype=torch.uint8, device=dev)
+        s16 = (torch.rand(N, K // GROUP, device=dev) * 0.01 + 1e-4).float()
+        g, gs = nvfp4_to_fp8_block(packed, s16)
+        r, rs = reference(packed, s16)
+        exact = dequant(packed, s16)
+        back = g.double().reshape(N // BLOCK, BLOCK, K // BLOCK, BLOCK) * \
+            gs.double()[:, None, :, None]
+        err = (back.reshape(N, K) - exact).abs().mean() / exact.abs().mean()
+        print(f"N={N:5d} K={K:5d}  values equal {torch.equal(g.float(), r.float())}"
+              f"  scales equal {torch.equal(gs, rs)}  round trip {err:.4%}")
+
+    print()
+    for warps in (4, 8, 16):
+        total = 0.0
+        line = []
+        for tag, (N, K) in (("w13", (2048, 4096)), ("w2", (4096, 1024))):
+            packed = torch.randint(0, 256, (N, K // 2), dtype=torch.uint8, device=dev)
+            s16 = (torch.rand(N, K // GROUP, device=dev) * 0.01 + 1e-4).float()
+            out = torch.empty((N, K), dtype=torch.float8_e4m3fn, device=dev)
+            osc = torch.empty((N // BLOCK, K // BLOCK), dtype=torch.float32, device=dev)
+            for _ in range(5):
+                nvfp4_to_fp8_block(packed, s16, out, osc, warps)
+            torch.cuda.synchronize()
+            t0 = time.perf_counter()
+            for _ in range(30):
+                nvfp4_to_fp8_block(packed, s16, out, osc, warps)
+            torch.cuda.synchronize()
+            dt = (time.perf_counter() - t0) / 30
+            moved = packed.numel() + s16.numel() * 4 + N * K + osc.numel() * 4
+            line.append(f"{tag} {dt * 1e6:6.1f} us {moved / dt / 1e9:6.1f} GB/s")
+            total += dt
+        print(f"warps={warps:2d}  " + "   ".join(line) +
+              f"   -> {total * 288 * 42:5.2f} s a chunk")
