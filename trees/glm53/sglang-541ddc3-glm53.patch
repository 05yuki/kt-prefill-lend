 from __future__ import annotations
 
+import os
+
 import torch
+import triton
+import triton.language as tl
+from triton.language.extra.cuda import libdevice
 from torch import nn
 
 
+@triton.jit
+def _glm5_next_rmsnorm_tail_kernel(
+    x_ptr,
+    variance_ptr,
+    weight_ptr,
+    output_ptr,
+    hidden_size: tl.constexpr,
+    eps: tl.constexpr,
+    block_size: tl.constexpr,
+):
+    row = tl.program_id(0)
+    offsets = tl.program_id(1) * block_size + tl.arange(0, block_size)
+    mask = offsets < hidden_size
+    x = tl.load(
+        x_ptr + row * hidden_size + offsets, mask=mask, other=0.0
+    ).to(tl.float32)
+    reciprocal_rms = libdevice.rsqrt(tl.load(variance_ptr + row) + eps)
+    # This BF16 boundary is part of GLM-5-Next's released arithmetic.
+    normalized = (x * reciprocal_rms).to(tl.bfloat16).to(tl.float32)
+    weight = tl.load(weight_ptr + offsets, mask=mask, other=0.0).to(tl.float32)
+    tl.store(
+        output_ptr + row * hidden_size + offsets,
+        normalized * weight,
+        mask=mask,
+    )
+
+
+def _use_fused_rmsnorm_tail() -> bool:
+    return os.environ.get("SGLANG_GLM53_FUSED_RMSNORM_TAIL", "0") == "1"
+
+
