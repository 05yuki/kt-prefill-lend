+"""KT_LAUNCH_TIMING=1: a per-step timeline of the weight load (launch-time
+instrument, no behaviour change). Installed from ModelRunner.load_model
+(patches/sglang-kt-launch-timing.py); wraps the load's functions in place and
+prints, per rank process:
+
+  [kt-launch HH:MM:SS.mmm r<rank>] <step> <seconds> s | disk <GB> (<GB/s>) | <extra>
+
+"disk" is this process's /proc/self/io read_bytes over the step (bytes the
+block layer fetched for it: read() and mmap page faults that missed the page
+cache). Steps that run many times (a tensor fetch, a layer's CPU experts) are
+summed per kind and printed in a table when the target's load ends.
+"""
+import functools
+import os
+import re
+import resource
+import threading
+import time
+from collections import defaultdict
+
+ENABLED = os.environ.get("KT_LAUNCH_TIMING") == "1"
+_installed = False
+_rank = None
+_lock = threading.Lock()
+_sums = defaultdict(lambda: [0, 0.0, 0, 0])  # kind -> [count, seconds, bytes copied, disk bytes]
+_t_install = None
+
+
+def _io():
+    try:
+        with open("/proc/self/io") as f:
+            d = dict(line.split(": ") for line in f.read().splitlines())
+        return int(d["read_bytes"]), int(d["rchar"])
+    except Exception:
+        return 0, 0
+
+
+def _faults():
+    r = resource.getrusage(resource.RUSAGE_SELF)
+    return r.ru_majflt, r.ru_minflt
+
+
+def _r():
+    global _rank
+    if _rank is None:
+        try:
+            from sglang.srt.distributed import get_tensor_model_parallel_rank
+
+            _rank = get_tensor_model_parallel_rank()
+        except Exception:
+            return "?"
+    return _rank
+
+
+def log(msg: str) -> None:
+    t = time.time()
+    print(f"[kt-launch {time.strftime('%H:%M:%S', time.localtime(t))}.{int(t * 1000) % 1000:03d} r{_r()}] {msg}", flush=True)
+
+
+class step:
+    """with step("name", nbytes=...): one timed step, printed at its end."""
+
+    def __init__(self, name, nbytes=0, quiet=False, kind=None):
+        self.name, self.nbytes, self.quiet, self.kind = name, nbytes, quiet, kind
+
+    def __enter__(self):
+        self.t0 = time.perf_counter()
+        self.io0 = _io()
+        self.f0 = _faults()
+        return self
+
+    def __exit__(self, *exc):
+        dt = time.perf_counter() - self.t0
+        io1 = _io()
+        f1 = _faults()
+        disk = io1[0] - self.io0[0]
+        if self.kind:
+            with _lock:
+                s = _sums[self.kind]
+                s[0] += 1
+                s[1] += dt
+                s[2] += self.nbytes
+                s[3] += disk
+        if not self.quiet:
+            extra = f" | copied {self.nbytes / 1e9:.2f} GB ({self.nbytes / 1e9 / max(dt, 1e-9):.2f} GB/s)" if self.nbytes else ""
+            log(f"{self.name} {dt:.2f} s | disk {disk / 1e9:.2f} GB ({disk / 1e9 / max(dt, 1e-9):.2f} GB/s)"
+                f" | majflt {f1[0] - self.f0[0]} minflt {f1[1] - self.f0[1]}{extra}")
+        return False
+
+
+def _wrap(obj, attr, name=None, kind=None, quiet=False, nbytes_of=None):
+    fn = getattr(obj, attr, None)
+    if fn is None or getattr(fn, "_kt_launch_wrapped", False):
+        return
+    label = name or f"{getattr(obj, '__name__', obj)}.{attr}"
+
+    @functools.wraps(fn)
+    def w(*a, **k):
+        st = step(label, kind=kind, quiet=quiet)
+        with st:
+            out = fn(*a, **k)
+            if nbytes_of is not None:
+                try:
+                    st.nbytes = nbytes_of(a, k, out)
+                except Exception:
+                    pass
+        return out
+
+    w._kt_launch_wrapped = True
+    if isinstance(obj, type) and isinstance(obj.__dict__.get(attr), staticmethod):
+        setattr(obj, attr, staticmethod(w))
+    else:
+        setattr(obj, attr, w)
+
+
+def _kind_gguf(name):
+    if "ngram_embedding" in name:
+        return "PLE table shard"
+    if name.endswith("qweight") or name.endswith("qweight_type"):
+        return "dense GGUF blocks"
+    return "dense bf16/f32"
+
+
+def _kind_safetensors(name):
+    """DeepSeek V4 / V4.1 checkpoint names (V4.1 launch, 10-12)."""
+    if ".experts." in name:
+        return "routed experts (KT: skipped or GPU slots)"
+    if ".engram." in name:
+        return "engram"
+    if ".wo_a." in name:
+        return "wo_a"
+    return "dense"
+
+
+def _wrap_iter(gen_fn_owner, attr, kind_of=_kind_gguf):
+    """A weight iterator: the time spent producing each item (the GGUF read and
+    dequant) and consuming it (the model's weight_loader: the GPU copy, the
+    PLE rows into pinned memory), per kind of tensor."""
+    fn = getattr(gen_fn_owner, attr)
+    if getattr(fn, "_kt_launch_wrapped", False):
+        return
+
+    @functools.wraps(fn)
+    def w(*a, **k):
+        t_all = time.perf_counter()
+        io_all = _io()
+        it = iter(fn(*a, **k))
+        n = 0
+        while True:
+            t0 = time.perf_counter()
+            io0 = _io()
+            try:
+                name, t = next(it)
+            except StopIteration:
+                break
+            t1 = time.perf_counter()
+            io1 = _io()
+            kd = kind_of(name)
+            nb = t.numel() * t.element_size() if hasattr(t, "numel") else 0
+            with _lock:
+                s = _sums["produce: " + kd]
+                s[0] += 1
+                s[1] += t1 - t0
+                s[2] += nb
+                s[3] += io1[0] - io0[0]
+            yield name, t
+            t2 = time.perf_counter()
+            io2 = _io()
+            with _lock:
+                s = _sums["consume: " + kd]
+                s[0] += 1
+                s[1] += t2 - t1
+                s[2] += nb
+                s[3] += io2[0] - io1[0]
+            n += 1
+        dt = time.perf_counter() - t_all
+        log(f"weight iterator {attr}: {n} tensors in {dt:.2f} s | disk {(_io()[0] - io_all[0]) / 1e9:.2f} GB")
+
+    w._kt_launch_wrapped = True
+    setattr(gen_fn_owner, attr, w)
+    return w
+
+
+def summary(title):
+    with _lock:
+        rows = sorted(_sums.items(), key=lambda kv: -kv[1][1])
+    log(f"--- {title}: summed steps (count, seconds, GB copied, GB from disk) ---")
+    for kind, (n, sec, nb, disk) in rows:
+        rate = f" {nb / 1e9 / sec:.2f} GB/s" if nb and sec > 0 else ""
+        log(f"  {kind:<48s} n={n:<6d} {sec:8.2f} s  {nb / 1e9:8.2f} GB{rate}  disk {disk / 1e9:.2f} GB")
+
+
+_stacks = defaultdict(int)
+_stack_samples = [0]
+_leaves = defaultdict(int)
+_stack_stop = threading.Event()
+
+
+def _stack_sampler(main_id, interval):
+    """KT_LAUNCH_TIMING_STACKS=<seconds>: samples the loading thread's stack;
+    the summary lists the frames by inclusive share of the samples."""
+    import sys
+
+    while not _stack_stop.wait(interval):
+        f = sys._current_frames().get(main_id)
+        leaf, g = [], f
+        while g is not None and len(leaf) < 5:
+            leaf.append(f"{'/'.join(g.f_code.co_filename.split('/')[-2:])}:{g.f_code.co_name}:{g.f_lineno}")
+            g = g.f_back
+        _leaves[" < ".join(leaf)] += 1
+        seen = set()
+        while f is not None:
+            c = f.f_code
+            fn = c.co_filename
+            short = "/".join(fn.split("/")[-2:])
+            key = f"{short}:{c.co_name}"
+            if key not in seen:
+                seen.add(key)
+                _stacks[key] += 1
+            f = f.f_back
+        _stack_samples[0] += 1
+
+
+def stack_summary(top=45):
+    n = _stack_samples[0]
+    if not n:
+        return
+    iv = float(os.environ.get("KT_LAUNCH_TIMING_STACKS", "0") or 0)
+    log(f"--- stack samples: {n} x {iv} s (inclusive) ---")
+    for k, c in sorted(_stacks.items(), key=lambda kv: -kv[1])[:top]:
+        log(f"  {c * iv:8.1f} s  {100.0 * c / n:5.1f}%  {k}")
+    log("--- innermost 5 frames (exclusive) ---")
+    for k, c in sorted(_leaves.items(), key=lambda kv: -kv[1])[:40]:
+        log(f"  {c * iv:8.1f} s  {k}")
+
+
+def install(runner=None) -> None:
+    global _installed, _t_install
+    if not ENABLED:
