diff --git a/python/sglang/srt/layers/moe/glm53_nvfp4_moe.py b/python/sglang/srt/layers/moe/glm53_nvfp4_moe.py
new file mode 100644
index 0000000..7f1d426
--- /dev/null
+++ b/python/sglang/srt/layers/moe/glm53_nvfp4_moe.py
@@ -0,0 +1,56 @@
+"""The GPU prefill MoE for a slot that holds kt's NVFP4.
+
+sglang's grouped-quant MoE GEMM already wants exactly this layout: weights as
+(experts, N, K/2) with two nibbles packed along K low-first, and one scale per
+group of K. The only thing it lacked was E2M1, which is five lines inside the
+kernel. So there is no separate GEMM here -- this only hands the slot's
+tensors to ``fused_experts_impl`` with the flag set, and keeps GLM-5-Next's
+two-round SwiGLU and routing contract exactly as the FP8 path had them.
+"""
+
+from __future__ import annotations
+
+import torch
+
+from sglang.srt.layers.moe.fused_moe_triton.fused_moe import fused_experts_impl
+from sglang.srt.layers.moe.token_dispatcher import StandardCombineInput
+
+NVFP4_GROUP = 16
+
+
+def apply_nvfp4_experts(layer: torch.nn.Module, dispatch_output):
+    """Run one MoE layer with the prefill slot read as NVFP4."""
+    config = layer.moe_runner_config
