diff --git a/python/sglang/srt/models/glm5_next_nextn.py b/python/sglang/srt/models/glm5_next_nextn.py
new file mode 100644
index 0000000..cf5855e
--- /dev/null
+++ b/python/sglang/srt/models/glm5_next_nextn.py
@@ -0,0 +1,276 @@
+"""GLM-5-Next MTP draft model: the checkpoint's layer 45, served as a NextN head.
+
+Decode on this host is 62 ms a token with nothing but exact arithmetic, and
+33 ms of that is the GPU side, paid once per forward pass whatever the pass
+holds. A draft token verified in the same pass rides that cost for free, and
+on the CPU side a second token reads each expert's weights once wherever the
+two tokens route together. That is the whole case for MTP here, and the head
+is already in the checkpoint: ``model.language_model.layers.45`` carries
+``eh_proj``, ``enorm``, ``hnorm``, ``shared_head.norm``, a DSA attention with
+its own indexer, and a full MoE with 288 routed experts and a shared expert.
+Nothing hyper-connected — the layer is a plain residual block.
+
+What differs from the main layers, and why each choice is what it is:
+
+  * No mHC. The checkpoint has no ``hc_*`` tensors for this layer, so the
+    residual path is written out here rather than routed through
+    ``Glm5NextDecoderLayer``, whose constructor pins ``mhc_enabled = True`` and
+    whose norms are the checkpoint-native single-argument kind that the
+    inherited non-mHC path cannot call.
+  * Two layer ids. The draft runner's KV pool has one attention slot, indexed
+    0, so the attention is built with ``layer_id=0``; the routed experts are
+    loaded by the CPU wrapper from ``layers.{layer_idx}`` on disk, so the MoE
+    is built with ``layer_idx=45``. Building through the shared factory would
+    force both to the same number.
+  * ``is_nextn=False`` on the attention. In the DeepSeek parent that flag
+    exists to skip the indexer top-k on MTP layers that ship no indexer
+    weights. This layer ships them, so it runs the indexer like any DSA layer;
+    the GLM subclass refuses the flag outright for the same reason.
+  * The norms are ``Glm5NextRMSNorm``: cast to bf16 before the weight, the
+    rounding boundary the released model uses. The shared fused norm rounds
+    after, which is a different number.
+
+The embedding and the head are the target's own tensors, installed by the
+speculative worker through ``set_embed_and_head``; the checkpoint carries no
+``layers.45.shared_head.head``.
+"""
+
+from __future__ import annotations
+
+import logging
+from typing import Iterable, Optional, Tuple
+
+import torch
+from torch import nn
+
+from sglang.srt.distributed import get_pp_group, get_tensor_model_parallel_world_size
+from sglang.srt.eplb.expert_distribution import get_global_expert_distribution_recorder
+from sglang.srt.layers.communicator import AttentionInputs, get_attn_tp_context
+from sglang.srt.layers.logits_processor import LogitsProcessor
+from sglang.srt.layers.quantization.base_config import QuantizationConfig
+from sglang.srt.layers.vocab_parallel_embedding import ParallelLMHead, VocabParallelEmbedding
+from sglang.srt.model_executor.forward_batch_info import ForwardBatch
+from sglang.srt.models.glm5_next import (
+    Glm5NextForConditionalGeneration,
+    normalize_glm5_next_weight_name,
+)
+from sglang.srt.models.glm5_next_dsa import Glm5NextDSAAttention
+from sglang.srt.models.glm5_next_moe import Glm5NextMoE
+from sglang.srt.models.glm5_next_norm import Glm5NextRMSNorm
+from sglang.srt.server_args import get_global_server_args
+from sglang.srt.utils import add_prefix
+from sglang.srt.utils.common import BumpAllocator
+
+logger = logging.getLogger(__name__)
+
+
+def _text_config(config):
+    return config.text_config if hasattr(config, "text_config") else config
+
+
+class Glm5NextDecoderLayerNextN(nn.Module):
+    """Layer 45 as the checkpoint has it: norm, DSA, residual, norm, MoE, residual."""
+
+    def __init__(
+        self,
+        config,
+        quant_config: Optional[QuantizationConfig],
+        prefix: str,
+        alt_stream: Optional[torch.cuda.Stream],
+    ) -> None:
+        super().__init__()
+        mtp_layer_idx = config.num_hidden_layers  # 45 in the pinned checkpoint
+        self.self_attn = Glm5NextDSAAttention(
+            config=config,
+            layer_id=0,
+            hidden_size=config.hidden_size,
+            num_heads=config.num_attention_heads,
+            quant_config=quant_config,
+            prefix=add_prefix("self_attn", prefix),
+            qk_nope_head_dim=config.qk_nope_head_dim,
+            qk_rope_head_dim=config.qk_rope_head_dim,
+            v_head_dim=config.v_head_dim,
+            q_lora_rank=config.q_lora_rank,
+            kv_lora_rank=config.kv_lora_rank,
+            rope_theta=config.rope_theta,
+            rope_scaling=config.rope_scaling,
+            max_position_embeddings=config.max_position_embeddings,
+            alt_stream=alt_stream,
+            skip_rope=True,
+        )
+        self.mlp = Glm5NextMoE(
+            config=config,
+            quant_config=quant_config,
+            layer_idx=mtp_layer_idx,
+            prefix=add_prefix("mlp", prefix),
+            alt_stream=alt_stream,
+        )
+        self.input_layernorm = Glm5NextRMSNorm(config.hidden_size, eps=config.rms_norm_eps)
+        self.post_attention_layernorm = Glm5NextRMSNorm(
+            config.hidden_size, eps=config.rms_norm_eps
+        )
+
+    def forward(
+        self,
+        positions: torch.Tensor,
+        hidden_states: torch.Tensor,
+        forward_batch: ForwardBatch,
+        zero_allocator: BumpAllocator,
+    ) -> torch.Tensor:
+        residual = hidden_states
+        hidden_states = self.input_layernorm(hidden_states)
+        # DSA's absorb path fetches its Q/KV latent through the attention-TP
+        # context; the main model's layer communicator installs it in
+        # prepare_attn, and this layer has no communicator.
+        get_attn_tp_context().set_attn_inputs(
+            AttentionInputs(hidden_states, forward_batch, self.self_attn.prepare_qkv_latent)
+        )
+        hidden_states = self.self_attn(
+            positions=positions,
+            hidden_states=hidden_states,
+            forward_batch=forward_batch,
+            zero_allocator=zero_allocator,
+        )
+        hidden_states = residual + hidden_states
+        residual = hidden_states
+        hidden_states = self.post_attention_layernorm(hidden_states)
+        hidden_states = self.mlp(hidden_states, forward_batch=forward_batch)
+        return residual + hidden_states
+
+
+class Glm5NextModelNextN(nn.Module):
+    def __init__(
+        self,
+        config,
+        quant_config: Optional[QuantizationConfig] = None,
+        prefix: str = "",
+    ) -> None:
+        super().__init__()
+        config = _text_config(config)
+        self.config = config
+        self.vocab_size = config.vocab_size
+        self.embed_tokens = VocabParallelEmbedding(
+            config.vocab_size,
+            config.hidden_size,
+            prefix=add_prefix("embed_tokens", prefix),
+        )
+        self.enorm = Glm5NextRMSNorm(config.hidden_size, eps=config.rms_norm_eps)
+        self.hnorm = Glm5NextRMSNorm(config.hidden_size, eps=config.rms_norm_eps)
+        self.eh_proj = nn.Linear(2 * config.hidden_size, config.hidden_size, bias=False)
+        self.alt_stream = torch.cuda.Stream() if torch.cuda.is_available() else None
+        # The attribute stays ``decoder`` (the loader mixin renames
+        # ``model.layers.45.`` to it), but the quantization prefix must be the
+        # checkpoint's own: the FP8 config's modules_to_not_convert names
+        # ``layers.45.self_attn.kv_b_proj`` and the indexer projections by
+        # that path, and they ship in bf16.
+        self.decoder = Glm5NextDecoderLayerNextN(
+            config,
+            quant_config=quant_config,
+            prefix=add_prefix(f"layers.{config.num_hidden_layers}", prefix),
+            alt_stream=self.alt_stream,
+        )
+        self.shared_head = nn.Module()
+        self.shared_head.norm = Glm5NextRMSNorm(config.hidden_size, eps=config.rms_norm_eps)
+
+    def forward(
+        self,
+        input_ids: torch.Tensor,
+        positions: torch.Tensor,
+        forward_batch: ForwardBatch,
+        input_embeds: Optional[torch.Tensor] = None,
+    ) -> torch.Tensor:
+        hidden_states = self.embed_tokens(input_ids) if input_embeds is None else input_embeds
+        if hidden_states.shape[0] > 0:
+            hidden_states = self.eh_proj(
+                torch.cat(
+                    (
+                        self.enorm(hidden_states),
+                        self.hnorm(forward_batch.spec_info.hidden_states),
+                    ),
+                    dim=-1,
+                )
+            )
+        # One layer, two zero slots: what the main model allocates per layer.
+        zero_allocator = BumpAllocator(
+            buffer_size=2, dtype=torch.float32, device=hidden_states.device
+        )
+        with get_global_expert_distribution_recorder().disable_this_region():
+            hidden_states = self.decoder(positions, hidden_states, forward_batch, zero_allocator)
+        if not forward_batch.forward_mode.is_idle():
+            hidden_states = self.shared_head.norm(hidden_states)
+        return hidden_states
+
+
+class Glm5NextForCausalLMNextN(Glm5NextForConditionalGeneration):
+    """The draft: subclassed for the loader mixin and the packed-modules map only."""
+
+    def __init__(
+        self,
+        config,
+        quant_config: Optional[QuantizationConfig] = None,
+        prefix: str = "",
+    ) -> None:
+        nn.Module.__init__(self)
+        text_config = _text_config(config)
+        self.config = text_config
+        self.mm_config = None
+        self.multimodal_enabled = False
+        self.visual = None
+        self.tp_size = get_tensor_model_parallel_world_size()
+        # The loader mixin asks pp_group which rank owns the final norm.
+        self.pp_group = get_pp_group()
+        self.quant_config = quant_config
+        self.num_fused_shared_experts = 0
+        self.model = Glm5NextModelNextN(
+            text_config, quant_config, prefix=add_prefix("model", prefix)
+        )
+        self.lm_head = ParallelLMHead(
+            text_config.vocab_size,
+            text_config.hidden_size,
+            quant_config=quant_config,
+            prefix=add_prefix("model.shared_head.head", prefix),
+            use_attn_tp_group=get_global_server_args().enable_dp_lm_head,
+        )
+        self.logits_processor = LogitsProcessor(config=text_config)
+
+    @torch.no_grad()
+    def forward(
+        self,
+        input_ids: torch.Tensor,
+        positions: torch.Tensor,
+        forward_batch: ForwardBatch,
+    ) -> torch.Tensor:
+        hidden_states = self.model(input_ids, positions, forward_batch)
+        return self.logits_processor(input_ids, hidden_states, self.lm_head, forward_batch)
+
+    def get_embed_and_head(self):
+        return self.model.embed_tokens.weight, self.lm_head.weight
+
+    def set_embed_and_head(self, embed, head):
+        del self.model.embed_tokens.weight
+        del self.lm_head.weight
+        self.model.embed_tokens.weight = embed
+        self.lm_head.weight = head
+        torch.cuda.empty_cache()
+        torch.cuda.synchronize()
+
+    def load_weights(self, weights: Iterable[Tuple[str, torch.Tensor]]) -> None:
+        # The main model's strict source contract is built from its own
+        # parameter names and would reject a draft whose parameters live under
+        # ``model.decoder``. The mixin's NextN mode knows the renaming
+        # (``model.layers.45.`` -> ``model.decoder.`` / ``model.``), so only the
+        # ``language_model`` prefix is stripped here and the rest is its job.
+        def normalized():
+            for name, tensor in weights:
+                canonical = normalize_glm5_next_weight_name(name)
+                if canonical is None:
+                    continue
+                yield canonical, tensor
+
+        self.do_load_weights(normalized(), is_nextn=True)
+
+    def post_load_weights(self, is_nextn: bool = True, weight_names=None) -> None:
+        super().post_load_weights(is_nextn=True, weight_names=weight_names)
+
+
+EntryClass = [Glm5NextForCausalLMNextN]
