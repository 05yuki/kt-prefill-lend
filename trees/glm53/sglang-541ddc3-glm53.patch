+    for k, v in meta.items():
+        if k == "__metadata__" or _DENSE_PREFETCH_SKIP.search(k):
+            continue
+        b, e = v["data_offsets"]
+        ranges.append((8 + n + b, e - b))
+    if not ranges:
+        return
