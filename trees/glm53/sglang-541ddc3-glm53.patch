+"""The mHC Sinkhorn rounds as one launch, bit-identical to the torch loop.
+
+The kernel lives in patches/glm53_sinkhorn.cu and is built into the venv by
+tools/build-glm53-sinkhorn.sh. It reproduces the ATen loop operation for
+operation — pinned rounding, and ATen's two different summation orders for rows
+and columns — and the build ends by asserting torch.equal against the reference
+at three sizes. This module only carries the shape guard and the import.
+"""
+
+import torch
+
+
+def sinkhorn_rounds_(comb: torch.Tensor, rounds: int, eps: float) -> torch.Tensor:
+    """Apply ``rounds`` of row-then-column normalisation to ``comb`` [T,4,4] in place."""
+    assert comb.dim() == 3 and comb.shape[1] == 4 and comb.shape[2] == 4
+    assert comb.dtype == torch.float32
+    comb = comb.contiguous()
+    if comb.shape[0] == 0 or rounds <= 0:
+        return comb
+    import glm53_sinkhorn_ext
+
+    glm53_sinkhorn_ext.sinkhorn_rounds_(comb, rounds, eps)
+    return comb
