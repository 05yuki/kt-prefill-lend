diff --git a/python/sglang/srt/layers/attention/nsa_topk_torch.py b/python/sglang/srt/layers/attention/nsa_topk_torch.py
new file mode 100644
index 0000000..0c7fc1a
--- /dev/null
+++ b/python/sglang/srt/layers/attention/nsa_topk_torch.py
@@ -0,0 +1,179 @@
+# SPDX-License-Identifier: Apache-2.0
+"""NSA top-k for GPUs the installed sgl-kernel refuses to run on.
+
+sgl-kernel 0.3.21's topk.cu asks cudaFuncSetAttribute for 128 KB of dynamic
+shared memory per block; SM120 grants 101,376, so every call dies at
+`set_up_kernel_once failed: invalid argument` before a block launches.
+0.3.21.post2 cut the request to 32 KB, and the tree carries that source, but
+the wheel is not on PyPI and rebuilding all 97 of its sources for six
+architectures costs hours.
+
+So there are two paths here. `tools/build-glm53-topk.sh` compiles that one file
+for this GPU alone, under the `glm53_topk` namespace so it cannot collide with
+the wheel's registration; when that build is present it is used, and it is
+about eight times faster than torch. When it is absent — a fresh host, a
+different GPU — the torch implementations below run instead, so nothing has to
+be built before the model will start.
+
+The contract both obey, read from topk.cu rather than guessed:
+
+* indices are 0-based inside each row's own region, not into `score` —
+  `topk_transform_decode_kernel` does `dst[i] = src_page_entry[pos]`, and
+  `src_page_entry` is that row's page table.
+* `row_starts[b]` says where that region begins in `score`; it spans
+  `score[b, row_starts[b] : row_starts[b] + lengths[b]]`.
+* when `lengths[b] <= topk` the kernel ranks nothing. `naive_topk_cuda` writes
+  `indice[i] = (i < length) ? i : -1`, because a row no longer than topk selects
+  every live key. Reproducing that rather than always ranking matters: for a row
+  of exactly topk both return the same set, so ranking there would hide a fault
+  in the ranking path behind an answer that looks right.
+* the tail is -1, which the attention kernels already read as masked.
+
+The two paths agree except on ties, where radix select and torch.topk keep
+different members of an equal group. Both are correct; neither order is
+promised by the contract.
+"""
+
+import glob
+import logging
+import os
+from typing import Optional
+
+import torch
+
+logger = logging.getLogger(__name__)
+
+# topk.cu rebuilt from the tree for this GPU alone, under its own namespace so
+# it cannot collide with the wheel's registration. When it is present it is
+# used: same answers as the torch path below, about eight times faster. When it
+# is absent the torch path still runs, which is what makes this file safe to
+# ship before the build exists on a given host.
+_EXT = None
+
+
+def _kernel():
+    """The rebuilt kernel, or None to use the torch path. Resolved once."""
+    global _EXT
+    if _EXT is not None:
+        return _EXT or None
+    _EXT = False
+    # It installs beside torch, in this venv's site-packages.
+    site_packages = os.path.dirname(os.path.dirname(os.path.abspath(torch.__file__)))
+    for so in sorted(glob.glob(os.path.join(site_packages, "glm53_topk_ext*.so"))):
+        try:
+            torch.ops.load_library(so)
+            _EXT = torch.ops.glm53_topk
+            logger.info("NSA top-k: rebuilt kernel from %s", so)
+            break
+        except Exception as e:  # a stale build must not stop the server starting
+            logger.warning("NSA top-k: %s did not load (%s); falling back to torch", so, e)
+    else:
+        logger.info("NSA top-k: no rebuilt kernel found; using torch")
+    return _EXT or None
+
+
+def _row_relative_topk(
+    score: torch.Tensor,
+    lengths: torch.Tensor,
+    topk: int,
+    row_starts: Optional[torch.Tensor],
+) -> torch.Tensor:
+    """(B, topk) int32, row-relative, -1 padded, matching topk.cu."""
+    b, width = score.shape
+    device = score.device
+    lens = lengths.to(torch.long)
+    starts = (
+        torch.zeros(b, dtype=torch.long, device=device)
+        if row_starts is None
+        else row_starts.to(torch.long)
+    )
+
+    col = torch.arange(topk, device=device).unsqueeze(0).expand(b, topk)
+    # Short rows: every live key, in order, tail -1. No ranking at all.
+    out = torch.where(col < lens.unsqueeze(1), col, torch.full_like(col, -1))
+
+    long_rows = lens > topk
+    if long_rows.any():
+        idx = torch.arange(width, device=device).unsqueeze(0)
+        # A column outside this row's region belongs to another request and must
+        # not be allowed to win a slot.
+        inside = (idx >= starts.unsqueeze(1)) & (idx < (starts + lens).unsqueeze(1))
+        masked = score.masked_fill(~inside, float("-inf"))
+        # Every slot is filled here by construction: these rows hold more than
+        # topk live keys, so no -inf column can place.
+        ranked = masked.topk(topk, dim=1).indices - starts.unsqueeze(1)
+        out = torch.where(long_rows.unsqueeze(1), ranked, out)
+
+    return out.to(torch.int32)
+
+
+def fast_topk_v2(
+    score: torch.Tensor,
+    lengths: torch.Tensor,
+    topk: int,
+    row_starts: Optional[torch.Tensor] = None,
+) -> torch.Tensor:
+    assert score.dim() == 2
+    k = _kernel()
+    if k is not None:
+        out = score.new_empty((score.shape[0], topk), dtype=torch.int32)
+        k.fast_topk(score, out, lengths, row_starts)
+        return out
+    return _row_relative_topk(score, lengths, topk, row_starts)
+
+
+def fast_topk_transform_fused(
+    score: torch.Tensor,
+    lengths: torch.Tensor,
+    page_table_size_1: torch.Tensor,
+    cu_seqlens_q: torch.Tensor,
+    topk: int,
+    row_starts: Optional[torch.Tensor] = None,
+) -> torch.Tensor:
+    """Select, then map through the page table, as topk_transform_*_kernel does."""
+    k = _kernel()
+    if k is not None:
+        out = score.new_empty((score.shape[0], topk), dtype=torch.int32)
+        k.fast_topk_transform_fused(
+            score, lengths, out, page_table_size_1, cu_seqlens_q, row_starts
+        )
+        return out
+    idx = _row_relative_topk(score, lengths, topk, row_starts)
+
+    # Which page-table row each score row reads. In decode they line up one to
+    # one; in prefill a request's rows are expanded per query token, so several
+    # of them share one page table and cu_seqlens_q says which. topk.cu picks
+    # between the two kernels on exactly this condition.
+    rows = score.shape[0]
+    prefill_bs = cu_seqlens_q.shape[0] - 1 if cu_seqlens_q is not None else rows
+    if row_starts is None and prefill_bs == rows:
+        src = torch.arange(rows, device=score.device)
+    else:
+        # cu_seqlens_q[r] <= bid < cu_seqlens_q[r+1]
+        bid = torch.arange(rows, device=score.device, dtype=cu_seqlens_q.dtype)
+        src = torch.searchsorted(cu_seqlens_q, bid, right=True) - 1
+        src = src.clamp_(0, prefill_bs - 1).to(torch.long)
+
+    # gather needs a real index in every slot; the -1s are put back after.
+    gathered = page_table_size_1[src].gather(1, idx.clamp_min(0).to(torch.long))
+    return torch.where(idx >= 0, gathered.to(torch.int32), torch.full_like(idx, -1))
+
+
+def fast_topk_transform_ragged_fused(
+    score: torch.Tensor,
+    lengths: torch.Tensor,
+    topk_indices_offset: torch.Tensor,
+    topk: int,
+    row_starts: Optional[torch.Tensor] = None,
+) -> torch.Tensor:
+    """Ragged KV: an offset is added instead of a page-table lookup."""
+    k = _kernel()
+    if k is not None:
+        out = score.new_empty((score.shape[0], topk), dtype=torch.int32)
+        k.fast_topk_transform_ragged_fused(
+            score, lengths, out, topk_indices_offset, row_starts
+        )
+        return out
+    idx = _row_relative_topk(score, lengths, topk, row_starts)
+    offset = topk_indices_offset.to(torch.int32).unsqueeze(1)
+    return torch.where(idx >= 0, idx + offset, torch.full_like(idx, -1))
