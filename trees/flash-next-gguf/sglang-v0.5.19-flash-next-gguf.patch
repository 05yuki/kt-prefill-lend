+# --- KT_STEP_TIMING=1 (patches/sglang-kt-step-timing.py) -------------------
+import os as _kt_os
+
+_KT_STEP_TIMING = _kt_os.environ.get("KT_STEP_TIMING") == "1"
+_kt_step_state = {"ring": [], "n": 0, "last_start": None, "periods": []}
+
+
+def _kt_step_timing_begin(runner, forward_batch):
+    if not _KT_STEP_TIMING or not forward_batch.forward_mode.is_decode():
+        return None
+    e0 = torch.cuda.Event(enable_timing=True)
+    e0.record()
+    st = _kt_step_state
+    now = time.perf_counter()
+    if st["last_start"] is not None:
+        st["periods"].append(now - st["last_start"])
+    st["last_start"] = now
+    return e0
+
+
+def _kt_step_timing_end(runner, e0):
+    if e0 is None:
+        return
+    e1 = torch.cuda.Event(enable_timing=True)
+    e1.record()
+    st = _kt_step_state
+    st["ring"].append((e0, e1))
+    st["n"] += 1
+    if st["n"] % 40 == 0:
+        # read the events that are certainly complete (all but the last few)
+        done = [(a, b) for a, b in st["ring"][:-4] if b.query()]
+        if done:
+            fwd = sum(a.elapsed_time(b) for a, b in done) / len(done)
+            per = sum(st["periods"]) / max(1, len(st["periods"])) * 1000
+            print(
+                f"[kt-step rank{getattr(runner, 'tp_rank', torch.cuda.current_device())}] {len(done)} decode steps: forward {fwd:.2f} ms "
+                f"(GPU, incl. CPU-expert waits), period {per:.2f} ms, outside {per - fwd:.2f} ms",
+                flush=True,
+            )
+        st["ring"] = st["ring"][-4:]
+        st["periods"] = []
+
+
+def _vram_dump(model, tag, gpu_id):
+    """Debug: CUDA tensors reachable from the model, grouped by module path (SGL_VRAM_DUMP=1)."""
+    import re as _re
+
+    import torch as _torch
+
+    seen, groups = set(), {}
+
+    def add(path, t):
+        if not isinstance(t, _torch.Tensor) or not t.is_cuda:
+            return
+        key = (t.data_ptr(), t.numel(), t.dtype)
+        if key in seen:
+            return
+        seen.add(key)
+        g = _re.sub(r"\.\d+\.", ".N.", path)
+        n, b, d = groups.get(g, (0, 0, set()))
+        d.add(str(t.dtype).replace("torch.", ""))
+        groups[g] = (n + 1, b + t.numel() * t.element_size(), d)
+
+    for mname, m in model.named_modules():
+        for k, v in list(m._parameters.items()) + list(m._buffers.items()):
+            add(f"{mname}.{k}", v)
+        for k, v in vars(m).items():
+            if k.startswith("_"):
+                continue
+            if isinstance(v, _torch.Tensor):
+                add(f"{mname}.{k}", v)
+            elif isinstance(v, (list, tuple)):
+                for x in v:
+                    add(f"{mname}.{k}[]", x)
+            elif isinstance(v, dict):
+                for x in v.values():
+                    add(f"{mname}.{k}{{}}", x)
+    free, total = _torch.cuda.mem_get_info(gpu_id)
+    lines = [
+        f"tag={tag} allocated={_torch.cuda.memory_allocated(gpu_id) / 2**20:.1f} MiB "
+        f"reserved={_torch.cuda.memory_reserved(gpu_id) / 2**20:.1f} MiB free={free / 2**20:.1f} MiB "
+        f"total={total / 2**20:.1f} MiB reachable={sum(b for _, b, _ in groups.values()) / 2**20:.1f} MiB"
+    ]
+    for g, (n, b, d) in sorted(groups.items(), key=lambda x: -x[1][1]):
+        lines.append(f"{b / 2**20:10.1f} MiB  x{n:<5d} {g}  {sorted(d)}")
+    with open(f"/tmp/vram-dump-{tag}-{__import__("os").getpid()}.txt", "w") as f:
+        f.write("\n".join(lines) + "\n")
