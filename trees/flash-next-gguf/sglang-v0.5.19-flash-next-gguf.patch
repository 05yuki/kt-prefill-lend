+"""Lossless zero padding of routed MTP FP8 blocks before TP partitioning.
+
+No target, shared-expert, quantized nonzero value or existing scale is changed.
+"""
+import re
+
+_EXPERT = re.compile(r'^mtp\.layers\.0\.mlp\.experts\.\d+\.(gate|up|down)_proj\.(weight|weight_scale_inv)$')
+
+
+def padded_width(width, tp, block=128):
+    assert width > 0 and tp > 0 and width % block == 0
+    return ((width + tp * block - 1) // (tp * block)) * tp * block
+
+
+def pad_mtp_weight(name, tensor, width, padded, block=128):
+    match = _EXPERT.match(name)
+    if match is None or padded == width:
+        return tensor
+    assert tensor.ndim == 2 and padded >= width
+    axis = 1 if match[1] == 'down' else 0
+    is_scale = match[2] == 'weight_scale_inv'
+    before, after = (width // block, padded // block) if is_scale else (width, padded)
+    assert tensor.shape[axis] == before, (name, tensor.shape, before)
+    shape = list(tensor.shape)
+    shape[axis] = after
+    result = tensor.new_ones(shape) if is_scale else tensor.new_zeros(shape)
+    slices = [slice(None), slice(None)]
+    slices[axis] = slice(0, before)
+    result[tuple(slices)].copy_(tensor)
+    return result
