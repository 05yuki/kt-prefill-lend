diff --git a/python/sglang/srt/layers/moe/kt_gguf_prefetch.py b/python/sglang/srt/layers/moe/kt_gguf_prefetch.py
new file mode 100644
index 0000000..c2229c7
--- /dev/null
+++ b/python/sglang/srt/layers/moe/kt_gguf_prefetch.py
@@ -0,0 +1,86 @@
+"""KT_GGUF_PREFETCH=<threads>: read the GGUF's routed-expert tensors into the
+page cache in layer order, in the background, from the start of the model
+build (rank 0, which owns the CPU experts).
+
+Without it the first reader of each expert tensor is a page fault: the CPU
+experts' load (kt-kernel's worker threads) and the streamer's bank build
+pulled the file in at 1.3-1.9 GB/s (10-11, TP2 cold), the drive does ~6 GB/s
+with parallel 16 MiB preads (memory dsv41-launch-prefetch). The readers copy
+the same bytes either way; this only changes when the file is read.
+
+The page cache lands on the prefetching process's NUMA node (rank 0: node 0);
+the launcher drops the model directory's page cache before each launch, so it is this
+model's file only.
+"""
+import os
+import threading
+import time
+from concurrent.futures import ThreadPoolExecutor
+
+CHUNK = 16 << 20
+_started = False
+
+
+def _log(msg):
+    print(f"[kt-gguf-prefetch {time.strftime('%H:%M:%S')}] {msg}", flush=True)
+
+
+def _ranges(loader):
+    """(file, offset, nbytes) of every blk.N.ffn_{gate,up,down}_exps, by layer
+    (the byte counts of GGUFLoader.get_tensor_view, patches/kt-kernel-gguf-nocopy.py)."""
+    out = []
+    i = 0
+    while f"blk.{i}.ffn_gate_exps.weight" in loader.tensor_info:
+        for p in ("gate", "up", "down"):
+            name = f"blk.{i}.ffn_{p}_exps.weight"
+            data, _ = loader.get_tensor_view(name)
+            out.append((loader.tensor_file_map[name], int(loader.tensor_info[name]["offset"]), int(data.numel())))
+        i += 1
+    return out
+
+
+def start_experts(loader, threads=None):
+    global _started
+    if _started or loader is None or not hasattr(loader, "get_tensor_view"):
+        return
+    threads = threads or int(os.environ.get("KT_GGUF_PREFETCH", "0") or 0)
+    if threads <= 0:
+        return
+    _started = True
+    ranges = _ranges(loader)
+    total = sum(n for _, _, n in ranges)
+
+    def run():
+        t0 = time.time()
+        fds = {}
+        bufs = threading.local()
+
+        def read(job):
+            path, off, n = job
+            b = getattr(bufs, "b", None)
+            if b is None:
+                b = bufs.b = bytearray(CHUNK)
+            mv = memoryview(b)
+            fd = fds[path]
+            end = off + n
+            while off < end:
+                k = os.preadv(fd, [mv[:min(CHUNK, end - off)]], off)
+                if k <= 0:
+                    break
+                off += k
+
+        for path, _, _ in ranges:
+            if path not in fds:
+                fds[path] = os.open(path, os.O_RDONLY)
+        # split each tensor into CHUNK jobs so the threads share a tensor
+        jobs = [(p, o + k, min(CHUNK, n - k)) for p, o, n in ranges for k in range(0, n, CHUNK)]
+        with ThreadPoolExecutor(max_workers=threads, thread_name_prefix="kt-gguf-prefetch") as ex:
+            list(ex.map(read, jobs))
+        for fd in fds.values():
+            os.close(fd)
+        dt = time.time() - t0
+        _log(f"{len(ranges)} expert tensors, {total / 1e9:.1f} GB read into the page cache in {dt:.1f} s "
+             f"({total / 1e9 / max(dt, 1e-9):.2f} GB/s, {threads} threads)")
+
+    threading.Thread(target=run, daemon=True, name="kt-gguf-prefetch").start()
+    _log(f"started: {len(ranges)} expert tensors, {total / 1e9:.1f} GB, {threads} threads")
