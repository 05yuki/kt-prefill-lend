+        rows = torch.arange(8, dtype=torch.int32, device=device)[:, None]
+        cols = torch.arange(4096, dtype=torch.int32, device=device)[None, :]
+        backend.req_to_token = (
+            (rows * 64 + cols // full_page) * full_page + cols % full_page
+        ).contiguous()
