+def _kt_drop_discarded_workspaces(box) -> None:
+    """patches/sglang-kt-decode-vram.py: unregister the runtime_context buffers held only by a full-attention
+    backend that QSA replaced (trtllm_mha / flashinfer workspaces, ~896 MiB), so they free with it.
+    box = [the replaced backend]; emptied here so the caller holds no reference."""
+    import gc
+    import os
+
+    import torch
+
+    backend = box.pop()
+    if os.environ.get("KT_QSA_DROP_UNUSED_WORKSPACE", "1") != "1":
+        return
+    from sglang.srt.runtime_context import get_context
+
+    held, seen = set(), set()
+
+    def walk(o, depth):
+        if depth > 6 or id(o) in seen:
+            return
+        seen.add(id(o))
+        if isinstance(o, torch.Tensor):
+            held.add(id(o))
+        elif isinstance(o, (list, tuple, set)):
+            for v in o:
+                walk(v, depth + 1)
+        elif isinstance(o, dict):
+            for v in o.values():
+                walk(v, depth + 1)
+        elif hasattr(o, "__dict__") and not isinstance(o, type) and type(o).__name__ not in ("ModelRunner", "Module"):
+            for v in vars(o).values():
+                walk(v, depth + 1)
+
+    walk(backend, 0)
+    bufs = get_context().resources.buffers
+    dropped = []
+    for name in ("trtllm_mha_zero_workspace", "flashinfer_workspace"):
+        b = bufs.get(name)
+        if isinstance(b, torch.Tensor) and id(b) in held:
+            dropped.append(f"{name} {b.numel() * b.element_size() >> 20} MiB")
+            del bufs[name]
+    b = None
+    if dropped:
+        del backend
+        gc.collect()
+        torch.cuda.empty_cache()
+        logger.info(f"QSA replaced the full-attention backend; unregistered its unused workspaces: {', '.join(dropped)}")
+
