+        r2t = backend.req_to_token.cpu()
+        for row, (length, req) in enumerate(zip(exp_lens, exp_reqs)):
+            assert int(indexer.graph_compressed_lengths[row]) == length // ratio
+            if length > 0 and length % ratio == 0:
