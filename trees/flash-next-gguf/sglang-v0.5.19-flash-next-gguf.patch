+                num_rows, dtype=torch.int32, device=device
+            ),
+            is_cuda_graph=True,
+        )
+        launch_graph_metadata(
+            mode=mode,
+            bs=bs,
+            num_rows=num_rows,
+            seq_lens=torch.tensor(seq_lens, dtype=torch.int32, device=device),
