+from unittest.mock import Mock, patch
+
+import torch
+
+from sglang.srt.layers.moe.fused_moe_triton.layer import FusedMoE
+from sglang.srt.layers.moe.kt_ep_wrapper import KTEPWrapperMethod
+
+
+def _make_kt_layer(num_gpu_experts: int) -> FusedMoE:
+    layer = object.__new__(FusedMoE)
+    torch.nn.Module.__init__(layer)
+
+    quant_method = object.__new__(KTEPWrapperMethod)
+    quant_method.num_gpu_experts = num_gpu_experts
+    layer.quant_method = quant_method
+    layer._expert_storage_rank = 0
+    layer._num_local_routed = 64
+    layer._num_global_routed = 64
+    layer._has_fused_shared = False
+    layer._weight_loader_impl = Mock()
+    return layer
+
+
+def test_weight_loader_skips_kt_cpu_experts_without_global_metadata():
+    layer = _make_kt_layer(num_gpu_experts=8)
+    param = torch.nn.Parameter(torch.empty(8, 2, 2), requires_grad=False)
+
+    with patch(
+        "sglang.srt.layers.moe.fused_moe_triton.layer."
+        "get_global_expert_location_metadata",
+        return_value=None,
+    ):
+        layer.weight_loader(
+            param,
+            torch.ones(2, 2),
+            "experts.w13_weight",
+            shard_id="w1",
+            expert_id=8,
+        )
+
+    layer._weight_loader_impl.assert_not_called()
+
+
+def test_weight_loader_keeps_kt_gpu_expert_prefix_loading():
+    layer = _make_kt_layer(num_gpu_experts=8)
+    param = torch.nn.Parameter(torch.empty(8, 2, 2), requires_grad=False)
+    loaded_weight = torch.ones(2, 2)
+
+    with patch(
+        "sglang.srt.layers.moe.fused_moe_triton.layer."
+        "get_global_expert_location_metadata",
+        return_value=None,
+    ):
+        layer.weight_loader(
+            param,
+            loaded_weight,
+            "experts.w13_weight",
+            shard_id="w1",
+            expert_id=7,
+        )
+
+    layer._weight_loader_impl.assert_called_once_with(
+        param=param,
+        loaded_weight=loaded_weight,
+        weight_name="experts.w13_weight",
+        shard_id="w1",
+        expert_id=7,
+    )
