+  const int block_num_y = (nrows + GGML_CUDA_MMV_Y * KT_RPW - 1) / (GGML_CUDA_MMV_Y * KT_RPW);
+  const dim3 block_nums(block_num_y, 1, tokens * top_k);
+  const dim3 block_dims(WARP_SIZE, GGML_CUDA_MMV_Y, 1);
