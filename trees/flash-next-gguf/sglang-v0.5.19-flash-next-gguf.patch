--- /dev/null
+++ b/python/sglang/srt/layers/moe/kt_hot_kv_lend.py
@@ -0,0 +1,527 @@
+"""Hot experts in the KV pool's free pages (KT_HOT_KV_LEND=1, with the dynamic
+hot cache KT_HOT_DYNAMIC=1 and the GGUF hot method).
+
+The KV always wins:
+- only pages in the allocator's free list are lent, never pages the radix tree
+  holds, and the pool's size never changes: the lent pages count as available
+  (available_size), so admission, eviction, retraction and the idle leak check
+  see the pool as if nothing were lent;
+- the lent region is the top of the page range, whole groups of P pages, page
+  ids above a boundary B. Lending moves B down over groups whose every page is
+  free (and keeps KT_HOT_KV_LEND_RESERVE tokens free below it); any alloc /
+  alloc_extend / alloc_decode that needs more pages than the free list holds
+  takes lent groups back first (B moves up): a device-wide sync (every forward
+  that may read those slots has finished), the slots' experts back to the CPU
+  in the tables, the group's pages zeroed in every K/V tensor (expert bytes
+  read as bf16 KV could be Inf/NaN, and page-wise attention kernels load before
+  they mask), then the pages join the free list, all before the kernel that
+  computes the new locations is launched;
+- a streamed prefill (the lend's switch to prefill) gives every lent group
+  back; clear() (flush_cache) too.
+Lending happens outside any graph, at the start of a non-streamed extend of the
+target model and at the first decode / verify forward after an extend, a
+streamed prefill or a clear: one device sync each, never per decode step.
+
+A group's pages are, in each K and V tensor of every pool on this allocator (the
+target's full-attention layers and the MTP draft's layer), one contiguous byte
+range; it holds floor(P * page_bytes / slot_bytes) expert slots (w13 then w2,
+256-byte aligned; slot_bytes from the largest layer). New slots go to the layers
+with the fewest lent slots, as ids N.. (N = KT_GPU_EXPERTS), and are filled at
+once with the hottest non-residents of the layer (decayed route counts; the seed
+map's order breaks ties). The hot method reads every slot through per-layer
+int64 pointer tables (layer.kt_kv_ptr13 / kt_kv_ptr2, fixed addresses, so the
+captured graphs stay valid); a kernel that cannot read them gets ids from the
+cache's base tables, where lent residents are CPU experts. Residency is carried
+by the ids alone (the CPU MoE has no prefix mask under the dynamic cache).
+
+KT_HOT_KV_LEND_CHECK=1: after every lend / take-back the tables are checked
+(every expert exactly once, device == host), and before a group is zeroed each
+of its slots is compared with the bank it was filled from (no KV write ever
+reached a lent page). Also, a streamed prefill takes everything back already
+in its alloc_extend and puts those pages first in the free list, so its KV
+lands in pages that held experts (a one-chunk streamed prefill repeats bit for
+bit across launches: the paired NLL's streamed set then tests that no stale
+expert byte is read as KV).
+"""
+import os
+import time
+from typing import Dict, List, Optional
+
+import torch
+
+from sglang.srt.layers.moe import kt_hot_cache
+
+ENABLED = kt_hot_cache.KV_LEND
+RESERVE = int(os.environ.get("KT_HOT_KV_LEND_RESERVE", "2048"))  # tokens kept free below the lent region
+CHECK = os.environ.get("KT_HOT_KV_LEND_CHECK", "0") == "1"
+RELEASE_AT_PREFILL = os.environ.get("KT_HOT_KV_LEND_RELEASE_AT_PREFILL", "1") == "1"
+# 0: lend and take back pages but leave the slots empty (with the policy frozen
+# the routing is then exactly the feature-off one: a test of the page handling)
+FILL = os.environ.get("KT_HOT_KV_LEND_FILL", "1") == "1"
+# a slot goes to a layer only while its lent count is within SLACK of the
+# smallest: without it the space a large slot leaves at a range's end goes to
+# the layers with the smallest slots every time (TP1: 11-53 per layer)
+SLACK = int(os.environ.get("KT_HOT_KV_LEND_SLACK", "2"))
+ALIGN = 256
+
+_runners: List = []  # (is_draft, pool, allocator)
+_lender: Optional["Lender"] = None
+_tables_ready = False
+STATS = {"lends": 0, "take_backs": 0, "released_at_prefill": 0, "groups_lent": 0, "groups_taken": 0}
+
+
+def _log(msg):
+    print(f"[kt-kv-lend {time.strftime('%H:%M:%S')}] {msg}", flush=True)
+
+
+def _align(n: int) -> int:
+    return (n + ALIGN - 1) // ALIGN * ALIGN
+
+
+def _kv_tensors(pool):
+    kvp = getattr(pool, "full_kv_pool", None) or pool
+    out = []
+    for name in ("k_buffer", "v_buffer"):
+        bufs = getattr(kvp, name, None)
+        if isinstance(bufs, (list, tuple)):
+            out += list(bufs)
+    return kvp, out
+
+
+# -- pointer tables ------------------------------------------------------------------
+
+def _make_tables(cache) -> None:
+    """layer.kt_kv_ptr13 / kt_kv_ptr2: one weight address per slot id (resident
+    slots at base + slot * stride, lent ones set when lent). Built before the
+    graphs are captured; resident entries are rewritten whenever checked."""
+    global _tables_ready
+    for li, (method, layer) in cache.layers.items():
+        w13, w2 = layer.w13_qweight, layer.w2_qweight
+        if getattr(layer, "kt_kv_ptr13", None) is None:
+            layer.kt_kv_ptr13_host = torch.zeros(cache.S, dtype=torch.int64)
+            layer.kt_kv_ptr2_host = torch.zeros(cache.S, dtype=torch.int64)
+            layer.kt_kv_ptr13 = torch.zeros(cache.S, dtype=torch.int64, device=w13.device)
+            layer.kt_kv_ptr2 = torch.zeros(cache.S, dtype=torch.int64, device=w13.device)
+        h13, h2 = layer.kt_kv_ptr13_host, layer.kt_kv_ptr2_host
+        s13, s2 = w13[0].numel() * w13.element_size(), w2[0].numel() * w2.element_size()
+        n = w13.shape[0]
+        h13[:n] = w13.data_ptr() + torch.arange(n, dtype=torch.int64) * s13
+        h2[:n] = w2.data_ptr() + torch.arange(n, dtype=torch.int64) * s2
+        layer.kt_kv_base = (w13.data_ptr(), w2.data_ptr())
+        layer.kt_kv_ptr13.copy_(h13, non_blocking=True)
+        layer.kt_kv_ptr2.copy_(h2, non_blocking=True)
+    _tables_ready = True
+
+
+def _check_bases(cache) -> None:
+    for li, (method, layer) in cache.layers.items():
+        if layer.kt_kv_base != (layer.w13_qweight.data_ptr(), layer.w2_qweight.data_ptr()):
+            raise RuntimeError(f"KT_HOT_KV_LEND: layer {li}'s hot slot tensors moved after the pointer tables were built")
+
+
+# -- the lender ----------------------------------------------------------------------
+
+class Lender:
+    def __init__(self, alloc, pools, cache):
+        self.alloc, self.cache = alloc, cache
+        self.ps = alloc.page_size
+        self.n = alloc.num_pages
+        self.tensors = []  # (flat uint8 view, page bytes)
+        rows = self.n * self.ps + self.ps
+        for pool in pools:
+            kvp, ts = _kv_tensors(pool)
+            for t in ts:
+                if not (t.is_cuda and t.is_contiguous() and t.nbytes % (self.n + 1) == 0
+                        and t.shape[0] in (rows, self.n + 1)):
+                    _log(f"skipping a KV tensor {tuple(t.shape)} {t.dtype}: not {self.n + 1} contiguous pages")
+                    continue
+                self.tensors.append((t.view(-1).view(torch.uint8), t.nbytes // (self.n + 1)))
+        if not self.tensors:
+            raise RuntimeError("KT_HOT_KV_LEND: no KV tensors to lend")
+        # slot layout: w13 then w2, each layer its own size (the types differ:
+        # 1.5-2.7 MB at TP1); a group's byte range in each tensor is packed
+        # with the slots of the layers that have the fewest lent slots. The
+        # group size P is the one that gives the most slots when every group
+        # is lent (simulated with the same packing)
+        self.lsb = {li: _align(layer.w13_qweight[0].numel()) + _align(layer.w2_qweight[0].numel())
+                    for li, (method, layer) in cache.layers.items()}
+        self.sb = max(self.lsb.values())
+        pbmax = max(pb for _, pb in self.tensors)
+        pmin = -(-self.sb // pbmax)
+        best = None
+        for P in range(pmin, 4 * pmin + 1):
+            self.P = P
+            cnt = {li: 0 for li in cache.layers}
+            first = len(self._pack(1, cnt))
+            total = first + sum(len(self._pack(1, cnt)) for _ in range(self.n // P - 1))
+            if best is None or total > best[1]:
+                best = (P, total, first)
+        self.P, total_slots, self.per_group = best
+        self.gmax = self.n // self.P
+        self.lent = 0  # groups lent, from the top
+        self.group_slots: List[List[tuple]] = []  # per lent group (top first): (layer, slot)
+        self.reserve_pages = -(-RESERVE // self.ps)
+        self.seed_rank = self._seed_rank()
+        _log(f"{len(pools)} pools on the allocator, {len(self.tensors)} K/V tensors, page {self.ps} tokens "
+             f"({min(pb for _, pb in self.tensors)}-{pbmax} B a page per tensor), {self.n} pages; slot "
+             f"{min(self.lsb.values())}-{self.sb} B, "
+             f"group {self.P} pages = {self.per_group} slots (the first), at most {self.gmax} groups "
+             f"({total_slots} slots, {total_slots / max(1, len(cache.layers)):.1f} per layer); "
+             f"reserve {self.reserve_pages} pages, at most {kt_hot_cache.KV_LEND_MAX} lent slots per layer")
+
+    def _seed_rank(self) -> Optional[torch.Tensor]:
+        """Rank of each expert in the seed map per layer (0 = first), for ties."""
+        path = kt_hot_cache.SEED
+        if not path:
+            return None
+        import json
+
+        p2l = json.load(open(path))["physical_to_logical_map"]
+        c = self.cache
+        r = torch.full((c.L, c.E), c.E, dtype=torch.int64)
+        for li in range(min(c.L, len(p2l))):
+            seen = {}
+            for i, e in enumerate(p2l[li]):
+                seen.setdefault(int(e), i)
+            for e, i in seen.items():
+                r[li, e] = i
+        return r
+
+    @property
+    def boundary(self) -> int:
+        return self.n - self.lent * self.P  # pages above it are lent
+
+    def lent_pages(self) -> int:
+        return self.lent * self.P
+
+    def _group_pages(self, j: int):
+        hi = self.n - j * self.P
+        return hi - self.P + 1, hi  # inclusive
+
+    def _pack(self, lo: int, cnt: Dict[int, int]):
+        """Slots for the group starting at page lo: [(tensor, byte offset,
+        layer)], each next slot for the layer with the fewest lent slots that
+        still fits in the tensor's range (cnt is updated)."""
+        out = []
+        cap = kt_hot_cache.KV_LEND_MAX
+        for ti, (flat, pb) in enumerate(self.tensors):
+            off, end = lo * pb, (lo + self.P) * pb
+            while True:
+                pick = None
+                low = min(cnt.values())
+                for li in sorted(cnt, key=lambda l: (cnt[l], l)):
+                    if cnt[li] > low + SLACK:
+                        break
+                    if cnt[li] < cap and off + self.lsb[li] <= end:
+                        pick = li
+                        break
+                if pick is None:
+                    break
+                out.append((ti, off, pick))
+                off += self.lsb[pick]
+                cnt[pick] += 1
+        return out
+
+    def _free_count(self) -> int:
+        a = self.alloc
+        return len(a.free_pages) + (len(a.release_pages) if a.release_pages is not None else 0)
+
+    # lend ---------------------------------------------------------------------------
+
+    def try_lend(self, why: str) -> None:
+        c = self.cache
+        if self.lent >= self.gmax:
+            return
+        if all(sum(1 for e in c.slot2log[li][c.N:] if e != kt_hot_cache.ABSENT) >= kt_hot_cache.KV_LEND_MAX
+               for li in c.layers):
+            return
+        t0 = time.perf_counter()
+        a = self.alloc
+        dev = a.free_pages.device
+        torch.cuda.synchronize(dev)
+        B = self.boundary
+        m = B // self.P - 1  # whole groups below B, page 0 never lent
+        free_n = self._free_count()
+        room = (free_n - self.reserve_pages) // self.P
+        k = 0
+        if m > 0 and room > 0:
+            mark = torch.zeros(self.n + 2, dtype=torch.bool, device=dev)
+            mark[a.free_pages] = True
+            if a.release_pages is not None and len(a.release_pages):
+                mark[a.release_pages] = True
+            x = mark[B - m * self.P + 1:B + 1].view(m, self.P).all(1).flip(0)  # x[0]: the group just below B
+            full = x.cpu().tolist()
+            while k < min(m, room) and full[k]:
+                k += 1
+        if k == 0:
+            self._summary(why, 0, 0, time.perf_counter() - t0, quiet=True)
+            return
+        newB = B - k * self.P
+        before = len(a.free_pages)
+        a.free_pages = a.free_pages[a.free_pages <= newB]
+        removed = before - len(a.free_pages)
+        if a.release_pages is not None and len(a.release_pages):
+            rb = len(a.release_pages)
+            a.release_pages = a.release_pages[a.release_pages <= newB]
+            removed += rb - len(a.release_pages)
+        if removed != k * self.P:
+            raise RuntimeError(f"KT_HOT_KV_LEND: {removed} free pages above {newB}, expected {k * self.P}")
+        _check_bases(c)
+        changed = set()
+        new_slots = 0
+        cnt = {li: sum(1 for e in c.slot2log[li][c.N:] if e != kt_hot_cache.ABSENT) for li in c.layers}
+        for j in range(self.lent, self.lent + k):
+            slots = []
+            for ti, off, li in self._pack(self._group_pages(j)[0], cnt):
+                slot = c.slot2log[li].index(kt_hot_cache.ABSENT, c.N)
+                method, layer = c.layers[li]
+                flat = self.tensors[ti][0]
+                w13, w2 = layer.w13_qweight, layer.w2_qweight
+                b13, b2 = w13[0].numel(), w2[0].numel()
+                o2 = off + _align(b13)
+                v13 = flat[off:off + b13].view(w13.shape[1:])
+                v2 = flat[o2:o2 + b2].view(w2.shape[1:])
+                c.lend_slot(li, slot, v13, v2)
+                layer.kt_kv_ptr13_host[slot] = v13.data_ptr()
+                layer.kt_kv_ptr2_host[slot] = v2.data_ptr()
+                changed.add(li)
+                slots.append((li, slot))
+            self.group_slots.append(slots)
+            new_slots += len(slots)
+        self.lent += k
+        for li in changed:
+            layer = c.layers[li][1]
+            layer.kt_kv_ptr13.copy_(layer.kt_kv_ptr13_host, non_blocking=True)
+            layer.kt_kv_ptr2.copy_(layer.kt_kv_ptr2_host, non_blocking=True)
+        filled = c.fill_empty(c.counts.float().cpu(), self.seed_rank) if FILL else 0
+        c.push_tables()
+        STATS["lends"] += 1
+        STATS["groups_lent"] += k
+        if CHECK:
+            torch.cuda.synchronize(dev)
+            err = c.check_tables()
+            if err:
+                raise RuntimeError(f"KT_HOT_KV_LEND check after lend: {err}")
+        self._summary(why, k, filled, time.perf_counter() - t0)
+
+    # take back ----------------------------------------------------------------------
+
+    def take_back(self, groups: int, why: str, first: bool = False) -> None:
+        groups = min(groups, self.lent)
+        if groups <= 0:
+            return
+        t0 = time.perf_counter()
+        c = self.cache
+        a = self.alloc
+        dev = a.free_pages.device
+        # every forward that may read these slots has finished
+        torch.cuda.synchronize(dev)
+        if CHECK:
+            self._check_slots(range(self.lent - groups, self.lent))
+        oldB = self.boundary
+        n_slots = 0
+        for j in range(self.lent - 1, self.lent - 1 - groups, -1):
+            for li, slot in self.group_slots[j]:
+                c.take_back_slot(li, slot)
+                n_slots += 1
+        del self.group_slots[self.lent - groups:]
+        self.lent -= groups
+        newB = self.boundary
+        c.push_tables()
+        for flat, pb in self.tensors:
+            flat[(oldB + 1) * pb:(newB + 1) * pb].zero_()
+        torch.cuda.current_stream(dev).synchronize()
+        back = torch.arange(oldB + 1, newB + 1, dtype=a.free_pages.dtype, device=dev)
+        a.free_pages = torch.cat((back, a.free_pages) if first else (a.free_pages, back))
+        STATS["take_backs"] += 1
+        STATS["groups_taken"] += groups
+        if CHECK:
+            err = c.check_tables()
+            if err:
+                raise RuntimeError(f"KT_HOT_KV_LEND check after take-back: {err}")
+        _log(f"take back {groups} groups ({n_slots} slots, pages {oldB + 1}-{newB}) for {why} in "
+             f"{(time.perf_counter() - t0) * 1e3:.1f} ms; {self.lent} groups lent; take-backs {STATS['take_backs']}, "
+             f"groups taken {STATS['groups_taken']} / lent {STATS['groups_lent']}")
+        global _want_lend
+        _want_lend = True
+
+    def _check_slots(self, js) -> None:
+        """Each lent slot still holds the bytes of the expert it was filled with."""
+        c = self.cache
+        bad = 0
+        n = 0
+        for j in js:
+            for li, slot in self.group_slots[j]:
+                e = c.slot2log[li][slot]
+                if e < 0:
+                    continue
+                method, layer = c.layers[li]
+                gate, up, down = c._bank(li)
+                N = method.N
+                v13, v2 = c.lent_views[(li, slot)]
+                d = c._down_source(li, method, down)[e]
+                ok = (torch.equal(v13[:N].cpu(), gate[e].view(N, -1)) and torch.equal(v13[N:].cpu(), up[e].view(N, -1))
+                      and torch.equal(v2.cpu().view(-1), d.reshape(-1)))
+                bad += not ok
+                n += 1
+        if bad:
+            raise RuntimeError(f"KT_HOT_KV_LEND: {bad} of {n} lent slots changed while lent (a KV write reached a lent page)")
+        _log(f"check: {n} lent slots intact before take-back")
+
+    def _summary(self, why, k, filled, dt, quiet=False):
+        c = self.cache
+        per = [sum(1 for e in c.slot2log[li][c.N:] if e != kt_hot_cache.ABSENT) for li in sorted(c.layers)]
+        line = (f"lend at {why}: +{k} groups -> {self.lent} lent ({self.lent * self.P} pages, "
+                f"{sum(per)} slots, per layer {min(per)}-{max(per)}, {filled} filled) in {dt * 1e3:.1f} ms; "
+                f"free {self._free_count()} of {self.n} pages")
+        if quiet:
+            STATS["quiet"] = STATS.get("quiet", 0) + 1
+            if STATS["quiet"] in (1, 10, 100) or STATS["quiet"] % 1000 == 0:
+                _log(line + f" (no group free, {STATS['quiet']} such)")
+            return
+        _log(line)
+
+
+# -- allocator wrappers --------------------------------------------------------------
+
+def _wrap_allocator(a) -> None:
+    from sglang.srt.utils import get_num_new_pages
+
+    if getattr(a, "_kt_kv_lend", False):
+        return
+    a._kt_kv_lend = True
+    orig = {k: getattr(a, k) for k in ("alloc", "alloc_extend", "alloc_decode", "available_size", "clear")}
+
+    def ensure(pages: int, why: str) -> None:
+        L = _lender
+        if L is None or L.lent == 0:
+            return
+        free = L._free_count()
+        if pages > free:
+            L.take_back(-(-(pages - free) // L.P), why)
+
+    def alloc(need_size: int):
+        L = _lender
+        if L is not None and L.lent:
+            ensure(need_size // a.page_size, "alloc")
+        return orig["alloc"](need_size)
+
+    def alloc_extend(prefix_lens, prefix_lens_cpu, seq_lens, seq_lens_cpu, last_loc, extend_num_tokens,
+                     num_new_pages=None):
+        L = _lender
+        if L is not None and L.lent and CHECK and extend_num_tokens >= _threshold():
+            L.take_back(L.lent, "streamed prefill (check: at its alloc, pages first)", first=True)
+        if L is not None and L.lent:
+            bound = extend_num_tokens // a.page_size + len(prefix_lens) + 1
+            if bound > L._free_count():
+                need = num_new_pages if num_new_pages is not None else get_num_new_pages(
+                    seq_lens=seq_lens_cpu, page_size=a.page_size, prefix_lens=prefix_lens_cpu)
+                ensure(int(need), "alloc_extend")
+        return orig["alloc_extend"](prefix_lens, prefix_lens_cpu, seq_lens, seq_lens_cpu, last_loc,
+                                    extend_num_tokens, num_new_pages)
+
+    def alloc_decode(seq_lens, seq_lens_cpu, last_loc):
+        L = _lender
+        if L is not None and L.lent and len(seq_lens) > L._free_count():
+            need = get_num_new_pages(seq_lens=seq_lens_cpu, page_size=a.page_size, decode=True)
+            ensure(int(need), "alloc_decode")
+        return orig["alloc_decode"](seq_lens, seq_lens_cpu, last_loc)
+
+    def available_size():
+        L = _lender
+        return orig["available_size"]() + (L.lent_pages() * a.page_size if L is not None else 0)
+
+    def clear():
+        L = _lender
+        if L is not None and L.lent:
+            L.take_back(L.lent, "clear")
+        r = orig["clear"]()
+        global _want_lend
+        _want_lend = True
+        return r
+
+    a.alloc, a.alloc_extend, a.alloc_decode, a.available_size, a.clear = (
+        alloc, alloc_extend, alloc_decode, available_size, clear)
+
+
+# -- hooks ---------------------------------------------------------------------------
+
+def register_runner(runner) -> None:
+    """ModelRunner._init_post_memory_pool_components: every runner's pool and
+    allocator (the MTP draft shares the target's allocator)."""
+    if not ENABLED:
+        return
+    if not kt_hot_cache.ENABLED:
+        raise RuntimeError("KT_HOT_KV_LEND=1 needs the dynamic hot cache (KT_HOT_DYNAMIC=1)")
+    if os.environ.get("KT_HOT_CPU_PREFIX_MASK", "0") == "1":
+        # the CPU MoE would skip logical ids below N whatever the tables say
+        raise RuntimeError("KT_HOT_KV_LEND=1 with KT_HOT_CPU_PREFIX_MASK=1: residency must be carried by the ids alone")
+    from sglang.srt.mem_cache.allocator.paged import PagedTokenToKVPoolAllocator
+
+    a = runner.token_to_kv_pool_allocator
+    pool = runner.token_to_kv_pool
+    _runners.append((bool(getattr(runner, "is_draft_worker", False)), pool, a))
+    kvp, ts = _kv_tensors(pool)
+    _log(f"{'draft' if _runners[-1][0] else 'target'} pool {type(pool).__name__} on {type(a).__name__} "
+         f"(id {id(a) & 0xffff:04x}), {len(ts)} K/V tensors")
+    if type(a) is not PagedTokenToKVPoolAllocator:
+        _log(f"allocator {type(a).__name__} is not PagedTokenToKVPoolAllocator: nothing lent")
+        return
+    _wrap_allocator(a)
+    cache = kt_hot_cache._cache
+    if not _runners[-1][0]:
+        if cache is None or not cache.ready:
+            _log("the hot cache is not seeded when the pool is built: nothing lent")
+            return
+        # before the graphs are captured
+        _make_tables(cache)
+
+
+_want_lend = True
+
+
+def _threshold() -> int:
+    from sglang.srt.layers.moe import kt_lend
+
+    t = kt_lend._threshold()
+    return t if t > 0 else 1 << 62
+
+
+def _streamed(fb) -> bool:
+    from sglang.srt.layers.moe import kt_lend
+
+    if kt_lend.ENABLED and kt_lend.STATE.get("phase") in ("prefill", "decode"):
+        return kt_lend.STATE["phase"] == "prefill"
+    return kt_lend._streamed(fb)
+
+
+def before_forward(runner, fb) -> None:
+    """ModelRunner.forward, after the lend's phase switch, outside any graph."""
+    global _lender, _want_lend
+    if not ENABLED or getattr(runner, "is_draft_worker", False):
+        return
+    cache = kt_hot_cache._cache
+    if cache is None or not cache.ready or not _tables_ready:
+        return
+    from sglang.srt.model_executor.forward_batch_info import ForwardMode
+
+    mode = fb.forward_mode
+    if _lender is None:
+        a = runner.token_to_kv_pool_allocator
+        if not getattr(a, "_kt_kv_lend", False):
+            return
+        pools = [p for _, p, al in _runners if al is a]
+        _lender = Lender(a, pools, cache)
+    L = _lender
+    if mode in (ForwardMode.EXTEND, ForwardMode.MIXED, ForwardMode.SPLIT_PREFILL):
+        if _streamed(fb):
+            if RELEASE_AT_PREFILL and L.lent:
+                STATS["released_at_prefill"] += 1
+                L.take_back(L.lent, "streamed prefill")
+            _want_lend = True
+            return
+        L.try_lend("extend")
+        _want_lend = True
+    elif (mode.is_decode() or mode.is_target_verify()) and _want_lend:
+        _want_lend = False
+        L.try_lend("decode")
diff --git a/python/sglang/srt/layers/moe/kt_knobs.py b/python/sglang/srt/layers/moe/kt_knobs.py
new file mode 100644
index 0000000..7095e8b
--- /dev/null
+++ b/python/sglang/srt/layers/moe/kt_knobs.py
@@ -0,0 +1,60 @@
+"""Knobs changed while the server runs, for A/B runs on one launch (KT_KNOB_FILE).
+
+When KT_KNOB_FILE is set, poll() (called before every forward by the model
+runner, sglang-kt-knobs.py) looks at the file's mtime at most every 0.25 s and,
+when it changed, applies its lines:
+  NAME=VALUE                kt_kernel_ext.set_knob (kt-kernel-live-knobs.py)
+  py:module.ATTR=VALUE      setattr on sglang.srt.layers.moe.<module> (int or float)
+and writes "[kt-knobs] applied <file contents>" to the log, with a running
+count so a harness can wait for it. Unset: poll() returns at once.
+
+Only knobs read per call take effect. Anything decided while a CUDA graph is
+captured (Python branches on the GPU side) keeps its captured value.
+"""
+import importlib
+import os
+import time
+
+PATH = os.environ.get("KT_KNOB_FILE")
+_next = 0.0
+_mtime = None
+_applied = 0
+
+
+def _apply(text):
+    import kt_kernel.kt_kernel_ext as ext
+
+    for line in text.splitlines():
+        line = line.strip()
+        if not line or line.startswith("#") or "=" not in line:
+            continue
+        name, value = (part.strip() for part in line.split("=", 1))
+        if name.startswith("py:"):
+            mod, attr = name[3:].rsplit(".", 1)
+            m = importlib.import_module(f"sglang.srt.layers.moe.{mod}")
+            old = getattr(m, attr)
+            setattr(m, attr, type(old)(value) if isinstance(old, (int, float)) else value)
+        else:
+            ext.set_knob(name, int(value))
+
+
+def poll():
+    global _next, _mtime, _applied
+    if PATH is None:
+        return
+    now = time.monotonic()
+    if now < _next:
+        return
+    _next = now + 0.25
+    try:
+        st = os.stat(PATH)
+    except FileNotFoundError:
+        return
+    if st.st_mtime_ns == _mtime:
+        return
+    _mtime = st.st_mtime_ns
+    with open(PATH) as f:
+        text = f.read()
+    _apply(text)
+    _applied += 1
+    print(f"[kt-knobs] applied #{_applied} pid {os.getpid()}: {' '.join(text.split())}", flush=True)
diff --git a/python/sglang/srt/layers/moe/kt_launch_timing.py b/python/sglang/srt/layers/moe/kt_launch_timing.py
new file mode 100644
index 0000000..c02223c
--- /dev/null
+++ b/python/sglang/srt/layers/moe/kt_launch_timing.py
@@ -0,0 +1,347 @@
+"""KT_LAUNCH_TIMING=1: a per-step timeline of the weight load (launch-time
+instrument, no behaviour change). Installed from ModelRunner.load_model
+(patches/sglang-kt-launch-timing.py); wraps the load's functions in place and
+prints, per rank process:
+
+  [kt-launch HH:MM:SS.mmm r<rank>] <step> <seconds> s | disk <GB> (<GB/s>) | <extra>
+
+"disk" is this process's /proc/self/io read_bytes over the step (bytes the
+block layer fetched for it: read() and mmap page faults that missed the page
+cache). Steps that run many times (a tensor fetch, a layer's CPU experts) are
+summed per kind and printed in a table when the target's load ends.
+"""
+import functools
+import os
+import re
+import resource
+import threading
+import time
+from collections import defaultdict
+
+ENABLED = os.environ.get("KT_LAUNCH_TIMING") == "1"
+_installed = False
+_rank = None
+_lock = threading.Lock()
+_sums = defaultdict(lambda: [0, 0.0, 0, 0])  # kind -> [count, seconds, bytes copied, disk bytes]
+_t_install = None
+
+
+def _io():
+    try:
+        with open("/proc/self/io") as f:
+            d = dict(line.split(": ") for line in f.read().splitlines())
+        return int(d["read_bytes"]), int(d["rchar"])
+    except Exception:
+        return 0, 0
+
+
+def _faults():
+    r = resource.getrusage(resource.RUSAGE_SELF)
+    return r.ru_majflt, r.ru_minflt
+
+
+def _r():
+    global _rank
+    if _rank is None:
+        try:
+            from sglang.srt.distributed import get_tensor_model_parallel_rank
+
+            _rank = get_tensor_model_parallel_rank()
+        except Exception:
+            return "?"
+    return _rank
+
+
+def log(msg: str) -> None:
+    t = time.time()
+    print(f"[kt-launch {time.strftime('%H:%M:%S', time.localtime(t))}.{int(t * 1000) % 1000:03d} r{_r()}] {msg}", flush=True)
+
+
+class step:
+    """with step("name", nbytes=...): one timed step, printed at its end."""
+
+    def __init__(self, name, nbytes=0, quiet=False, kind=None):
+        self.name, self.nbytes, self.quiet, self.kind = name, nbytes, quiet, kind
+
+    def __enter__(self):
+        self.t0 = time.perf_counter()
+        self.io0 = _io()
+        self.f0 = _faults()
+        return self
+
+    def __exit__(self, *exc):
+        dt = time.perf_counter() - self.t0
+        io1 = _io()
+        f1 = _faults()
+        disk = io1[0] - self.io0[0]
+        if self.kind:
+            with _lock:
+                s = _sums[self.kind]
+                s[0] += 1
+                s[1] += dt
+                s[2] += self.nbytes
+                s[3] += disk
+        if not self.quiet:
+            extra = f" | copied {self.nbytes / 1e9:.2f} GB ({self.nbytes / 1e9 / max(dt, 1e-9):.2f} GB/s)" if self.nbytes else ""
+            log(f"{self.name} {dt:.2f} s | disk {disk / 1e9:.2f} GB ({disk / 1e9 / max(dt, 1e-9):.2f} GB/s)"
+                f" | majflt {f1[0] - self.f0[0]} minflt {f1[1] - self.f0[1]}{extra}")
+        return False
+
+
+def _wrap(obj, attr, name=None, kind=None, quiet=False, nbytes_of=None):
+    fn = getattr(obj, attr, None)
+    if fn is None or getattr(fn, "_kt_launch_wrapped", False):
+        return
+    label = name or f"{getattr(obj, '__name__', obj)}.{attr}"
+
+    @functools.wraps(fn)
+    def w(*a, **k):
+        st = step(label, kind=kind, quiet=quiet)
+        with st:
+            out = fn(*a, **k)
+            if nbytes_of is not None:
+                try:
+                    st.nbytes = nbytes_of(a, k, out)
+                except Exception:
+                    pass
+        return out
+
+    w._kt_launch_wrapped = True
+    if isinstance(obj, type) and isinstance(obj.__dict__.get(attr), staticmethod):
+        setattr(obj, attr, staticmethod(w))
+    else:
+        setattr(obj, attr, w)
+
+
+def _wrap_iter(gen_fn_owner, attr):
+    """A weight iterator: the time spent producing each item (the GGUF read and
+    dequant) and consuming it (the model's weight_loader: the GPU copy, the
+    PLE rows into pinned memory), per kind of tensor."""
+    fn = getattr(gen_fn_owner, attr)
+    if getattr(fn, "_kt_launch_wrapped", False):
+        return
+
+    def kind_of(name):
+        if "ngram_embedding" in name:
+            return "PLE table shard"
+        if name.endswith("qweight") or name.endswith("qweight_type"):
+            return "dense GGUF blocks"
+        return "dense bf16/f32"
+
+    @functools.wraps(fn)
+    def w(*a, **k):
+        t_all = time.perf_counter()
+        io_all = _io()
+        it = iter(fn(*a, **k))
+        n = 0
+        while True:
+            t0 = time.perf_counter()
+            io0 = _io()
+            try:
+                name, t = next(it)
+            except StopIteration:
+                break
+            t1 = time.perf_counter()
+            io1 = _io()
+            kd = kind_of(name)
+            nb = t.numel() * t.element_size() if hasattr(t, "numel") else 0
+            with _lock:
+                s = _sums["produce: " + kd]
+                s[0] += 1
+                s[1] += t1 - t0
+                s[2] += nb
+                s[3] += io1[0] - io0[0]
+            yield name, t
+            t2 = time.perf_counter()
+            io2 = _io()
+            with _lock:
+                s = _sums["consume: " + kd]
+                s[0] += 1
+                s[1] += t2 - t1
+                s[2] += nb
+                s[3] += io2[0] - io1[0]
+            n += 1
+        dt = time.perf_counter() - t_all
+        log(f"weight iterator {attr}: {n} tensors in {dt:.2f} s | disk {(_io()[0] - io_all[0]) / 1e9:.2f} GB")
+
+    w._kt_launch_wrapped = True
+    setattr(gen_fn_owner, attr, w)
+
+
+def summary(title):
+    with _lock:
+        rows = sorted(_sums.items(), key=lambda kv: -kv[1][1])
+    log(f"--- {title}: summed steps (count, seconds, GB copied, GB from disk) ---")
+    for kind, (n, sec, nb, disk) in rows:
+        rate = f" {nb / 1e9 / sec:.2f} GB/s" if nb and sec > 0 else ""
+        log(f"  {kind:<48s} n={n:<6d} {sec:8.2f} s  {nb / 1e9:8.2f} GB{rate}  disk {disk / 1e9:.2f} GB")
+
+
+_stacks = defaultdict(int)
+_stack_samples = [0]
+_leaves = defaultdict(int)
+_stack_stop = threading.Event()
+
+
+def _stack_sampler(main_id, interval):
+    """KT_LAUNCH_TIMING_STACKS=<seconds>: samples the loading thread's stack;
+    the summary lists the frames by inclusive share of the samples."""
+    import sys
+
+    while not _stack_stop.wait(interval):
+        f = sys._current_frames().get(main_id)
+        leaf, g = [], f
+        while g is not None and len(leaf) < 5:
+            leaf.append(f"{'/'.join(g.f_code.co_filename.split('/')[-2:])}:{g.f_code.co_name}:{g.f_lineno}")
+            g = g.f_back
+        _leaves[" < ".join(leaf)] += 1
+        seen = set()
+        while f is not None:
+            c = f.f_code
+            fn = c.co_filename
+            short = "/".join(fn.split("/")[-2:])
+            key = f"{short}:{c.co_name}"
+            if key not in seen:
+                seen.add(key)
+                _stacks[key] += 1
+            f = f.f_back
+        _stack_samples[0] += 1
+
+
+def stack_summary(top=45):
+    n = _stack_samples[0]
+    if not n:
+        return
+    iv = float(os.environ.get("KT_LAUNCH_TIMING_STACKS", "0") or 0)
+    log(f"--- stack samples: {n} x {iv} s (inclusive) ---")
+    for k, c in sorted(_stacks.items(), key=lambda kv: -kv[1])[:top]:
+        log(f"  {c * iv:8.1f} s  {100.0 * c / n:5.1f}%  {k}")
+    log("--- innermost 5 frames (exclusive) ---")
+    for k, c in sorted(_leaves.items(), key=lambda kv: -kv[1])[:40]:
+        log(f"  {c * iv:8.1f} s  {k}")
+
+
+def install(runner=None) -> None:
+    global _installed, _t_install
+    if not ENABLED:
+        return
+    tag = "draft" if runner is not None and getattr(runner, "is_draft_worker", False) else "target"
+    log(f"load_model begin ({tag}) pid {os.getpid()}")
+    if _installed:
+        return
+    _installed = True
+    _t_install = time.perf_counter()
+    iv = float(os.environ.get("KT_LAUNCH_TIMING_STACKS", "0") or 0)
+    if iv > 0:
+        threading.Thread(target=_stack_sampler, args=(threading.get_ident(), iv), daemon=True,
+                         name="kt-launch-stacks").start()
+    try:
+        from kt_kernel.utils import loader as ktl
+
+        _wrap(ktl.GGUFLoader, "__init__", "GGUFLoader parse", kind="GGUFLoader parse (gguf-py)")
+
+        def _nb(a, k, out):
+            return out[0].numel()
+
+        # tensor fetch: mmap slice -> .copy() (page faults on the file, a fresh buffer)
+        _wrap(ktl.GGUFLoader, "get_undequanted_tensor_and_ggml_type", kind="GGUF tensor .copy() out of the mmap",
+              quiet=True, nbytes_of=_nb)
+    except Exception as e:
+        log(f"kt_kernel loader not wrapped: {e}")
+    try:
+        from kt_kernel.utils import llamafile as ktll
+
+        _wrap(ktll.LlamafileMoEWrapper, "__init__", kind="LlamafileMoEWrapper.__init__ (48 layers)", quiet=True)
+        _wrap(ktll.LlamafileMoEWrapper, "load_weights", kind="CPU experts load_weights (fetch + C++ load/repack)",
+              quiet=True)
+    except Exception as e:
+        log(f"llamafile wrapper not wrapped: {e}")
+    try:
+        from sglang.srt.layers.moe import kt_ep_wrapper as kew
+
+        _wrap(kew, "_drop_checkpoint_cache", kind="per-layer page-cache drop (KT_GPU_STREAM_DROP_CACHE)", quiet=True)
+        _wrap(kew.KTEPWrapperMethod, "process_weights_after_loading",
+              kind="KT MoE process_weights_after_loading (whole)", quiet=True)
+    except Exception as e:
+        log(f"kt_ep_wrapper not wrapped: {e}")
+    try:
+        from sglang.srt.layers.moe import kt_gguf_hot as kgh
+
+        for name, cls in vars(kgh).items():
+            if isinstance(cls, type) and "process_weights_after_loading" in cls.__dict__:
+                _wrap(cls, "process_weights_after_loading", kind=f"{name}.process_weights_after_loading (hot from GGUF)",
+                      quiet=True)
+    except Exception as e:
+        log(f"kt_gguf_hot not wrapped: {e}")
+    try:
+        from sglang.srt.layers.moe import kt_stream_prefill_gguf as ksg
+
+        _wrap(ksg.KTStreamPrefillGGUF, "__init__", "streamer __init__ (incl. GGUF geometry)")
+        _wrap(ksg.KTStreamPrefillGGUF, "build_all_banks", "streamer build_all_banks",
+              nbytes_of=lambda a, k, out: sum(sum(t.numel() for t in b) for b in a[0]._banks.values()))
+        _wrap(ksg.KTStreamPrefillGGUF, "_bank", kind="streamer _bank (per layer, threads overlap)", quiet=True)
+    except Exception as e:
+        log(f"stream gguf not wrapped: {e}")
+    try:
+        from sglang.srt.layers.moe import kt_hot_cache as khc
+
+        for attr in ("register", "seed", "_seed"):
+            if hasattr(khc, attr):
+                _wrap(khc, attr, kind=f"kt_hot_cache.{attr}", quiet=True)
+    except Exception as e:
+        log(f"kt_hot_cache not wrapped: {e}")
+    try:
+        from sglang.srt.layers.moe import kt_lend
+
+        _wrap(kt_lend, "bind_model", "kt_lend.bind_model")
+        _wrap(kt_lend, "_relayout", kind="kt_lend._relayout (per layer, pinned bounce)", quiet=True)
+        _wrap(kt_lend, "after_load", "kt_lend.after_load (relayout x48 + mirror)")
+    except Exception as e:
+        log(f"kt_lend not wrapped: {e}")
+    try:
+        from sglang.srt.layers.moe import kt_gguf_dense as kgd
+
+        _wrap_iter(kgd, "gguf_all_weights")
+        _wrap(kgd, "attach_hc_fp8", "attach_hc_fp8 (hc int8/fp8 copies)")
+        _wrap(kgd, "attach_ssm_out_perms", "attach_ssm_out_perms")
+    except Exception as e:
+        log(f"kt_gguf_dense not wrapped: {e}")
+    try:
+        from sglang.srt.model_loader import loader as sl
+
+        _wrap(sl, "_initialize_model", "model build (_initialize_model, incl. KT wrappers)")
+        orig = sl.DefaultModelLoader.__dict__["load_weights_and_postprocess"]
+        fn = orig.__func__ if isinstance(orig, staticmethod) else orig
+        if not getattr(fn, "_kt_launch_wrapped", False):
+            src_ok = True
+
+            @functools.wraps(fn)
+            def lwp(model, weights, target_device):
+                # model.load_weights and the postprocess loop, timed apart through
+                # a wrapper on model.load_weights
+                ml = model.load_weights
+                st_lw = step("model.load_weights (weight iterator + weight_loaders)")
+
+                def timed_lw(*a, **k):
+                    with st_lw:
+                        return ml(*a, **k)
+
+                model.load_weights = timed_lw
+                try:
+                    with step("load_weights_and_postprocess (whole)"):
+                        return fn(model, weights, target_device)
+                finally:
+                    try:
+                        del model.load_weights
+                    except Exception:
+                        pass
+                    summary(f"after load_weights_and_postprocess ({type(model).__name__})")
+                    if _stack_samples[0] and not _stack_stop.is_set():
+                        _stack_stop.set()
+                        stack_summary()
+
+            lwp._kt_launch_wrapped = True
+            sl.DefaultModelLoader.load_weights_and_postprocess = staticmethod(lwp)
+    except Exception as e:
+        log(f"loader not wrapped: {e}")
+    log("installed")
diff --git a/python/sglang/srt/layers/moe/kt_lend.py b/python/sglang/srt/layers/moe/kt_lend.py
new file mode 100644
index 0000000..ffe6f2b
--- /dev/null
+++ b/python/sglang/srt/layers/moe/kt_lend.py
@@ -0,0 +1,882 @@
+# SPDX-License-Identifier: Apache-2.0
+"""KT prefill lend (KT_PREFILL_LEND=1): during a streamed prefill the
+GPU-resident weights hand their physical memory to the prefill and come back,
+at the same addresses, before decode.
+
+Model-agnostic; a tree wires it in at five points (see
+patches/sglang-kt-prefill-lend.py for SGLang):
+
+  bind_model(model)        right after the model is built, before any weight
+                           loads (model_loader._initialize_model)
+  after_load()             after every module's weight processing, before the
+                           KV pool is sized (load_weights_and_postprocess)
+  before_forward(batch)    at the model runner's forward entry, outside any graph
+  scratch_empty(...)       for buffers only a streamed prefill uses (the
+                           streamer's slots and inputs, the prefill workspace)
+  scratch_region()         the same for allocations made lazily inside a
+                           streamed prefill (contents are not kept from one
+                           prefill window to the next)
+  phase()                  "load" / "decode" / "prefill", for code that picks
+                           a buffer by phase
+
+What is lent: the first model bound (a draft built later stays resident),
+its decoder layers (the largest ModuleList named "layers")
+and, per layer, every CUDA parameter of at least KT_PREFILL_LEND_MIN_BYTES
+(default 1 MiB) whose name contains none of KT_PREFILL_LEND_SKIP
+(comma-separated, default "engram": V4.1's engram is read ahead of its layer
+on another stream). Each layer gets one span, its own allocation in
+torch_memory_saver tag "kt_lend_weights", made layer by layer at the bind so
+the originals are dropped as it goes; the span has room for the layer's
+small parameters too, which the loading may stack into a fused owner.
+
+Fused owners: after loading, a model may have stacked several parameters into
+one tensor attribute and turned the parameters into views of it (Flash-Next's
+gated delta net: _fused_in_proj_weight = [in_proj_qkvz; in_proj_ba]). Such a
+tensor (a plain CUDA tensor attribute of a module in the layer, holding at
+least one lent parameter) is taken whole into the span; every parameter of
+the layer that points into it becomes a view of it there, and it is pointed
+at the slot too while lent. Tensors the model derives as copies (no
+parameter inside) are left alone: they stay resident.
+
+After load, every layer is laid out again from what the loading left:
+fused owners first, then the lent parameters as they are now (a repack may
+have changed their shape, or made new ones of at least the minimum size),
+through pinned host memory back into the same span when it fits.
+
+Phase swap: to prefill = pause the weights tag (physical memory released,
+addresses kept), resume the scratch tag; to decode = empty_cache, pause
+scratch, resume weights, copy the pinned mirror back. While paused, the
+weights' addresses map nothing: a read that misses the per-layer entry
+faults at once. Entering layer i (a forward pre-hook on the layer and on
+each child holding lent parameters, and every forward* method of the layer,
+for models that call the layer by another method, like V4's
+forward_hc_pre_from_prev) points the previous layer back at its span, points
+layer i's lent tensors at slot i % 2 (prefetched on a side stream while
+layer i-1 ran) and starts layer i+1's copy.
+
+Chunk hint (KT_PREFILL_LEND_HINT=<prefix>): each prefill window measures the
+free memory at its start, torch's peak reserved growth and the largest
+forward; the rank writes <prefix>-rank<r>.json with the chunk that would
+still have fitted (margin KT_PREFILL_LEND_MARGIN_MB, 256), the smallest since
+the server started.
+
+Requires torch_memory_saver (hook mode "torch").
+"""
+
+import contextlib
+import math
+import os
+from typing import Optional
+import time
+
+import torch
+
+ENABLED = os.environ.get("KT_PREFILL_LEND", "0") == "1"
+MIN_BYTES = int(os.environ.get("KT_PREFILL_LEND_MIN_BYTES", str(1 << 20)))
+TAG_WEIGHTS = "kt_lend_weights"
+TAG_SCRATCH = "kt_lend_scratch"
+HINT = os.environ.get("KT_PREFILL_LEND_HINT", "")
+# 256 MiB (was 512): what a window adds outside torch's allocator measured 0 to
+# 62 MiB over V4.1 and Qwen3.5 windows of 7K to 989K tokens (10-06); growth with
+# the sequence is in the measured peak of a window, not in this margin
+MARGIN = int(os.environ.get("KT_PREFILL_LEND_MARGIN_MB", "256")) << 20
+DEBUG = os.environ.get("KT_PREFILL_LEND_DEBUG", "0") == "1"
+SKIP = [w for w in os.environ.get("KT_PREFILL_LEND_SKIP", "engram").split(",") if w]
+# KT_PREFILL_LEND_IDLE: lent but not brought back layer by layer during a
+# prefill, for weights the prefill path never reads (GLM-5.3's hot experts:
+# its full-GPU prefill writes every expert into its own slot). Laid out at the
+# end of the span; only the part before them is copied into the slot, and they
+# keep pointing at the paused span, so a read faults instead of going wrong.
+IDLE = [w for w in os.environ.get("KT_PREFILL_LEND_IDLE", "").split(",") if w]
+# KT_PREFILL_LEND_PFONLY: lent weights only the prefill reads (Flash-Next's bf16
+# hyper-connection mix; decode runs int8 copies): in the mirror and the slot
+# copy, laid out at the end of the layer, but not in the decode span; outside a
+# layer's prefill turn they point at an empty tensor (kt-lend-prefill-only.py)
+PFONLY = [w for w in os.environ.get("KT_PREFILL_LEND_PFONLY", "").split(",") if w]
+if PFONLY and IDLE:
+    raise RuntimeError("KT_PREFILL_LEND_PFONLY and KT_PREFILL_LEND_IDLE do not combine")
+# KT_PREFILL_LEND_LONG_SEQ: an extend below the streaming threshold still runs
+# lent when its sequence is this long (65536). A long prompt's last chunk, or a
+# short turn on a long conversation, makes prefix-sized buffers (V4.1's indexer
+# gathers every compressed K: 484 MiB at a 989K-token prefix) that a card with
+# its weights and KV pool back does not have room for (10-06). Not with IDLE:
+# its weights are not brought back for a forward the streamer does not take.
+LONG_SEQ = int(os.environ.get("KT_PREFILL_LEND_LONG_SEQ", "65536"))
+
+STATE = {"phase": "load", "scratch_bytes": 0, "scratch_chunk_bytes": 0, "to_prefill": 0, "to_decode": 0}
+_saver = None
+
+
+def _log(msg: str) -> None:
+    print(f"[kt-lend] {msg}", flush=True)
+
+
+def _tms():
+    global _saver
+    if _saver is None:
+        import torch_memory_saver as m
+
+        _saver = m.torch_memory_saver
+        _saver.hook_mode = "torch"
+    return _saver
+
+
+def _align(n: int) -> int:
+    return (n + 255) & ~255
+
+
+def _ready(t) -> bool:
+    return not isinstance(t, torch.nn.parameter.UninitializedParameter)
+
+
+def _nbytes(t) -> int:
+    if isinstance(t, torch.nn.parameter.UninitializedParameter):
+        # a GGUF qweight before the load materializes it: room for the
+        # largest type the GGUF uses for dense weights (Q8_0, 8.5 bits)
+        shape = getattr(t, "tensor_shape", None)
+        return int(math.prod(shape)) * 9 // 8 if shape else 0
+    return t.numel() * t.element_size()
+
+
+def phase() -> str:
+    return STATE["phase"]
+
+
+# -- scratch ---------------------------------------------------------------------
+
+def scratch_empty(shape, dtype, device, per_chunk: bool = False) -> torch.Tensor:
+    """A tensor resident only during a streamed prefill (a plain one when
+    lending is off). Call before the weights load. per_chunk: its size grows
+    with the prefill chunk (counted for the chunk hint)."""
+    if not ENABLED:
+        return torch.empty(shape, dtype=dtype, device=device)
+    with _tms().region(tag=TAG_SCRATCH):
+        t = torch.empty(shape, dtype=dtype, device=device)
+    STATE["scratch_bytes"] += _nbytes(t)
+    if per_chunk:
+        STATE["scratch_chunk_bytes"] += _nbytes(t)
+    return t
+
+
+def scratch_region():
+    """Allocations inside go to the scratch tag while lending is on. Meant for
+    buffers a streamed prefill makes on its first use (the tag is resident
+    then); outside a prefill they are made as plain allocations."""
+    if not ENABLED or STATE["phase"] == "decode":
+        return contextlib.nullcontext()
+    return _tms().region(tag=TAG_SCRATCH)
+
+
+# -- layout ----------------------------------------------------------------------
+# A layer's layout is a list of items, each placed at a byte offset of its span:
+#   ("param", name, shape, dtype, off, nbytes)
+#   ("owner", module, attr, shape, dtype, off, nbytes, [(name, shape, dtype, delta, nbytes), ...])
+# where an owner's inner parameters are views at off + delta.
+
+def _decoder_layers(model):
+    best, best_bytes = None, 0
+    for name, m in model.named_modules():
+        if not isinstance(m, torch.nn.ModuleList) or not (name == "layers" or name.endswith(".layers")):
+            continue
+        nb = sum(_nbytes(p) for p in m.parameters() if p.device.type == "cuda")
+        if nb > best_bytes:
+            best, best_bytes = m, nb
+    if best is None:
+        return []
+    return [l for l in best if isinstance(l, torch.nn.Module) and type(l).__name__ != "PPMissingLayer"]
+
+
+def _place(dspan, item):
+    if item[0] == "param":
+        _, name, shape, dtype, off, nb = item
+        return dspan[off:off + nb].view(dtype).view(shape)
+    _, mod, attr, shape, dtype, off, nb, inner = item
+    return dspan[off:off + nb].view(dtype).view(shape)
+
+
+def _point(layer, dspan, layout, limit=None) -> None:
+    """Point the layer's lent tensors at dspan (its device span or a slot);
+    with a limit, only those placed before it."""
+    for item in layout:
+        if limit is not None and (item[4] if item[0] == "param" else item[5]) >= limit:
+            continue
+        if item[0] == "param":
+            layer.get_parameter(item[1]).data = _place(dspan, item)
+        else:
+            _, mod, attr, shape, dtype, off, nb, inner = item
+            setattr(mod, attr, _place(dspan, item))
+            for name, pshape, pdtype, delta, pnb in inner:
+                layer.get_parameter(name).data = dspan[off + delta:off + delta + pnb].view(pdtype).view(pshape)
+
+
+def _pfonly_empty(layer, layout, dec) -> None:
+    """The layer's prefill-only weights (placed at or after dec) point at empty tensors."""
+    for item in layout:
+        if item[0] == "param" and item[4] >= dec:
+            layer.get_parameter(item[1]).data = torch.empty(0, dtype=item[3], device=STATE["device"])
+
+
+def _point_back(i: int) -> None:
+    """Layer i back at its decode span (prefill-only weights at empty tensors)."""
+    dec = STATE.get("dec_end", {}).get(i)
+    _point(STATE["layers"][i], STATE["dev_spans"][i], STATE["layouts"][i], limit=dec)
+    if dec is not None and dec < STATE["spans"][i]:
+        _pfonly_empty(STATE["layers"][i], STATE["layouts"][i], dec)
+
+
+def bind_model(model) -> None:
+    """Right after the model is built: each decoder layer's large CUDA
+    parameters move into one span of their own, layer by layer."""
+    if not ENABLED or "layers" in STATE or STATE["phase"] != "load":
+        return
+    layers = _decoder_layers(model)
+    entries = []
+    for layer in layers:
+        lay, off, slack = [], 0, 0
+        for name, p in layer.named_parameters():
+            if isinstance(p, torch.nn.parameter.UninitializedParameter):
+                slack += _align(_nbytes(p))  # GGUF qweight: made by the load, taken in after it
+                continue
+            if p.device.type != "cuda" or not p.is_contiguous() or any(w in name for w in SKIP + PFONLY):
+                continue
+            if _nbytes(p) < MIN_BYTES:
+                # room for it in case the loading stacks it into a fused
+                # owner with lent parameters (Flash-Next's in_proj_ba)
+                slack += _align(_nbytes(p))
+                continue
+            lay.append(("param", name, tuple(p.shape), p.dtype, off, _nbytes(p)))
+            off = _align(off + _nbytes(p))
+        if lay:
+            entries.append((layer, lay, _align(off) + slack))
+    if not entries:
+        _log("no decoder layer with lendable weights: off")
+        return
+    device = entries[0][0].get_parameter(entries[0][1][0][1]).device
+    dev_spans = []
+    for idx, (layer, lay, span) in enumerate(entries):
+        with _tms().region(tag=TAG_WEIGHTS):
+            dspan = torch.empty(span, dtype=torch.uint8, device=device)
+        for item in lay:
+            _place(dspan, item).copy_(layer.get_parameter(item[1]))
+        _point(layer, dspan, lay)
+        dev_spans.append(dspan)
+        # the dropped originals go back to torch's cache, not to the driver,
+        # and torch_memory_saver allocates from the driver: hand them back
+        torch.cuda.synchronize(device)
+        torch.cuda.empty_cache()
+        _hook_entries(layer, idx, {item[1] for item in lay})
+    STATE.update(layers=[e[0] for e in entries], layouts=[e[1] for e in entries],
+                 spans=[e[2] for e in entries], dev_spans=dev_spans, dev_full=list(dev_spans),
+                 device=device, counts=dict(owners=0, grown=0, moved=0, dropped=0, aliases=0, early=0))
+    for idx, (layer, _, _) in enumerate(entries):
+        for m in layer.modules():
+            m._kt_lend_layer = idx
+    # the one-layer slots now, while the card is empty (the spans' room
+    # covers what moving the owners in adds)
+    STATE["slots"] = [scratch_empty((max(STATE["spans"]),), torch.uint8, device) for _ in range(2)]
+    _log(f"{len(entries)} decoder layers, {sum(STATE['spans']) / 1e9:.3f} GB of weights in per-layer "
+         f"spans on {device} (min parameter {MIN_BYTES / 1e6:.1f} MB)")
+
+
+def _hook_entries(layer, idx: int, lent) -> None:
+    """Every way into layer idx enters it: its own forward, the children
+    holding lent parameters, and its other forward* methods."""
+    layer._kt_lend_idx = idx
+    layer.register_forward_pre_hook(_enter_hook)
+    for cname, child in layer.named_children():
+        if any(n.startswith(cname + ".") for n in lent):
+            child._kt_lend_idx = idx
+            child.register_forward_pre_hook(_enter_hook)
+    for name in dir(type(layer)):
+        if name.startswith("forward") and name != "forward" and callable(getattr(type(layer), name)):
+            setattr(layer, name, _entering(getattr(layer, name), idx))
+
+
+def _entering(fn, idx: int):
+    def wrapper(*args, **kwargs):
+        _enter(idx)
+        return fn(*args, **kwargs)
+
+    return wrapper
+
+
+def _lent_names(lay):
+    """The parameter names a layout lends, an owner's inner ones included."""
+    names = []
+    for item in lay:
+        if item[0] == "param":
+            names.append(item[1])
+        else:
+            names += [rec[0] for rec in item[7]]
+    return names
+
+
+def _owners_after_load(layer, lay):
+    """Plain CUDA tensor attributes in the layer that hold at least one lent
+    parameter: [(module, attr, tensor, [(name, delta)]...)]."""
+    params = dict(layer.named_parameters())
+    lent = set(_lent_names(lay))
+    found = []
+    for mod in layer.modules():
+        for attr, val in list(vars(mod).items()):
+            if attr.startswith("_parameters") or attr.startswith("_buffers"):
+                continue
+            if not torch.is_tensor(val) or isinstance(val, torch.nn.Parameter) or not val.is_cuda:
+                continue
+            if not val.is_contiguous() or _nbytes(val) < MIN_BYTES:
+                continue
+            lo, hi = val.data_ptr(), val.data_ptr() + _nbytes(val)
+            inner = [(n, p.data_ptr() - lo) for n, p in params.items()
+                     if p.is_cuda and lo <= p.data_ptr() < hi and p.is_contiguous()]
+            if any(n in lent for n, _ in inner):
+                found.append((mod, attr, val, inner))
+    return found
+
+
+def _relayout(i: int, counts) -> None:
+    """Lay layer i out again from what the loading left: fused owners
+    first, then the lent parameters as they are now, through pinned host
+    memory back into the same span when it fits."""
+    device = STATE["device"]
+    layer = STATE["layers"][i]
+    lay = STATE["layouts"][i]
+    full = STATE["dev_full"][i]
+    lo, hi = full.data_ptr(), full.data_ptr() + full.numel()
+    found = _owners_after_load(layer, lay)
+    inner_names = {n for _, _, _, inner in found for n, _ in inner}
+    new, off = [], 0
+    for mod, attr, val, inner in found:
+        recs = [(n, tuple(layer.get_parameter(n).shape), layer.get_parameter(n).dtype, d,
+                 _nbytes(layer.get_parameter(n))) for n, d in inner]
+        new.append(("owner", mod, attr, tuple(val.shape), val.dtype, off, _nbytes(val), recs))
+        off = _align(off + _nbytes(val))
+        counts["owners"] += 1
+    mod = val = inner = None  # the owners' originals go when the layer is pointed away
+    params = dict(layer.named_parameters())
+    # a layer laid out again during the load has owner items: their inner
+    # parameters are what it lends (taking item[1], the owner's module, as a
+    # name dropped the owner and overwrote it in place, 10-05)
+    names = _lent_names(lay)
+    # what the loading made anew (a repack under another name) and is big
+    # enough is lent too
+    names += [n for n, q in params.items() if n not in names and _ready(q) and q.is_cuda and q.is_contiguous()
+              and _nbytes(q) >= MIN_BYTES and not any(w in n for w in SKIP)
+              and (STATE.get("final") or not any(w in n for w in PFONLY))]
+    # prefill-only weights only in after_load's final pass: a layer laid out
+    # again during the load (after_module) keeps them in its span, or the
+    # final pass would find them emptied
+    pfonly = PFONLY if STATE.get("final") else []
+    names = ([n for n in names if not any(w in n for w in IDLE + pfonly)]
+             + [n for n in names if any(w in n for w in IDLE)]
+             + [n for n in names if any(w in n for w in pfonly)])
+    active = pfo = None
+    for name in names:
+        q = params.get(name)
+        if active is None and any(w in name for w in IDLE):
+            active = off
+        if pfo is None and any(w in name for w in pfonly):
+            pfo = off
+        if name in inner_names or q is None or not _ready(q) or not q.is_cuda or not q.is_contiguous():
+            if q is None:
+                # a second name for a parameter registered under another one
+                # (alias_or_bind_derived_param: Flash-Next's *_blockscale_swizzled
+                # is w*_weight_scale), which named_parameters() lists once
+                try:
+                    alias = any(layer.get_parameter(name) is v for v in params.values())
+                except AttributeError:
+                    alias = False
+                counts["aliases" if alias else "dropped"] += 1
+                if not alias:
+                    counts.setdefault("gone_names", set()).add(name)
+            continue
+        if not lo <= q.data_ptr() < hi:
+            counts["moved"] += 1
+        new.append(("param", name, tuple(q.shape), q.dtype, off, _nbytes(q)))
+        off = _align(off + _nbytes(q))
+    params = q = None
+    span = _align(off)
+    STATE.setdefault("active", {})[i] = span if active is None else active
+    dec = span if pfo is None else pfo
+    STATE.setdefault("dec_end", {})[i] = dec
+    # through pinned host memory, back into the same span (the bind left
+    # room for the small parameters an owner may take in): freeing a span
+    # and making a slightly larger one cut a new segment per layer on one
+    # Flash-Next rank, and the card ran out after ~20 layers
+    # KT_FAST_PINNED=1: one reused pinned bounce instead of a cudaHostAlloc
+    # per layer (patches/sglang-kt-fast-load.py)
+    from sglang.srt.layers.moe import kt_pinned
+
+    host, src = kt_pinned.bounce(span), None
+    for item in new:
+        src = getattr(item[1], item[2]) if item[0] == "owner" else layer.get_parameter(item[1])
+        _place(host, item).copy_(src)
+    _point(layer, host, new)
+    STATE["dev_spans"][i] = None
+    del found, src
+    # the decode span ends before the prefill-only weights; one that would keep
+    # 1 MiB or more of them is made anew so the memory goes back
+    shrink = dec < span and full.numel() - dec >= (1 << 20)
+    in_place = dec <= full.numel() and not shrink
+    if in_place:
+        dspan = full[:dec]
+    else:
+        STATE["dev_full"][i] = None
+        del full
+        torch.cuda.synchronize(device)
+        torch.cuda.empty_cache()
+        with _tms().region(tag=TAG_WEIGHTS):
+            dspan = torch.empty(dec, dtype=torch.uint8, device=device)
+        STATE["dev_full"][i] = dspan
+        counts["grown"] += 1
+    if DEBUG:
+        _log(f"relayout layer {i} on {device}: span {STATE['spans'][i]} -> {span} bytes "
+             f"({'in place' if in_place else 'new span'}), free {torch.cuda.mem_get_info(device)[0] >> 20} MiB, "
+             f"torch reserved {torch.cuda.memory_reserved(device) >> 20} MiB")
+    dspan.copy_(host[:dec])
+    _point(layer, dspan, new, limit=dec)
+    if dec < span:
+        _pfonly_empty(layer, new, dec)
+        # the mirror is built from this copy (the span no longer holds it all)
+        STATE.setdefault("relayout_host", {})[i] = host.clone() if kt_pinned.ENABLED else host
+    STATE["dev_spans"][i] = dspan
+    STATE["layouts"][i] = new
+    STATE["spans"][i] = span
+    del host
+
+
+def after_module(module) -> None:
+    """The loader, after each module's weight processing: when that left a
+    lent layer's parameters outside its span (a repack makes new tensors),
+    take them back now, so the originals in the span and the repacked
+    copies do not pile up over the whole load (Vision-Exp with 12 Marlin hot
+    experts per layer ran out of memory that way)."""
+    if not ENABLED or STATE["phase"] != "load" or "dev_full" not in STATE:
+        return
+    i = getattr(module, "_kt_lend_layer", None)
+    if i is None:
+        return
+    full = STATE["dev_full"][i]
+    lo, hi = full.data_ptr(), full.data_ptr() + full.numel()
+    if all(lo <= q.data_ptr() < hi for n, q in STATE["layers"][i].named_parameters()
+           if _ready(q) and q.is_cuda and _nbytes(q) >= MIN_BYTES and not any(w in n for w in SKIP + PFONLY)):
+        return
+    _relayout(i, dict(owners=0, grown=0, moved=0, dropped=0, aliases=0))
+    STATE["counts"]["early"] += 1
+
+
+def after_load() -> None:
+    """After every module's weight processing, before the KV pool: take back
+    what the loading rebound, move fused owners into the spans, mirror,
+    release scratch."""
+    if not ENABLED or "dev_spans" not in STATE or STATE["phase"] != "load":
+        return
+    counts = STATE["counts"]
+    device = STATE["device"]
+    if DEBUG:
+        _log(f"after_load on {device} (current {torch.cuda.current_device()}): free "
+             f"{torch.cuda.mem_get_info(device)[0] >> 20} MiB, torch reserved {torch.cuda.memory_reserved(device) >> 20} MiB")
+    STATE["final"] = True
+    for i in range(len(STATE["layers"])):
+        _relayout(i, counts)
+    bases, total = [], 0
+    for span in STATE["spans"]:
+        bases.append(total)
+        total += span
+    # KT_FAST_PINNED=1: THP + cudaHostRegister (patches/sglang-kt-fast-load.py)
+    from sglang.srt.layers.moe import kt_pinned
+
+    host = kt_pinned.empty((total,), torch.uint8)
+    kept = STATE.pop("relayout_host", {})
+    for i, (base, span, dspan) in enumerate(zip(bases, STATE["spans"], STATE["dev_spans"])):
+        host[base:base + span].copy_(kept[i] if i in kept else dspan)
+    del kept
+    if PFONLY:
+        dec_total = sum(d.numel() for d in STATE["dev_spans"])
+        _log(f"prefill-only weights ({','.join(PFONLY)}): {(total - dec_total) / 1e9:.3f} GB kept out of the "
+             f"decode spans ({dec_total / 1e9:.3f} GB resident)")
+    STATE.update(host=host, bases=bases, nbytes=total,
+                 dec_nbytes=sum(d.numel() for d in STATE["dev_spans"]))
+    maxspan = max(STATE["spans"])
+    if STATE["slots"][0].numel() < maxspan:
+        STATE["slots"] = None
+        STATE["slots"] = [scratch_empty((maxspan,), torch.uint8, device) for _ in range(2)]
+    torch.cuda.synchronize(device)
+    torch.cuda.empty_cache()
+    _tms().pause(TAG_SCRATCH)
+    STATE["phase"] = "decode"
+    _log(f"weights {total / 1e9:.3f} GB mirrored ({counts['owners']} fused owners moved in, {counts['grown']} spans "
+         f"outgrown, {counts['moved']} parameters rebound or made by the loading taken in, {counts['aliases']} aliases, "
+         f"{counts['dropped']} gone, "
+         f"{counts['early']} layers taken back during the load"
+         + (f"; gone: {', '.join(sorted(counts['gone_names'])[:6])}" if counts.get("gone_names") else "")
+         + f"); scratch {STATE['scratch_bytes'] / 1e9:.3f} GB released "
+         f"until the first long prefill")
+
+
+# -- phase swap ------------------------------------------------------------------
+
+def _threshold() -> int:
+    """Rows from which a prefill does not need the resident MoE weights: the
+    KT streamer's KT_GPU_STREAM_PREFILL, or in a tree without the streamer
+    (GLM-5.3's) the full-GPU prefill's --kt-gpu-prefill-token-threshold."""
+    if "threshold" not in STATE:
+        try:
+            from sglang.srt.layers.moe.kt_stream_prefill import STREAM_THRESHOLD as t
+        except ImportError:
+            try:
+                from sglang.srt.server_args import get_global_server_args
+
+                t = int(getattr(get_global_server_args(), "kt_gpu_prefill_token_threshold", 0) or 0)
+            except Exception:
+                t = 0
+        STATE["threshold"] = t
+    return STATE["threshold"]
+
+
+def _streamed(forward_batch) -> bool:
+    """A forward that runs in the lend window: a streamed prefill, or an extend
+    over a long sequence (KT_PREFILL_LEND_LONG_SEQ)."""
+    t = _threshold()
+    if t <= 0 or not forward_batch.forward_mode.is_extend():
+        return False
+    if forward_batch.input_ids.shape[0] >= t:
+        return True
+    return LONG_SEQ > 0 and not IDLE and _seq_len(forward_batch) >= LONG_SEQ
+
+
+def _chunk() -> int:
+    try:
+        from sglang.srt.server_args import get_global_server_args
+
+        return int(get_global_server_args().chunked_prefill_size or 0)
+    except Exception:
+        return 0
+
+
+def _seq_len(forward_batch) -> int:
+    """The longest sequence in a forward, prompt so far included (CPU copy only)."""
+    lens = getattr(forward_batch, "seq_lens_cpu", None)
+    try:
+        return int(lens.max()) if lens is not None and len(lens) else 0
+    except Exception:
+        return 0
+
+
+def _write_hint(rank: int) -> None:
+    import json
+
+    rows = STATE.get("pf_rows", 0)
+    chunk = _chunk()
+    if not HINT or rows < 2048 or chunk <= 0:
+        return
+    growth = STATE["pf_peak"] - STATE["pf_base"]
+    per_tok = growth / rows + STATE["scratch_chunk_bytes"] / chunk
+    room = STATE["pf_free"] - growth - MARGIN
+    hint = chunk + int(room / per_tok) if per_tok > 0 else chunk
+    # the cost per token grows with the rows (Flash-Next 371 -> 417 KB from
+    # 14336 to 16384 rows), so a far extrapolation is too hopeful: at most
+    # twice the running chunk per launch, the next launch measures again
+    hint = min(hint, 2 * chunk)
+    # a window that never filled a chunk says nothing about a larger one (a
+    # 6K-token window on Vision-Exp hinted 22528 from chunk 16384; the full
+    # 16384 rows then left no room): it may only lower the chunk
+    keep_min = True
+    if rows < 4096:
+        # too few rows to say anything about the chunk; still a point below
+        hint = min(chunk, STATE.get("hint_min", chunk))
+        keep_min = False
+    elif rows < chunk and hint >= chunk:
+        # nothing learned about a larger chunk: keep the running one on record
+        # (a launcher needs a value: MiMo's SWA pool held every window of the
+        # calibration at 12.4K rows of 16384, and without a file it fell back
+        # to 2048), but out of hint_min, which would pin it there for good
+        # (10-06: Qwen3.5 TP=1 stayed at 23552 behind one 5.5K-token window)
+        hint = min(chunk, STATE.get("hint_min", chunk))
+        keep_min = False
+    # 1024 steps: whole pages for every model here (pages of 1 to 256), and 2048
+    # steps threw away up to 2047 rows (V4.1: 7,462 measured, 6,144 hinted)
+    hint = max(2048, min(32768, hint // 1024 * 1024))
+    # the free memory at a window's start wobbles: keep the smallest
+    hint = min(hint, STATE.get("hint_min", hint))
+    if keep_min:
+        STATE["hint_min"] = hint
+    rec = {"chunk": hint, "current_chunk": chunk, "rows_seen": rows,
+           "free_at_prefill_mb": STATE["pf_free"] >> 20, "peak_growth_mb": growth >> 20,
+           "margin_mb": MARGIN >> 20, "bytes_per_token": round(per_tok),
+           "scratch_chunk_mb": STATE["scratch_chunk_bytes"] >> 20,
+           # the longest sequence of the window, and the full KV pool the server
+           # got (kt_lend_swa_ratio sizes an SWA pool from it, not from the cap)
+           "seq_seen": STATE.get("pf_seq", 0), "full_tokens": STATE.get("full_tokens", 0)}
+    # the window as a point of the cost per row against the sequence length,
+    # merged with the points earlier launches of this setup left (one per
+    # power-of-two sequence bucket, the costlier kept): kt_lend_table builds
+    # the prefix -> chunk table of KT_PREFILL_LEND_DYNAMIC from them
+    path = f"{HINT}-rank{rank}.json"
+    points = STATE.get("points")
+    if points is None:
+        try:
+            with open(path) as f:
+                points = {int(k): v for k, v in json.load(f).get("points", {}).items()}
+        except Exception:
+            points = {}
+    seq = STATE.get("pf_seq", 0)
+    # a window of 2048 rows or more says what a row costs at this length (with
+    # the dynamic chunk a long prompt's windows are narrower than the launch
+    # chunk, and they are exactly the points the table lacks)
+    if seq > 0 and rows >= 2048:
+        bucket = seq.bit_length()
+        old = points.get(bucket)
+        if old is None or per_tok > old["per_row"]:
+            points[bucket] = {"seq": seq, "per_row": round(per_tok), "free": STATE["pf_free"],
+                              "rows": rows}
+    STATE["points"] = points
+    rec["points"] = points
+    with open(path, "w") as f:
+        json.dump(rec, f)
+    if STATE.get("hint_logged") != hint:
+        STATE["hint_logged"] = hint
+        _log(f"chunk hint {hint} (now {chunk}): {rows} rows peaked {growth / 1e9:.2f} GB above the "
+             f"prefill baseline with {STATE['pf_free'] / 1e9:.2f} GB free, {per_tok / 1e3:.0f} KB a token "
+             f"with the chunk-sized scratch, margin {MARGIN / 1e9:.2f} GB")
+
+
+def table_chunk(prefix: int, table: Optional[dict] = None) -> Optional[int]:
+    """The chunk for a request whose prompt has reached prefix tokens, from
+    KT_PREFILL_LEND_TABLE (built at launch by tools/kt-lend-auto.sh from the
+    points of every rank, so all ranks answer the same): the largest c with
+    c * cost(prefix + c) <= free - margin, cost per row interpolated between
+    the measured sequence lengths and, past the last one, taken to grow with
+    the sequence. None when there is no table."""
+    if table is None:
+        table = STATE.get("table")
+        if table is None:
+            import json
+
+            raw = os.environ.get("KT_PREFILL_LEND_TABLE", "")
+            try:
+                table = json.loads(raw) if raw else {}
+            except Exception:
+                table = {}
+            STATE["table"] = table
+    pts = sorted((p["seq"], p["per_row"]) for p in table.get("points", []))
+    if not pts:
+        return None
+    room = table["free"] - table.get("margin", MARGIN)
+    top, step = int(table["max"]), int(table.get("step", 1024))
+
+    def cost(s):
+        if s <= pts[0][0]:
+            return pts[0][1]
+        for (s0, c0), (s1, c1) in zip(pts, pts[1:]):
+            if s <= s1:
+                return c0 + (c1 - c0) * (s - s0) / max(1, s1 - s0)
+        # past the longest measured sequence: the cost per row is assumed to
+        # grow with the sequence (V4.1 doubled from 510K to 989K while it was
+        # flat from 38K to 510K), or along the last slope if that is steeper;
+        # a longer prompt adds its own point and loosens this
+        s1, c1 = pts[-1]
+        grown = c1 * s / s1
+        if len(pts) == 1:
+            return grown
+        s0, c0 = pts[-2]
+        return max(grown, c1 + max(0.0, (c1 - c0) / max(1, s1 - s0)) * (s - s1))
+
+    c = top
+    while c > 2048 and c * cost(prefix + c) > room:
+        c -= step
+    return max(2048, c)  # no narrower than the chunk without the lend
+
+
+def before_forward(forward_batch) -> None:
+    """Model runner, before every forward, outside any graph."""
+    if not ENABLED or STATE["phase"] == "load":
+        return
+    streamed = _streamed(forward_batch)
+    rows = forward_batch.input_ids.shape[0]
+    if streamed and STATE["phase"] == "prefill":
+        STATE["pf_rows"] = max(STATE.get("pf_rows", 0), rows)
+        seq = _seq_len(forward_batch)
+        STATE["pf_seq"] = max(STATE.get("pf_seq", 0), seq)
+        if LONG_SEQ > 0 and seq >= LONG_SEQ:
+            # Past a long prefix every chunk's prefix-sized buffers (page tables,
+            # the indexer's gathered K) are a little larger than the last one's,
+            # so the freed ones do not fit them and torch's cache fills with
+            # pieces: at a 999K-token prefix 5,624 MiB reserved for 2,927 MiB
+            # allocated (10-07). Hand the unused segments back before each chunk.
+            torch.cuda.empty_cache()
+    elif streamed and STATE["phase"] == "decode":
+        t = time.perf_counter()
+        dev = STATE["device"]
+        # free memory in decode, the KV pool and the graphs made: what is gone
+        # from it when the weights come back was left behind by this prefill
+        STATE["dec_free"] = torch.cuda.mem_get_info(dev)[0]
+        STATE.setdefault("dec_free0", STATE["dec_free"])
+        if DEBUG and not STATE.get("history"):
+            torch.cuda.memory._record_memory_history(max_entries=500000)
+            STATE["history"] = True
+        _tms().pause(TAG_WEIGHTS)
+        _tms().resume(TAG_SCRATCH)
+        torch.cuda.synchronize(dev)
+        # what decode freed (the last prefill's attention metadata, released at
+        # the first graph replay) sits in torch's cache, which mem_get_info
+        # counts as used: hand it back so the free memory measured is real
+        torch.cuda.empty_cache()
+        STATE["pf_free"] = torch.cuda.mem_get_info(dev)[0]
+        STATE["pf_base"] = torch.cuda.memory_reserved(dev)
+        if DEBUG:
+            # what the device holds outside torch (graphs, modules, NCCL) is
+            # total - free - reserved; a rise across windows is not torch's
+            total = torch.cuda.mem_get_info(dev)[1]
+            _log(f"prefill window {STATE['to_prefill'] + 1} start on {dev}: free {STATE['pf_free'] >> 20} MiB, "
+                 f"torch reserved {STATE['pf_base'] >> 20} MiB, allocated "
+                 f"{torch.cuda.memory_allocated(dev) >> 20} MiB, outside torch "
+                 f"{(total - STATE['pf_free'] - STATE['pf_base']) >> 20} MiB")
+        torch.cuda.reset_peak_memory_stats(dev)
+        STATE["pf_outside"] = torch.cuda.mem_get_info(dev)[1] - STATE["pf_free"] - STATE["pf_base"]
+        STATE["pf_abase"] = torch.cuda.memory_allocated(dev)
+        if "full_tokens" not in STATE:
+            # the full KV pool the server got, from the ModelRunner that calls
+            # this (no tree here puts the pool on the batch, and the attention
+            # backends differ): max_total_num_tokens after memory profiling
+            try:
+                import inspect
+
+                runner = inspect.currentframe().f_back.f_locals.get("self")
+                STATE["full_tokens"] = int(getattr(runner, "max_total_num_tokens", 0) or 0)
+            except Exception:
+                STATE["full_tokens"] = 0
+        STATE.update(phase="prefill", pf_issued=set(), pf_rows=rows, pf_seq=_seq_len(forward_batch))
+        STATE["to_prefill"] += 1
+        if STATE["to_prefill"] in (1, 10, 100, 1000):
+            _log(f"to prefill in {(time.perf_counter() - t) * 1e3:.1f} ms ({STATE['to_prefill']} so far)")
+    elif not streamed and STATE["phase"] == "prefill":
+        end_window()
+
+
+def end_window() -> None:
+    """Close a prefill window: record it, bring the weights back. The model
+    runner does this before the first forward after a prefill; the probe
+    (kt_lend_probe.py) calls it after each of its forwards."""
+    if not ENABLED or STATE["phase"] != "prefill":
+        return
+    if True:
+        t = time.perf_counter()
+        dev = STATE["device"]
+        STATE["pf_peak"] = torch.cuda.max_memory_reserved(dev)
+        if DEBUG:
+            # one line a window for fitting the growth to rows and sequence
+            # length; "outside torch" is how much more the device held outside
+            # torch's allocator at the end than at the start (NCCL, cuBLAS,
+            # graphs; a transient that is gone by the end does not show)
+            free_now, total = torch.cuda.mem_get_info(dev)
+            outside = total - free_now - torch.cuda.memory_reserved(dev)
+            _log(f"prefill window {STATE['to_prefill']} on {dev}: rows {STATE.get('pf_rows', 0)}, "
+                 f"seq {STATE.get('pf_seq', 0)}, peak growth "
+                 f"{(STATE['pf_peak'] - STATE['pf_base']) >> 20} MiB of {STATE['pf_free'] >> 20} MiB free "
+                 f"(allocated {(torch.cuda.max_memory_allocated(dev) - STATE.get('pf_abase', 0)) >> 20} MiB), "
+                 f"outside torch {(outside - STATE['pf_outside']) >> 20:+d} MiB, full pool "
+                 f"{STATE.get('full_tokens', 0)}")
+        try:
+            from sglang.srt.distributed import get_tensor_model_parallel_rank
+
+            rank = get_tensor_model_parallel_rank()
+        except Exception:
+            rank = dev.index
+        _write_hint(rank)
+        _leave()
+        torch.cuda.empty_cache()
+        _tms().pause(TAG_SCRATCH)
+        _check_room(dev)
+        _tms().resume(TAG_WEIGHTS)
+        for base, span, dspan in zip(STATE["bases"], STATE["spans"], STATE["dev_spans"]):
+            dspan.copy_(STATE["host"][base:base + dspan.numel()], non_blocking=True)
+        STATE["phase"] = "decode"
+        STATE["to_decode"] += 1
+        if STATE["to_decode"] in (1, 10, 100, 1000):
+            _log(f"to decode in {(time.perf_counter() - t) * 1e3:.1f} ms, copy queued "
+                 f"({STATE['to_decode']} so far)")
+
+
+def _check_room(dev) -> None:
+    """Before the weights come back: what the prefill left outside the lend
+    scratch is room they no longer have. Say how much, and stop with a reason
+    instead of torch_memory_saver failing to map them (a process abort)."""
+    free = torch.cuda.mem_get_info(dev)[0]
+    back = STATE.get("dec_nbytes", STATE["nbytes"])  # the decode spans (prefill-only weights stay out)
+    need = back + len(STATE["spans"]) * (2 << 20)  # mapped in 2 MiB granules
+    left = STATE["dec_free"] + back - free  # kept from this prefill window
+    total = STATE["dec_free0"] + back - free  # since the first window
+    if DEBUG and (left > 256 << 20 or total > 384 << 20) and not STATE.get("dumped"):
+        path = f"/tmp/kt-lend-kept-{dev.index}-w{STATE['to_decode'] + 1}.pickle"
+        torch.cuda.memory._dump_snapshot(path)
+        STATE["dumped"] = True
+        _log(f"memory snapshot {path}")
+    # DEBUG: every window, so a slow pile-up under 64 MB a window shows too
+    if left > 64 << 20 or DEBUG:
+        _log(f"prefill window {STATE['to_decode'] + 1} on {dev} kept {left / 1e9:.2f} GB outside the lend "
+             f"scratch ({total / 1e9:.2f} GB since the first; the weights need {need / 1e9:.2f} GB, "
+             f"{free / 1e9:.2f} GB free)")
+    if free < need:
+        raise RuntimeError(
+            f"KT_PREFILL_LEND: the weights ({need / 1e9:.2f} GB) cannot come back on {dev}: "
+            f"{free / 1e9:.2f} GB free, {left / 1e9:.2f} GB was allocated during prefill outside the "
+            f"lend scratch and kept. Fewer GPU experts or a smaller KV pool leaves the room.")
+
+
+# -- per-layer streaming ---------------------------------------------------------
+
+def _prefetch(i: int) -> None:
+    if i >= len(STATE["spans"]) or i in STATE["pf_issued"]:
+        return
+    k = i % 2
+    base, span = STATE["bases"][i], STATE["spans"][i]
+    cs = STATE["pf_stream"]
+    with torch.cuda.stream(cs):
+        if STATE["pf_done"][k] is not None:
+            cs.wait_event(STATE["pf_done"][k])
+        n = STATE.get("active", {}).get(i, span)  # the idle tail stays out
+        STATE["slots"][k][:n].copy_(STATE["host"][base:base + n], non_blocking=True)
+        STATE["pf_ready"][k].record(cs)
+    STATE["pf_issued"].add(i)
+
+
+def _enter_hook(module, args):
+    _enter(module._kt_lend_idx)
+    return None
+
+
+def _enter(i: int) -> None:
+    """Layer i is about to run in a prefill: the previous layer goes back to
+    its span (its slot is free once the compute stream gets here), layer i
+    to its slot, layer i+1's copy starts."""
+    if STATE["phase"] != "prefill" or STATE.get("pf_cur") == i:
+        return
+    dev = STATE["device"]
+    if "pf_stream" not in STATE:
+        STATE["pf_stream"] = torch.cuda.Stream(device=dev)
+        STATE["pf_ready"] = [torch.cuda.Event(), torch.cuda.Event()]
+        STATE["pf_done"] = [None, None]
+    cur = torch.cuda.current_stream(dev)
+    prev = STATE.get("pf_cur")
+    if prev is not None:
+        _point_back(prev)
+        ev = torch.cuda.Event()
+        ev.record(cur)
+        STATE["pf_done"][prev % 2] = ev
+    if prev is None or i <= prev:
+        STATE["pf_issued"] = set()  # a new forward
+    if i not in STATE["pf_issued"]:
+        # nothing prefetched: the side stream must see the compute stream's past
+        STATE["pf_stream"].wait_stream(cur)
+        _prefetch(i)
+    cur.wait_event(STATE["pf_ready"][i % 2])
+    _point(STATE["layers"][i], STATE["slots"][i % 2], STATE["layouts"][i],
+           limit=STATE.get("active", {}).get(i))
+    STATE["pf_cur"] = i
+    _prefetch(i + 1)
+
+
+def _leave() -> None:
+    i = STATE.pop("pf_cur", None)
+    if i is not None:
+        _point_back(i)
diff --git a/python/sglang/srt/layers/moe/kt_mem_snapshot.py b/python/sglang/srt/layers/moe/kt_mem_snapshot.py
new file mode 100644
index 0000000..70b56e5
--- /dev/null
+++ b/python/sglang/srt/layers/moe/kt_mem_snapshot.py
@@ -0,0 +1,99 @@
+"""VRAM instruments for the KT serves (debug only; nothing changes without the variables).
+
+KT_MEM_SNAPSHOT=<prefix>: from the first ModelRunner.initialize on, the CUDA caching allocator records its
+history with Python stacks (torch.cuda.memory._record_memory_history). Each time the file <prefix>.trigger gets a
+new content (a label, e.g. "up" or "after35k"), every process of the serve writes
+<prefix>-<pid>-<label>.pickle (torch.cuda.memory._dump_snapshot) and logs "[kt-mem-snapshot] wrote ...".
+Read the pickles with tools/mem-snapshot-owners.py. Allocations outside torch's allocator (the CUDA context,
+NCCL, cuBLAS workspaces, kt-kernel's own cudaMalloc) are not in them: compare with nvidia-smi.
+KT_MEM_SNAPSHOT_ENTRIES (default 1,000,000) bounds the recorded alloc/free events.
+
+vram_dump(model, tag, gpu_id) (SGL_VRAM_DUMP=1, called at the end of ModelRunner.load_model): the CUDA tensors
+reachable from the model, grouped by module path, against torch's allocated / reserved and the free memory, in
+/tmp/vram-dump-<tag>-<pid>.txt.
+"""
+
+import os
+import re
+import threading
+import time
+
+import torch
+
+_started = False
+
+
+def start():
+    global _started
+    prefix = os.environ.get("KT_MEM_SNAPSHOT")
+    if not prefix or _started:
+        return
+    _started = True
+    torch.cuda.memory._record_memory_history(
+        enabled="all", context="all", stacks="python",
+        max_entries=int(os.environ.get("KT_MEM_SNAPSHOT_ENTRIES", "1000000")))
+    trig = prefix + ".trigger"
+
+    def loop():
+        last = None
+        if os.path.exists(trig):  # a trigger left from before this process: not a request
+            try:
+                last = open(trig).read().strip()
+            except OSError:
+                pass
+        while True:
+            time.sleep(1.0)
+            try:
+                label = open(trig).read().strip()
+            except OSError:
+                continue
+            if not label or label == last:
+                continue
+            last = label
+            path = f"{prefix}-{os.getpid()}-{label}.pickle"
+            torch.cuda.memory._dump_snapshot(path)
+            print(f"[kt-mem-snapshot] wrote {path}", flush=True)
+
+    threading.Thread(target=loop, daemon=True, name="kt-mem-snapshot").start()
+    print(f"[kt-mem-snapshot] recording, pid {os.getpid()}, trigger {trig}", flush=True)
+
+
+def vram_dump(model, tag, gpu_id):
+    seen, groups = set(), {}
+
+    def add(path, t):
+        if not isinstance(t, torch.Tensor) or not t.is_cuda:
+            return
+        key = (t.data_ptr(), t.numel(), t.dtype)
+        if key in seen:
+            return
+        seen.add(key)
+        g = re.sub(r"\.\d+\.", ".N.", path)
+        n, b, d = groups.get(g, (0, 0, set()))
+        d.add(str(t.dtype).replace("torch.", ""))
+        groups[g] = (n + 1, b + t.numel() * t.element_size(), d)
+
+    for mname, m in model.named_modules():
+        for k, v in list(m._parameters.items()) + list(m._buffers.items()):
+            add(f"{mname}.{k}", v)
+        for k, v in vars(m).items():
+            if k.startswith("_"):
+                continue
+            if isinstance(v, torch.Tensor):
+                add(f"{mname}.{k}", v)
+            elif isinstance(v, (list, tuple)):
+                for x in v:
+                    add(f"{mname}.{k}[]", x)
+            elif isinstance(v, dict):
+                for x in v.values():
+                    add(f"{mname}.{k}{{}}", x)
+    free, total = torch.cuda.mem_get_info(gpu_id)
+    lines = [
+        f"tag={tag} allocated={torch.cuda.memory_allocated(gpu_id) / 2**20:.1f} MiB "
+        f"reserved={torch.cuda.memory_reserved(gpu_id) / 2**20:.1f} MiB free={free / 2**20:.1f} MiB "
+        f"total={total / 2**20:.1f} MiB reachable={sum(b for _, b, _ in groups.values()) / 2**20:.1f} MiB"
+    ]
+    for g, (n, b, d) in sorted(groups.items(), key=lambda x: -x[1][1]):
+        lines.append(f"{b / 2**20:10.1f} MiB  x{n:<5d} {g}  {sorted(d)}")
+    with open(f"/tmp/vram-dump-{tag}-{os.getpid()}.txt", "w") as f:
+        f.write("\n".join(lines) + "\n")
diff --git a/python/sglang/srt/layers/moe/kt_mtp_gguf.py b/python/sglang/srt/layers/moe/kt_mtp_gguf.py
new file mode 100644
index 0000000..45e1a0b
--- /dev/null
+++ b/python/sglang/srt/layers/moe/kt_mtp_gguf.py
@@ -0,0 +1,226 @@
+"""The MTP draft's routed experts from Strata's MTP GGUF (KT_MTP_GGUF=<gguf>),
+all of them on the GPU.
+
+Strata's mtp-q2_0.gguf keeps the experts in Q2_0 with the checkpoint's fused
+layout: experts.gate_up_proj [E, 2I, H] (gate rows, then up rows) and
+experts.down_proj [E, H, I]. Q2_0 has no CUDA kernel, so both are repacked
+losslessly to Q8_0 (kt_gguf_hot.q2_0_to_q8_0: same fp16 scale, codes -1..2 as
+int8) and sliced to this rank's TP part: rows N*r..N*(r+1) of gate and of up,
+the down's quant blocks covering columns N*r..N*(r+1). Then the hot-expert
+method's kernels run them: the multi-token GEMV for windows of up to 4 tokens
+(decode, MTP), sglang's GGUF MoE (MMQ) for the draft's longer extends.
+
+KT_MTP_Q2_0=1 keeps the experts in Q2_0 instead (675 MiB against 2.49 GiB of
+Q8_0 at TP1, the draft VRAM Strata has): windows of up to 4 tokens run the
+multi-token GEMV's own Q2_0 kernel (type 42), every longer window runs
+llama.cpp's int8-mma MoE MMQ (kt_gguf_moe_mmq.py, built from our SGLang branch
+perf/gguf-mmq-q2_0) for gate/up and for down. That path never calls
+sgl-kernel's dp4a ggml_moe_a8, whose kernel returns early for expert ids > 255
+(moe.cuh:52): with the Q8_0 layout a draft extend above 64 tokens leaves the
+rows routed to experts 256..511 unwritten. Both weights get ggml's row padding
+after their last row (zeros: 108 bytes for the down at K = 640, 54 at the TP2
+rank's K = 320); the rows themselves stay packed, so the GEMV's expert and row
+strides do not change.
+
+Installed next to kt_gguf_hot.py; FusedMoE picks it for "mtp." layers when
+KT_MTP_GGUF is set (sglang-kt-mtp-gguf.py).
+"""
+import os
+import tempfile
+import time
+
+import torch
+from torch.nn import Parameter
+
+# sgl-kernel's MoE tile height for Q8_0 on CUDA (MOE_X_Q8_0 in moe.cuh)
+MOE_X_Q8_0 = 4
+
+from sglang.srt.layers.moe.kt_gguf_hot import (
+    GGML_Q2_0,
+    GGML_Q8_0,
+    KTGGUFHotExpertsMethod,
+    _log,
+    _row_bytes,
+    q2_0_to_q8_0,
+)
+
+
+def _multi_max():
+    from sglang.srt.layers.moe import kt_gguf_moe_multi as _multi
+
+    return _multi.MAX_TOKENS if _multi.enabled() else 0
+
+
+def _raw_exact(loader, name):
+    """Raw bytes and ggml type of a tensor by its exact name: the loader maps
+    PyTorch names to llama.cpp ones, and Strata's GGUF keeps checkpoint names."""
+    import kt_kernel.utils.loader as KL
+
+    translate = KL.translate_name_to_gguf
+    KL.translate_name_to_gguf = lambda n: n
+    try:
+        return loader.get_undequanted_tensor_and_ggml_type(name)
+    finally:
+        KL.translate_name_to_gguf = translate
+
+
+class _MTPExperts:
+    def __init__(self, path: str):
+        from kt_kernel.utils.loader import GGUFLoader
+
+        d = tempfile.mkdtemp()  # the loader reads a directory
+        os.symlink(os.path.abspath(path), os.path.join(d, os.path.basename(path)))
+        self.loader = GGUFLoader(d)
+        names = [n for n in self.loader.tensor_info if ".mlp.experts." in n]
+        self.gate_up = next(n for n in names if n.endswith("gate_up_proj"))
+        self.down = next(n for n in names if n.endswith("down_proj"))
+        E, I2, H = (int(x) for x in self.loader.tensor_info[self.gate_up]["shape"])
+        self.E, self.inter, self.K = E, I2 // 2, H
+
+    def raw(self, name: str):
+        data, t = _raw_exact(self.loader, name)
+        return data, int(t)
+
+
+class KTGGUFMTPExpertsMethod(KTGGUFHotExpertsMethod):
+    """Every routed expert of the MTP layer on the GPU, from Strata's MTP GGUF."""
+
+    streams_hot_experts = False
+
+    def __init__(self, path: str, layer):
+        self.reader = _MTPExperts(path)
+        self.rank, self.world = layer.moe_tp_rank, layer.moe_tp_size
+        _, t13 = self.reader.raw(self.reader.gate_up)
+        _, t2 = self.reader.raw(self.reader.down)
+        self.types = (t13, t13, t2)
+        # KT_MTP_Q2_0=1: the Q2_0 experts stay Q2_0 (multi-token GEMV <= 4
+        # tokens, llama.cpp's MoE MMQ above); otherwise the Q8_0 repack
+        self.q2 = os.environ.get("KT_MTP_Q2_0", "0") == "1" and t13 == GGML_Q2_0 and t2 == GGML_Q2_0
+        self.type13 = GGML_Q8_0 if t13 == GGML_Q2_0 and not self.q2 else t13
+        self.type2 = GGML_Q8_0 if t2 == GGML_Q2_0 and not self.q2 else t2
+        self.mmq_chunk = int(os.environ.get("KT_MTP_MMQ_CHUNK", "2048"))
+        self.num_gpu_experts = self.reader.E
+        self.moe_runner_config = None
+        self.kt_config = None
+
+    def create_weights(self, layer, num_experts, hidden_size, intermediate_size_per_partition, params_dtype,
+                       **extra_weight_attrs):
+        E, N, K = num_experts, intermediate_size_per_partition, hidden_size
+        if E != self.reader.E or N * self.world != self.reader.inter or K != self.reader.K:
+            raise RuntimeError(f"MTP GGUF experts {self.reader.E}x{self.reader.inter}x{self.reader.K} "
+                               f"vs layer {E}x{N}x{self.world}/{K}")
+        self.N, self.K = N, K
+        dev = torch.device("cuda", torch.cuda.current_device())
+        if self.q2:
+            from sglang.srt.layers.moe import kt_gguf_moe_mmq as _mmq
+
+            # packed rows, then ggml's row padding (zeros) after the last row of
+            # the last expert: the MMQ kernel reads up to K_padded values a row
+            w13 = Parameter(self._padded((E, 2 * N, _row_bytes(K, self.type13)), _mmq.tail_bytes(self.type13, K), dev),
+                            requires_grad=False)
+            w2 = Parameter(self._padded((E, K, _row_bytes(N, self.type2)), _mmq.tail_bytes(self.type2, N), dev),
+                           requires_grad=False)
+        else:
+            w13 = Parameter(torch.empty((E, 2 * N, _row_bytes(K, self.type13)), dtype=torch.uint8, device=dev),
+                            requires_grad=False)
+            w2 = Parameter(torch.empty((E, K, _row_bytes(N, self.type2)), dtype=torch.uint8, device=dev),
+                           requires_grad=False)
+        w13.weight_loader = w2.weight_loader = self._refuse_loader
+        layer.register_parameter("w13_qweight", w13)
+        layer.register_parameter("w2_qweight", w2)
+
+    @staticmethod
+    def _padded(shape, tail: int, dev) -> torch.Tensor:
+        n = shape[0] * shape[1] * shape[2]
+        buf = torch.empty(n + tail, dtype=torch.uint8, device=dev)
+        buf[n:].zero_()
+        return buf[:n].view(shape)
+
+    def process_weights_after_loading(self, layer) -> None:
+        from sglang.srt.layers.moe.kt_gguf_dequant import BLOCK_INFO
+
+        t0 = time.time()
+        E, N, K, r = self.reader.E, self.N, self.K, self.rank
+        data, t13 = self.reader.raw(self.reader.gate_up)
+        blck, ts = BLOCK_INFO[t13]
+        gu = data.view(E, 2 * self.reader.inter, (K // blck) * ts)
+        I = self.reader.inter
+        w13 = torch.cat([gu[:, N * r:N * (r + 1)], gu[:, I + N * r:I + N * (r + 1)]], dim=1).contiguous()
+        if t13 == GGML_Q2_0 and self.type13 == GGML_Q8_0:
+            w13 = q2_0_to_q8_0(w13)
+        data, t2 = self.reader.raw(self.reader.down)
+        blck, ts = BLOCK_INFO[t2]
+        dn = data.view(E, K, I // blck, ts)[:, :, (N * r) // blck:(N * (r + 1)) // blck, :].reshape(E, K, -1).contiguous()
+        if t2 == GGML_Q2_0 and self.type2 == GGML_Q8_0:
+            dn = q2_0_to_q8_0(dn)
+        assert tuple(w13.shape) == tuple(layer.w13_qweight.shape), (w13.shape, layer.w13_qweight.shape)
+        assert tuple(dn.shape) == tuple(layer.w2_qweight.shape), (dn.shape, layer.w2_qweight.shape)
+        layer.w13_qweight.data.copy_(w13)
+        layer.w2_qweight.data.copy_(dn)
+        nbytes = layer.w13_qweight.untyped_storage().nbytes() + layer.w2_qweight.untyped_storage().nbytes()
+        mb = nbytes / 1e6
+        _log(f"rank {r}: MTP draft experts from {os.path.basename(self.reader.gate_up)} GGUF types {self.types} -> "
+             f"({self.type13}, {self.type2}), {E} experts, {mb:.0f} MB ({nbytes / 2**20:.1f} MiB) on the GPU, "
+             f"extend > {_multi_max()} tokens: {'llama.cpp MoE MMQ' if self.q2 else 'sgl-kernel MMVQ / dp4a MMQ'}, "
+             f"{time.time() - t0:.1f} s")
+
+    def apply(self, layer, dispatch_output):
+        from sglang.srt.layers.moe import kt_gguf_moe_multi as _multi
+
+        x = dispatch_output.hidden_states
+        topk_weights, topk_ids, _ = dispatch_output.topk_output
+        if x.shape[0] <= _multi.MAX_TOKENS and _multi.enabled():
+            return super().apply(layer, dispatch_output)
+        if self.q2:
+            return self._apply_mmq(layer, x, topk_weights, topk_ids)
+        # the draft's extend over a prompt: the MMQ branch of sglang's
+        # fused_moe_gguf, with the tile height passed in (ggml_moe_get_block_size
+        # takes no tensor, so torch cannot dispatch it to the CUDA build that
+        # registers it); 5..64 tokens keep the per-route kernel as sglang does
+        from sgl_kernel import ggml_moe_a8, ggml_moe_a8_vec, moe_sum, silu_and_mul
+
+        # sglang's wrapper (sgl_kernel's op takes its output buffers; gguf.py's
+        # fused_moe_gguf calls that one with three arguments and fails too)
+        from sglang.srt.layers.moe.moe_runner.triton_utils.moe_align_block_size import moe_align_block_size
+        from sglang.srt.layers.moe.token_dispatcher import StandardCombineInput
+
+        T, top_k = topk_ids.shape
+        ids = topk_ids.to(torch.int32)
+        w13, w2 = layer.w13_qweight, layer.w2_qweight
+        if T > 64 and self.type13 == GGML_Q8_0 and self.type2 == GGML_Q8_0:
+            E, N2, _ = w13.shape
+            sorted_ids, expert_ids, n_post = moe_align_block_size(ids, MOE_X_Q8_0, E)
+            h = silu_and_mul(ggml_moe_a8(x, w13, sorted_ids, expert_ids, n_post, self.type13, N2, top_k, T))
+            out = ggml_moe_a8(h, w2, sorted_ids, expert_ids, n_post, self.type2, w2.shape[1], 1, T * top_k)
+        else:
+            h = silu_and_mul(ggml_moe_a8_vec(x, w13, ids, top_k, self.type13, w13.shape[1], T))
+            out = ggml_moe_a8_vec(h, w2, ids, 1, self.type2, w2.shape[1], T * top_k)
+        out = out.reshape(T, top_k, w2.shape[1]).mul_(topk_weights.view(T, top_k, 1).to(out.dtype))
+        result = torch.empty_like(x)
+        moe_sum(out, result)
+        return StandardCombineInput(hidden_states=result)
+
+    def _apply_mmq(self, layer, x, topk_weights, topk_ids):
+        """The draft's extend over a prompt with the Q2_0 experts: llama.cpp's
+        MoE MMQ for gate/up and for down (fp32 out), SiLU-and-mul, the top-k
+        weighted sum as one bmm. KT_MTP_MMQ_CHUNK tokens per pass (2048) bound
+        the fp32 intermediates (at 2048 tokens x top-10: 105 MB gate/up, 210 MB
+        down) for chunked prefills of 8192 or 16384."""
+        from sgl_kernel import silu_and_mul
+
+        from sglang.srt.layers.moe import kt_gguf_moe_mmq as _mmq
+        from sglang.srt.layers.moe.token_dispatcher import StandardCombineInput
+
+        T, top_k = topk_ids.shape
+        w13, w2 = layer.w13_qweight, layer.w2_qweight
+        result = torch.empty_like(x)
+        step = self.mmq_chunk if self.mmq_chunk > 0 else T
+        for c0 in range(0, T, step):
+            c1 = min(T, c0 + step)
+            n = c1 - c0
+            ids = topk_ids[c0:c1]
+            h = _mmq.moe_mmq(x[c0:c1], w13, ids, self.type13, 2 * self.N, False)
+            h = silu_and_mul(h.view(n * top_k, 2 * self.N))
+            out = _mmq.moe_mmq(h, w2, ids, self.type2, self.K, True)
+            result[c0:c1] = torch.bmm(topk_weights[c0:c1].view(n, 1, top_k).float(), out).view(n, self.K)
+        return StandardCombineInput(hidden_states=result)
