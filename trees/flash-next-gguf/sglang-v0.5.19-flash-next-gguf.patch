@@ -0,0 +1,77 @@
+"""The MTP draft's lm_head reduced to a token list, for a GGUF target head under TP (KT_DRAFT_HOT).
+
+The draft (NEXTN, one step) shared the target's Q6_K lm_head: ~260 MB per rank
+read for every pass's draft extend (380 us of a ~14 ms pass). The draft only
+needs its argmax, and sglang verifies with the target alone, so the draft's
+vocabulary can be cut to the tokens the serve writes (tools/make-draft-hot-tokens.py)
+without changing the output distribution; a token outside the list can no
+longer be proposed (lower accept, measured).
+
+sglang's FR-Spec path (`--speculative-token-map`) indexes the draft head with
+global ids and puts the rows into the draft's own bf16 head: wrong under a
+vocab-parallel head and for GGUF bytes. Here each rank keeps the listed ids of
+its own vocab shard, padded to the same count on every rank with its lowest
+unlisted ids, and the draft gets a copy of the target's GGUF head module whose
+qweight is those rows (raw blocks, a row is self-contained). The gathered logits
+come out in rank order, so hot_token_id is the ranks' lists concatenated.
+
+build(target_lm_head, path) -> (head module, hot_token_id on the head's device), or None.
+"""
+import copy
+import os
+
+import torch
+from torch.nn import Parameter
+
+PATH = os.environ.get("KT_DRAFT_HOT")
+
+
+def _log(msg):
+    print(f"[kt-draft-hot] {msg}", flush=True)
+
+
+def build(lm_head, path=PATH):
+    if not path or lm_head is None or not hasattr(lm_head, "qweight") or not hasattr(lm_head, "shard_indices"):
+        return None
+    q = lm_head.qweight
+    if getattr(q, "shard_id", None):
+        return None
+    ids = torch.tensor(sorted(set(int(i) for i in torch.load(path, weights_only=True))), dtype=torch.int64)
+    tp = int(getattr(lm_head, "tp_size", 1))
+    per = int(lm_head.num_embeddings_per_partition)
+    vocab = int(lm_head.org_vocab_size)
+    lists = []
+    for r in range(tp):
+        lo, hi = r * per, min((r + 1) * per, vocab)
+        lists.append(ids[(ids >= lo) & (ids < hi)])
+    n = max(len(x) for x in lists)
+    for r in range(tp):
+        lo, hi = r * per, min((r + 1) * per, vocab)
+        if len(lists[r]) < n:
+            have = set(lists[r].tolist())
+            extra = [i for i in range(lo, hi) if i not in have][: n - len(lists[r])]
+            lists[r] = torch.tensor(sorted(have | set(extra)), dtype=torch.int64)
+    start = int(lm_head.shard_indices.org_vocab_start_index)
+    if start % per:
+        _log(f"vocab shard start {start} is not a multiple of {per}: not reducing")
+        return None
+    rank = start // per
+    local = (lists[rank] - rank * per).to(q.device)
+    head = copy.copy(lm_head)
+    head._parameters = dict(lm_head._parameters)
+    sub = Parameter(q.data.index_select(0, local).contiguous(), requires_grad=False)
+    for k, v in vars(q).items():
+        if k not in ("data",):
+            try:
+                setattr(sub, k, v)
+            except Exception:
+                pass
+    shape = getattr(q, "tensor_shape", None)
+    if shape is not None:
+        sub.tensor_shape = (n, shape[1])
+    head._parameters["qweight"] = sub
+    head.num_embeddings_per_partition = n
+    hot = torch.cat(lists).to(q.device)
+    _log(f"rank {rank}: {len(ids)} listed tokens -> {n} rows per rank ({tp} ranks, {len(hot)} draft logits), "
+         f"{sub.numel() / 1e6:.1f} MB of head rows instead of {q.numel() / 1e6:.1f} MB")
+    return head, hot
