+            f = gguf.quants.dequantize(rows, qt).reshape(shape)
+        out = torch.from_numpy(f).to(torch.bfloat16)
+        _dequant_cache_put(raw, qt, shape, out)
+        return out
+
+    # -- names --------------------------------------------------------------
+
+    def hf_name(self, gguf_name: str):
