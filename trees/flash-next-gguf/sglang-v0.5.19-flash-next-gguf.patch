+        layer, key = int(m.group(1)), m.group(2)
+        if key.endswith("_exps") or key == "per_layer_token_embd":
+            return None, layer, key
+        if key in ("indexer.q_proj", "indexer.k_proj"):
+            return f"model.language_model.layers.{layer}.self_attn.indexer.index_qk_proj.weight", layer, key
+        if key not in _LAYER:
+            raise KeyError(f"no HF name for GGUF tensor {gguf_name}")
+        return f"model.language_model.layers.{layer}.{_LAYER[key]}", layer, key
+
+    # -- inverse transforms -------------------------------------------------
+
+    def _undo(self, key: str, t: torch.Tensor) -> torch.Tensor:
+        if key in _PLUS_ONE:
+            return (t.float() - 1.0).to(t.dtype)
+        if key == "ssm_a":  # -exp(A_log) -> A_log, tiled -> grouped
+            return torch.log(-t.float())[self._row_perm_1]
+        if key == "ssm_dt.bias":
+            return t[self._row_perm_1]
+        if key == "ssm_conv1d":  # [C, k] squeezed, V channels tiled -> [C, 1, k], grouped
+            qk = 2 * self.n_k * self.dk
+            v = t[qk:]
+            return torch.cat([t[:qk], v[self._row_perm_v]], 0).unsqueeze(1)
+        if key == "ple_conv1d":
+            return t.unsqueeze(1)
+        if key == "ffn_gate_inp_shexp":  # the checkpoint keeps the shared-expert gate as [1, hidden]
+            return t.reshape(1, -1)
+        if key == "attn_qkv":
+            q_dim = k_dim = self.n_k * self.dk
+            v = t[q_dim + k_dim:]
+            return torch.cat([t[:q_dim + k_dim], v[self._row_perm_v]], 0)
+        if key == "attn_gate":
+            return t[self._row_perm_v]
+        if key in ("ssm_alpha", "ssm_beta"):
+            return t[self._row_perm_1]
+        if key == "ssm_out":
+            return t[:, self._row_perm_v]
+        return t
+
+    # -- iteration ------------------------------------------------------------
+
+    def names(self):
+        return sorted(n for n in self.loader.tensor_info if self.hf_name(n)[0] is not None)
+
+    def __iter__(self) -> Iterator[Tuple[str, torch.Tensor]]:
+        pending_indexer: Dict[int, Dict[str, torch.Tensor]] = {}
+        for n, t in self._fetched(self.names(), self.tensor):
+            hf, layer, key = self.hf_name(n)
+            if key in ("indexer.q_proj", "indexer.k_proj"):
+                d = pending_indexer.setdefault(layer, {})
+                d[key] = t
+                if len(d) == 2:
+                    q, k = d["indexer.q_proj"], d["indexer.k_proj"]
+                    assert q.shape[0] == self.indexer_q, (q.shape, self.indexer_q)
+                    yield hf, torch.cat([q, k], 0)
+                    del pending_indexer[layer]
+                continue
+            yield hf, self._undo(key, t)
+        assert not pending_indexer, f"unpaired indexer projections in layers {sorted(pending_indexer)}"
+
+    # -- PLE table ------------------------------------------------------------
+
+    PLE_TABLE = "per_layer_token_embd.weight"
+
+    def ple_layers(self):
+        """Layers that own a PLE block (blk.L.ple_conv1d) — one in Flash-Next."""
+        return sorted(int(m.group(1)) for n in self.loader.tensor_info
+                      for m in [re.match(r"blk\.(\d+)\.ple_conv1d\.weight$", n)] if m)
+
+    def ple_rows(self) -> Tuple[torch.Tensor, int]:
+        """The IQ4_NL table as raw rows: a uint8 view [V, dim // 32 * 18] over the
+        file mapping (nothing is read until a row is copied), and dim."""
+        info = self.loader.tensor_info[self.PLE_TABLE]
+        qt = GGMLQuantizationType(int(info["dtype"]))
+        if qt != GGMLQuantizationType.IQ4_NL:
+            raise NotImplementedError(f"PLE table is {qt.name}; only IQ4_NL rows are served")
+        rows, dim = (int(s) for s in info["shape"])
+        assert dim % 32 == 0, dim
+        row_bytes = dim // 32 * 18
+        # straight over the file mapping (the loader's accessor copies, and
+        # this table is 28.8 GB)
+        mm = self.loader.file_data_map[self.loader.tensor_file_map[self.PLE_TABLE]]
+        off = int(info["offset"])
+        raw = np.frombuffer(mm, dtype=np.uint8, count=rows * row_bytes, offset=off)
+        with warnings.catch_warnings():
+            warnings.simplefilter("ignore")  # read-only buffer; the rows are only copied out
+            return torch.from_numpy(raw).reshape(rows, row_bytes), dim
+
+    def ple_shards(self, n_shards: int) -> Iterator[Tuple[str, torch.Tensor]]:
+        """The table in the checkpoint's shard_K layout (shard k = rows
+        [k*ceil(V/n), (k+1)*ceil(V/n))), still IQ4_NL bytes: the model's shard
+        loader copies the rows of its TP range into the pinned uint8 table."""
+        table, dim = self.ple_rows()
+        rows = table.shape[0]
+        shard = (rows + n_shards - 1) // n_shards
+        for layer in self.ple_layers():
+            prefix = f"model.language_model.layers.{layer}.ple.ple_embedding.ngram_embedding"
+            for k in range(n_shards):
+                lo, hi = k * shard, min(rows, (k + 1) * shard)
+                if lo >= hi:
+                    break
+                yield f"{prefix}.shard_{k}.weight", table[lo:hi]
+
+
+    # -- quantized on the GPU ---------------------------------------------------
+    # Tensors whose GGUF blocks can go to the GPU as they are, for SGLang's
+    # GGUF linear / embedding methods (quantization_config quant_method gguf):
+    # the row-only transforms (V-head row permutations) are done on the byte
+    # rows; ssm_out needs a column permutation and stays dequantized.
+    # (token_embd stays bf16: qwen4_exp builds embed_tokens without a quant
+    # config, so it has no GGUF method; a .qweight for it loads nowhere)
+    # ssm_out (GDN out_proj) is in the GGUF's tiled V-head column order; its
+    # quant blocks are reordered whole so each TP rank gets its own heads, and
+    # the layer gathers its input to match (_ssm_out_layout / attach_ssm_out_perms)
+    QUANT_KEYS = {
+        "attn_q", "attn_k", "attn_v", "attn_output", "attn_qkv", "attn_gate",
+        "ffn_gate_shexp", "ffn_up_shexp", "ffn_down_shexp", "output", "ssm_out",
+    }
+    FLOAT_TYPES = {GGMLQuantizationType.F32, GGMLQuantizationType.F16, GGMLQuantizationType.BF16}
+
+    def quant_keys(self):
+        """KT_GGUF_DENSE_QUANT_KEYS=<comma list> narrows the set (bisection)."""
+        import os
+
+        env = os.environ.get("KT_GGUF_DENSE_QUANT_KEYS")
+        return set(env.split(",")) if env else self.QUANT_KEYS
+
+    def raw_rows(self, gguf_name: str) -> Tuple[torch.Tensor, int]:
+        """The tensor's bytes as [rows, row_bytes] uint8 (a copy) and its type."""
+        info = self.loader.tensor_info[gguf_name]
+        qt = GGMLQuantizationType(int(info["dtype"]))
+        shape = tuple(int(s) for s in info["shape"])
+        rows, cols = (shape[0], int(np.prod(shape[1:]))) if len(shape) > 1 else (1, shape[0])
+        blck, ts = GGML_SIZES.get(qt, (None, None))
+        if blck is None:
+            blck, ts = gguf.quants.GGML_QUANT_SIZES[qt]
+        row_bytes = cols // blck * ts
+        mm = self.loader.file_data_map[self.loader.tensor_file_map[gguf_name]]
+        raw = np.frombuffer(mm, dtype=np.uint8, count=rows * row_bytes, offset=int(info["offset"]))
+        return torch.from_numpy(raw.copy()).reshape(rows, row_bytes), int(qt)
+
+    @staticmethod
+    def _tp_size() -> int:
+        try:
+            from sglang.srt.runtime_context import get_parallel
+
+            return int(get_parallel().attn_tp_size)
+        except Exception:
+            return 1
+
+    def _ssm_out_layout(self, blk: int, tp: int):
+        """Block order of an ssm_out row (rank-major, so a contiguous TP split
+        hands each rank whole blocks of its own heads) and, per rank, the gather
+        that brings the rank's local grouped input into that order."""
+        dv, n_k, per_k = self.dv, self.n_k, self.per_k
+        if blk % dv or n_k % tp:
+            raise ValueError(f"ssm_out: block {blk} vs head dim {dv}, key heads {n_k} vs tp {tp}")
+        hpb = blk // dv
+        per_rank = n_k // tp
+        if n_k % hpb or per_rank % hpb:
+            raise ValueError(f"ssm_out: {hpb} heads per block does not tile {n_k} key heads over tp {tp}")
+        n_blocks = n_k * per_k // hpb
+        order, perms = [], []
+        for r in range(tp):
+            perm = []
+            for b in range(n_blocks):
+                t0 = b * hpb
+                if (t0 % n_k) // per_rank != r:
+                    continue
+                order.append(b)
+                for h in range(hpb):
+                    t = t0 + h
+                    v, k = t // n_k, t % n_k
+                    base = ((k - r * per_rank) * per_k + v) * dv
+                    perm.extend(range(base, base + dv))
+            perms.append(perm)
+        return order, perms
+
+    def _undo_rows(self, key: str, t: torch.Tensor) -> torch.Tensor:
+        """The row permutations of _undo on a byte matrix (no column changes)."""
+        if key == "attn_qkv":
+            q_dim = k_dim = self.n_k * self.dk
+            v = t[q_dim + k_dim:]
+            return torch.cat([t[:q_dim + k_dim], v[self._row_perm_v]], 0)
+        if key == "attn_gate":
+            return t[self._row_perm_v]
+        return t
+
+    def _fetch(self, n: str):
+        """The tensor as quantized_iter takes it: raw rows for a quantized
+        QUANT_KEYS tensor, else the dequantized / viewed tensor."""
+        key = self.hf_name(n)[2]
+        qt = GGMLQuantizationType(int(self.loader.tensor_info[n]["dtype"]))
+        if key in self.quant_keys() and qt not in self.FLOAT_TYPES:
+            return self.raw_rows(n)
+        return self.tensor(n)
+
+    def _fetched(self, names, fn):
+        """fn(name) for each name, in order. KT_GGUF_DENSE_THREADS=N computes up
+        to 4N ahead on N threads (gguf-py's numpy dequantization and the
+        mapping reads release the GIL; same function, same results)."""
+        threads = int(os.environ.get("KT_GGUF_DENSE_THREADS", "0") or 0)
+        if threads <= 1:
+            for n in names:
+                yield n, fn(n)
+            return
+        from collections import deque
+        from concurrent.futures import ThreadPoolExecutor
+
+        with ThreadPoolExecutor(max_workers=threads, thread_name_prefix="kt-gguf-dense") as ex:
+            q = deque()
+            it = iter(names)
+            for n in it:
+                q.append((n, ex.submit(fn, n)))
+                if len(q) >= 4 * threads:
+                    break
+            while q:
+                n, f = q.popleft()
+                nxt = next(it, None)
+                if nxt is not None:
+                    q.append((nxt, ex.submit(fn, nxt)))
+                yield n, f.result()
+
+    def quantized_iter(self) -> Iterator[Tuple[str, torch.Tensor]]:
+        """Like __iter__, but the QUANT_KEYS tensors that are quantized in the
+        GGUF come as (<name>.qweight_type, type) + (<name>.qweight, bytes)."""
+        pending_indexer: Dict[int, Dict[str, torch.Tensor]] = {}
+        for n, fetched in self._fetched(self.names(), self._fetch):
+            hf, layer, key = self.hf_name(n)
+            qt = GGMLQuantizationType(int(self.loader.tensor_info[n]["dtype"]))
+            if key in self.quant_keys() and qt not in self.FLOAT_TYPES:
+                rows, t = fetched
+                rows = self._undo_rows(key, rows)
+                if key == "ssm_out":
+                    blk, ts = gguf.quants.GGML_QUANT_SIZES[GGMLQuantizationType(t)]
+                    order, _ = self._ssm_out_layout(blk, self._tp_size())
+                    nb = rows.shape[1] // ts
+                    rows = rows.view(rows.shape[0], nb, ts)[:, order].reshape(rows.shape[0], nb * ts).contiguous()
+                if key == "attn_qkv":
+                    # the fused in_proj_qkvz takes GGUF shards one at a time
+                    # (a (0, 1, 2) shard id needs weight_loader_v2): q, k, v rows
+                    qk = self.n_k * self.dk
+                    for part, sl in (("q", slice(0, qk)), ("k", slice(qk, 2 * qk)), ("v", slice(2 * qk, None))):
+                        name = hf.replace("in_proj_qkv.", f"in_proj_{part}.")
+                        yield name.replace("weight", "qweight_type"), torch.tensor(t, dtype=torch.uint8)
+                        yield name.replace("weight", "qweight"), rows[sl].contiguous()
+                    continue
+                yield hf.replace("weight", "qweight_type"), torch.tensor(t, dtype=torch.uint8)
+                yield hf.replace("weight", "qweight"), rows
+                continue
+            t = fetched
+            if key in ("indexer.q_proj", "indexer.k_proj"):
+                d = pending_indexer.setdefault(layer, {})
+                d[key] = t
+                if len(d) == 2:
+                    q, k = d["indexer.q_proj"], d["indexer.k_proj"]
+                    yield hf, torch.cat([q, k], 0)
+                    del pending_indexer[layer]
+                continue
+            yield hf, self._undo(key, t)
+        assert not pending_indexer, f"unpaired indexer projections in layers {sorted(pending_indexer)}"
+
+
+def attach_ssm_out_perms(model, src: "GGUFDenseSource") -> int:
+    """After the load: each GDN out_proj holding GGUF blocks gets the input
+    gather that matches its reordered columns (_kt_in_perm, read by
+    GGUFLinearMethod.apply)."""
+    n = 0
+    for name, mod in model.named_modules():
+        if not name.endswith("linear_attn.out_proj") or not hasattr(mod, "qweight_type"):
+            continue
+        qt = int(getattr(mod.qweight_type, "weight_type", 0))
+        if GGMLQuantizationType(qt) in GGUFDenseSource.FLOAT_TYPES:
+            continue
+        blk, _ = gguf.quants.GGML_QUANT_SIZES[GGMLQuantizationType(qt)]
+        _, perms = src._ssm_out_layout(blk, int(mod.tp_size))
+        perm = torch.tensor(perms[int(mod.tp_rank)], dtype=torch.int64, device=mod.qweight.device)
+        mod.register_buffer("_kt_in_perm", perm, persistent=False)
+        n += 1
+    return n
+
+
+def attach_hc_fp8(model) -> int:
+    """KT_HC_FP8=1 (or =int8): fp8 e4m3 (or int8) per-row-scaled copies of every hyper-connection
+    mix weight, read by the fused decode kernel (sglang-hc-mix-fp8.py)."""
+    n = 0
+    for _, mod in model.named_modules():
+        down = getattr(getattr(mod, "input_mix_weight_down", None), "weight", None)
+        up = getattr(getattr(mod, "input_mix_weight_up", None), "weight", None)
+        if down is None or up is None or not down.is_cuda:
+            continue
+        int8 = os.environ.get("KT_HC_FP8") == "int8"
+        for tag, w in (("down", down), ("up", up)):
+            wf = w.detach().float()
+            if int8:  # 8-bit integers with a per-row scale: finer steps than e4m3 for these rows
+                scale = wf.abs().amax(dim=1).clamp(min=1e-12) / 127.0
+                q = torch.round(wf / scale[:, None]).clamp(-127, 127).to(torch.int8).contiguous()
+            else:
+                scale = (wf.abs().amax(dim=1).clamp(min=1e-12) / 448.0)
+                q = (wf / scale[:, None]).to(torch.float8_e4m3fn).contiguous()
+            mod.register_buffer(f"_kt_hc_{tag}_fp8", q, persistent=False)
+            mod.register_buffer(f"_kt_hc_{tag}_scale", scale.contiguous(), persistent=False)
+            if os.environ.get("KT_HC_FP8_ALL") == "1":
+                # the bf16 weights become the 8-bit values too, so prefill (and the
+                # prefill-path NLL tool) computes with exactly what decode reads.
+                # (Dropping the bf16 copy does not free it: the prefill lend has it
+                # inside a layer span; and widening per call cost decode 35%.)
+                w.data.copy_((q.float() * scale[:, None]).to(w.dtype))
+        n += 1
+    return n
+
+
+def gguf_all_weights(gguf_dir: str, hf_config, model=None) -> Iterator[Tuple[str, torch.Tensor]]:
+    """What the loader feeds Qwen4ExpForConditionalGeneration.load_weights
+    instead of the safetensors files when KT_GGUF_DENSE is set: the dense
+    tensors (HF names, bf16/f32 — or, with KT_GGUF_DENSE_QUANT=1 and a
+    quantization_config of quant_method gguf, the quantizable ones as GGUF
+    bytes for SGLang's GGUF kernels) and the PLE table as IQ4_NL shards.
+    Experts stay with kt-kernel (--kt-weight-path on the same GGUF)."""
+    import os
+
+    src = GGUFDenseSource(gguf_dir, hf_config)
+    t = getattr(hf_config, "text_config", hf_config)
+    n_shards = int(getattr(t, "split_ngram_parts", getattr(hf_config, "split_ngram_parts", 512)))
+    quant = os.environ.get("KT_GGUF_DENSE_QUANT") == "1"
+    if quant:
+        yield from src.quantized_iter()
+    else:
+        yield from src
+    yield from src.ple_shards(n_shards)
+    # (runs once the consumer has taken the last tensor)
+    if model is not None and os.environ.get("KT_HC_FP8") in ("1", "fp8", "int8"):
+        n = attach_hc_fp8(model)
+        print(f"[kt-gguf-dense] {n} hyper-connection mixes with fp8 weights for decode", flush=True)
+    if quant and model is not None and "ssm_out" in src.quant_keys():
+        n = attach_ssm_out_perms(model, src)
+        print(f"[kt-gguf-dense] {n} GDN out_proj layers in GGUF blocks with an input gather", flush=True)
+
+
+def verify_against_safetensors(gguf_dir: str, ckpt_dir: str, hf_config, layers=(0, 3), tol_exact=0.0) -> None:
+    """Compare the GGUF-derived dense tensors of a few layers (and the globals)
+    with the safetensors checkpoint: exact for tensors the GGUF keeps in
+    bf16/f32, cosine for the quantized ones (printed)."""
+    import json
+    import os
+
+    from safetensors import safe_open
+
+    idx = json.load(open(os.path.join(ckpt_dir, "model.safetensors.index.json")))["weight_map"]
+    files = {}
+
+    def ckpt(name):
+        fn = idx.get(name)
+        if fn is None:
+            return None
+        f = files.get(fn)
+        if f is None:
+            f = files[fn] = safe_open(os.path.join(ckpt_dir, fn), "pt")
+        return f.get_tensor(name)
+
+    src = GGUFDenseSource(gguf_dir, hf_config)
+    want = set()
+    for n in src.names():
+        hf, layer, key = src.hf_name(n)
+        if layer is None or layer in layers:
+            want.add(hf)
+    exact = quant = missing = bad = 0
+    for hf, t in src:
+        if hf not in want:
+            continue
+        ref = ckpt(hf)
+        if ref is None:
+            missing += 1
+            print(f"  {hf}: not in the checkpoint")
+            continue
+        if ref.dtype == torch.float8_e4m3fn or ref.dtype in (torch.uint8, torch.int8):
+            # NVFP4 / FP8 side: compare roughly through dequantization is out of scope here
+            print(f"  {hf}: checkpoint is {ref.dtype}, GGUF {t.dtype} {tuple(t.shape)}; skipped")
+            continue
+        if tuple(ref.shape) != tuple(t.shape):
+            bad += 1
+            print(f"  {hf}: shape {tuple(t.shape)} vs checkpoint {tuple(ref.shape)}   <-- MISMATCH")
+            continue
+        a, b = t.float(), ref.float()
+        if t.dtype in (torch.float32,) or (ref.dtype == t.dtype and (a - b).abs().max().item() <= tol_exact):
+            d = (a - b).abs().max().item()
+            if d <= max(tol_exact, 1e-6 * (1 + b.abs().max().item())):
+                exact += 1
+            else:
+                bad += 1
+                print(f"  {hf}: max |diff| {d:.3e} on a bf16/f32 tensor   <-- MISMATCH")
+            continue
+        cos = torch.nn.functional.cosine_similarity(a.flatten(), b.flatten(), dim=0).item()
+        quant += 1
+        flag = "" if cos > 0.98 else "   <-- LOW"
+        print(f"  {hf}: quantized in the GGUF, cos {cos:.5f}{flag}")
+        if cos <= 0.98:
+            bad += 1
+    print(f"exact {exact}, quantized {quant}, missing {missing}, mismatched {bad}")
