+"""HC low-rank mix for decode-size batches, second version (KT_HC_MIX_V2).
+
+sglang's hc_mix_triton._hc_mix_persistent_kernel (one CTA per SM, software grid
+barriers) runs a decode call of the Flash-Next GGUF stack in ~16.8 us for ~6.6 MB
+of int8 weights (rows 2, K 10240 -> lowrank 320 -> 4 x 2560), about half the
+card's bandwidth. This version keeps its math and order of operations per
+element, and changes the schedule:
+  - the atomics of the down projection skip the padding rows (16 padded, 2 real);
+  - t_raw is one persistent zeroed buffer per device: the last CTA to finish
+    zeroes the rows it used, so there is no zero-fill phase and no barrier for
+    it at the start of a call (the stream orders calls, so no two overlap);
+  - num_ctas 80 and up blocks of 32 columns x lowrank steps of 32: 10 x 40 = 400
+    down tiles and 2560 / 32 = 80 up blocks, one per CTA (70 CTAs and 16-column
+    blocks left the last up round half idle). tools/bench_hc_mix.py, weights from
+    DRAM: 16.27 -> 13.15 us per call (403 -> 498 GB/s). 160 CTAs do not fit on the
+    card at once and the grid barrier hangs.
+The down projection's atomics sum in a varying order, as before: not
+bit-reproducible run to run, so the quality check is paired NLL.
+
+Usage: fused_hc_mix_v2(...) with fused_hc_mix's arguments; KT_HC_MIX_CTAS overrides the CTA count.
+"""
+import os
+
+import torch
+import triton
+import triton.language as tl
+
+ENABLED = os.environ.get("KT_HC_MIX_V2", "1") == "1"
+CTAS = int(os.environ.get("KT_HC_MIX_CTAS", "80"))
+# tile shape and warps (KT_HC_MIX_TILE="BLOCK_N,BLOCK_K,BLOCK_J,BLOCK_R,num_warps,num_stages")
+TILE = [int(v) for v in os.environ.get("KT_HC_MIX_TILE", "32,256,32,32,4,3").split(",")]
+_ROWS_PAD = 16
+
+
+@triton.jit
+def _grid_barrier(counter_ptr, num_ctas):
+    tl.atomic_add(counter_ptr, 1, sem="acq_rel", scope="gpu")
+    while tl.atomic_add(counter_ptr, 0, sem="acq_rel", scope="gpu") < num_ctas:
+        pass
+
+
+@triton.jit
+def _hc_mix_v2_kernel(
+    x_ptr, w_down_ptr, w_up_ptr, t_raw_ptr, out_ptr, counters_ptr,
+    K, LOWRANK, HS, num_rows, num_ctas, inv_hc, w_down_scale_ptr, w_up_scale_ptr,
+    W_FP8: tl.constexpr, ROWS: tl.constexpr, HC: tl.constexpr,
+    BLOCK_N: tl.constexpr, BLOCK_K: tl.constexpr, BLOCK_J: tl.constexpr, BLOCK_R: tl.constexpr,
+):
+    pid = tl.program_id(0)
+    offs_m = tl.arange(0, ROWS)
+    mask_m = offs_m < num_rows
+
+    # down projection: t_raw (zero on entry) += x @ w_down^T, real rows only
+    offs_k = tl.arange(0, BLOCK_K)
+    offs_n = tl.arange(0, BLOCK_N)
+    n_blocks = tl.cdiv(LOWRANK, BLOCK_N)
+    k_chunks = tl.cdiv(K, BLOCK_K)
+    for tile in range(pid, n_blocks * k_chunks, num_ctas):
+        nb = tile % n_blocks
+        kc = tile // n_blocks
+        n = nb * BLOCK_N + offs_n
+        k = kc * BLOCK_K + offs_k
+        mask_n = n < LOWRANK
+        xt = tl.load(x_ptr + offs_m[:, None] * K + k[None, :], mask=mask_m[:, None], other=0.0)
+        w = tl.load(w_down_ptr + n[:, None] * K + k[None, :], mask=mask_n[:, None], other=0.0)
+        if W_FP8:
+            w = w.to(xt.dtype)
+        acc = tl.dot(xt, tl.trans(w))
+        if W_FP8:
+            acc = acc * tl.load(w_down_scale_ptr + n, mask=mask_n, other=0.0)[None, :]
+        tl.atomic_add(t_raw_ptr + offs_m[:, None] * LOWRANK + n[None, :], acc,
+                      mask=mask_m[:, None] & mask_n[None, :], sem="relaxed", scope="gpu")
+    _grid_barrier(counters_ptr + 0, num_ctas)
+
+    # up projection and gate, as the original
+    offs_j = tl.arange(0, BLOCK_J)
+    offs_r = tl.arange(0, BLOCK_R)
+    offs_g = tl.arange(0, HC)
+    j_blocks = tl.cdiv(HS, BLOCK_J)
+    for jb in range(pid, j_blocks, num_ctas):
+        j = jb * BLOCK_J + offs_j
+        mask_j = j < HS
+        gj = offs_g[:, None] * HS + j[None, :]
+        gj_flat = tl.reshape(gj, (HC * BLOCK_J,))
+        mask_gj = tl.reshape(tl.broadcast_to(mask_j[None, :], (HC, BLOCK_J)), (HC * BLOCK_J,))
+        acc = tl.zeros((ROWS, HC * BLOCK_J), dtype=tl.float32)
+        for r0 in range(0, LOWRANK, BLOCK_R):
+            r = r0 + offs_r
+            mask_r = r < LOWRANK
+            a = tl.load(t_raw_ptr + offs_m[:, None] * LOWRANK + r[None, :], mask=mask_m[:, None] & mask_r[None, :],
+                        other=0.0)
+            a = a * inv_hc
+            t = (a * tl.sigmoid(a)).to(x_ptr.dtype.element_ty)
+            w = tl.load(w_up_ptr + gj_flat[:, None] * LOWRANK + r[None, :], mask=mask_gj[:, None] & mask_r[None, :],
+                        other=0.0)
+            if W_FP8:
+                w = w.to(t.dtype)
+            acc = tl.dot(t, tl.trans(w), acc)
+        if W_FP8:
+            acc = acc * tl.load(w_up_scale_ptr + gj_flat, mask=mask_gj, other=0.0)[None, :]
+        gate = tl.sigmoid(tl.reshape(acc, (ROWS, HC, BLOCK_J)))
+        xg = tl.load(x_ptr + offs_m[:, None, None] * (HC * HS) + offs_g[None, :, None] * HS + j[None, None, :],
+                     mask=mask_m[:, None, None] & mask_j[None, None, :], other=0.0).to(tl.float32)
+        out = tl.sum(gate * xg, axis=1) * inv_hc
+        tl.store(out_ptr + offs_m[:, None] * HS + j[None, :], out.to(out_ptr.dtype.element_ty),
+                 mask=mask_m[:, None] & mask_j[None, :])
+
+    # the last CTA out resets the barrier and zeroes the t_raw rows for the next call
+    ticket = tl.atomic_add(counters_ptr + 1, 1, sem="acq_rel", scope="gpu")
+    if ticket == num_ctas - 1:
+        offs_z = tl.arange(0, 1024)
+        span = num_rows * LOWRANK
+        for z0 in range(0, span, 1024):
+            idx = z0 + offs_z
+            tl.store(t_raw_ptr + idx, 0.0, mask=idx < span)
+        tl.store(counters_ptr + 0, 0)
+        tl.store(counters_ptr + 1, 0)
+
+
+_state = {}  # device -> (counters, t_raw zeroed)
+
+
+def _buffers(device, lowrank):
+    st = _state.get((device, lowrank))
+    if st is None:
+        st = _state[(device, lowrank)] = (torch.zeros(2, dtype=torch.int32, device=device),
+                                          torch.zeros((_ROWS_PAD, lowrank), dtype=torch.float32, device=device))
+    return st
+
+
+def fused_hc_mix_v2(hyper_input_normed, w_down, w_up, hc, hs, w_down_scale=None, w_up_scale=None):
+    rows, k = hyper_input_normed.shape
+    lowrank = w_down.shape[0]
+    device = hyper_input_normed.device
+    out = torch.empty((rows, hs), dtype=hyper_input_normed.dtype, device=device)
+    if rows == 0:
+        return out
+    counters, t_raw = _buffers(device, lowrank)
+    _hc_mix_v2_kernel[(CTAS,)](
+        hyper_input_normed, w_down, w_up, t_raw, out, counters,
+        k, lowrank, hs, rows, CTAS, 1.0 / hc,
+        w_down_scale if w_down_scale is not None else t_raw,
+        w_up_scale if w_up_scale is not None else t_raw,
+        W_FP8=w_down_scale is not None, ROWS=_ROWS_PAD, HC=hc,
+        BLOCK_N=TILE[0], BLOCK_K=TILE[1], BLOCK_J=TILE[2], BLOCK_R=TILE[3], num_warps=TILE[4], num_stages=TILE[5],
+    )
+    return out
