+
+# KT_GGUF_DENSE_CACHE=<dir>: big dequantized tensors (token_embd, IQ4_XS
+# 248320 x 2560: 7.5 s of gguf-py per rank per launch) are kept as bf16 files,
+# named by a hash of the tensor's GGUF bytes, its type and shape, gguf-py's
+# version and this function's code, so a changed file or dequantizer can
+# never be served a stale copy. Read back, they are the same bytes.
+_DQ_CACHE_MIN = 16 << 20
+
+
+def _dequant_cache_key(raw: np.ndarray, qt, shape) -> str:
+    import hashlib
+    import inspect
+
+    h = hashlib.blake2b(digest_size=20)
+    h.update(memoryview(np.ascontiguousarray(raw)).cast("B"))
+    h.update(f"{int(qt)}|{tuple(shape)}|{getattr(gguf, '__version__', '')}".encode())
+    h.update(inspect.getsource(gguf.quants.dequantize).encode())
+    h.update(inspect.getsource(GGUFDenseSource.tensor).encode())
+    try:
+        with open(gguf.quants.__file__, "rb") as f:
+            h.update(hashlib.blake2b(f.read(), digest_size=16).digest())
+    except OSError:
+        pass
+    return h.hexdigest()
+
+
+def _dequant_cache_path(raw, qt, shape):
+    d = os.environ.get("KT_GGUF_DENSE_CACHE", "")
+    if not d or raw.nbytes < _DQ_CACHE_MIN:
+        return None
+    return os.path.join(d, f"dq-{_dequant_cache_key(raw, qt, shape)}.bf16")
+
+
+def _dequant_cache_get(raw, qt, shape):
+    p = _dequant_cache_path(raw, qt, shape)
+    if p is None or not os.path.isfile(p):
+        return None
+    n = int(np.prod(shape))
+    if os.path.getsize(p) != 2 * n:
+        return None
+    a = np.fromfile(p, dtype=np.int16, count=n)
+    return torch.from_numpy(a).view(torch.bfloat16).reshape(shape)
+
+
+def _dequant_cache_put(raw, qt, shape, t: torch.Tensor) -> None:
+    p = _dequant_cache_path(raw, qt, shape)
+    if p is None:
+        return
+    try:
+        os.makedirs(os.path.dirname(p), exist_ok=True)
+        tmp = f"{p}.tmp{os.getpid()}"
+        t.contiguous().view(torch.int16).numpy().tofile(tmp)
+        os.replace(tmp, p)
+    except OSError as e:
+        print(f"[kt-gguf-dense] dequant cache not written ({e})", flush=True)
+
+
+def _tiled_to_grouped_rows(n_k: int, per_k: int, head_dim: int) -> torch.Tensor:
+    """Row permutation that takes the converter's tiled V-head order back to
+    HF's grouped order: tiled index t = (v * n_k + k) * head_dim + d holds
+    grouped element (k * per_k + v) * head_dim + d."""
+    n = n_k * per_k * head_dim
+    tiled = torch.arange(n).reshape(n_k, per_k, head_dim).permute(1, 0, 2).reshape(n)
+    inv = torch.empty_like(tiled)
+    inv[tiled] = torch.arange(n)
+    return inv
+
+
+class GGUFDenseSource:
+    def __init__(self, gguf_dir: str, hf_config, loader: GGUFLoader = None):
+        if isinstance(hf_config, dict):
+            t = hf_config.get("text_config", hf_config)
+            g = lambda k, d=None: t.get(k, hf_config.get(k, d))  # noqa: E731
+        else:
+            t = getattr(hf_config, "text_config", hf_config)
+            g = lambda k, d=None: getattr(t, k, getattr(hf_config, k, d))  # noqa: E731
+        self.loader = loader or GGUFLoader(gguf_dir)
+        self.n_layers = int(g("num_hidden_layers"))
+        self.n_k = int(g("linear_num_key_heads"))
+        self.n_v = int(g("linear_num_value_heads"))
+        self.dk = int(g("linear_key_head_dim"))
+        self.dv = int(g("linear_value_head_dim"))
+        self.per_k = self.n_v // self.n_k
+        self.indexer_q = int(g("indexer_n_heads")) * int(g("indexer_head_dim"))
+        self._row_perm_v = _tiled_to_grouped_rows(self.n_k, self.per_k, self.dv)
+        self._row_perm_1 = _tiled_to_grouped_rows(self.n_k, self.per_k, 1)
+
+    # -- raw -> torch -------------------------------------------------------
+
+    def tensor(self, gguf_name: str) -> torch.Tensor:
+        info = self.loader.tensor_info[gguf_name]
+        data, qt = self.loader.get_undequanted_tensor_and_ggml_type(gguf_name)
+        shape = tuple(int(s) for s in info["shape"])  # torch order
+        qt = GGMLQuantizationType(int(qt))
+        raw = data.numpy()
+        if qt == GGMLQuantizationType.F32:
+            return torch.from_numpy(raw.view(np.float32).reshape(shape).copy())
+        if qt == GGMLQuantizationType.F16:
+            return torch.from_numpy(raw.view(np.float16).reshape(shape).copy()).to(torch.bfloat16)
+        if qt == GGMLQuantizationType.BF16:
+            return data.view(torch.bfloat16).reshape(shape).clone()
+        cached = _dequant_cache_get(raw, qt, shape)
+        if cached is not None:
+            return cached
+        byte_shape = gguf.quants.quant_shape_to_byte_shape(shape, qt)
+        rows = raw.reshape(byte_shape)
+        threads = int(os.environ.get("KT_GGUF_DENSE_THREADS", "0") or 0)
+        if threads > 1 and len(byte_shape) == 2 and byte_shape[0] >= 4 * threads and raw.nbytes >= (64 << 20):
+            # a big table (token_embd: 7.5 s on one thread) in row blocks on
+            # several threads; blocks dequantize independently, so the values
+            # are the same (tools/test_gguf_dense_threads.py)
+            from concurrent.futures import ThreadPoolExecutor
+
+            parts = np.array_split(rows, 4 * threads, axis=0)
+            with ThreadPoolExecutor(max_workers=threads) as ex:
+                f = np.concatenate(list(ex.map(lambda r: gguf.quants.dequantize(r, qt), parts)), axis=0).reshape(shape)
