new file mode 100644
index 0000000..146b5a9
--- /dev/null
+++ b/python/sglang/srt/layers/moe/kt_uva_handoff.py
@@ -0,0 +1,271 @@
+"""The GPU <-> CPU expert handoff of the KT hybrid through UVA (KT_UVA_HANDOFF=1, default).
+
+kt_kernel's BaseMoEWrapper.submit_forward puts four operations on the compute
+stream per MoE layer before the CPU is signalled: topk_ids.to(long), then three
+small D2H copies (hidden states, route weights, expert ids) into its pinned
+buffers; sync_forward waits and copies the CPU's output back H2D before the
+caller adds it. Each small copy costs a few microseconds of launch latency on
+the stream, and the CPU only starts after the last one (~12 us a layer on the
+default Flash-Next stack, on the CPU's critical path).
+
+Here one Triton kernel writes the same bytes straight into the same pinned
+buffers through their UVA addresses (ids widened to int64 in the kernel; the
+host stores are write-through), and the output comes back as before (an opt-in
+kernel add that reads the pinned output in place is below, KT_UVA_HANDOFF_ADD).
+On the default Flash-Next stack, same day: 102.2 -> 104.2 tok/s; paired NLL of
+6,120 teacher-forced tokens identical. The stream memop that signals the CPU orders after the kernel and carries a memory
+barrier, so the CPU sees the inputs; the CPU writes its output before its flag.
+The buffers are cached per batch size by kt_kernel, so the addresses baked into
+a CUDA graph stay valid. Same bytes reach the CPU: bit-identical.
+
+Only the inference path without deferred experts (--kt-max-deferred-experts-per-token 0).
+"""
+import os
+
+import torch
+import triton
+import triton.language as tl
+
+ENABLED = os.environ.get("KT_UVA_HANDOFF", "1") == "1"
+# KT_UVA_HANDOFF_ADD=1: add the CPU's output by reading the pinned buffer from a
+# kernel instead of kt_kernel's H2D copy. Off by default: the read has to be
+# volatile (the GPU caches system memory in L2 and the slot is reused every two
+# layers), and volatile loads of 5 KB a layer cost more than the copy engine
+# (-5.5% vs the copy on the same day; a cached read was the fastest but can
+# return the slot's old bytes).
+ADD = os.environ.get("KT_UVA_HANDOFF_ADD", "0") == "1"
+# KT_UVA_PARTIALS=1 (off by default): for windows of at most PART_MAXQ tokens the
+# two NUMA parts leave their fp32 rows in pinned buffers (kt-moe-partials-out.py,
+# set_partial_outputs) instead of kt_kernel summing them on one CPU thread across
+# the socket link; the GPU copies both and computes bf16(p0 + p1). Bit-identical
+# and merge_results is gone, but the extra copy and kernel after the CPU's done
+# flag sit on the critical path: same-day launches gave 106.3 (on) vs 107.7 (off)
+# with the merge folded into down (10-10).
+PARTIALS = os.environ.get("KT_UVA_PARTIALS", "0") == "1"
+PART_MAXQ = int(os.environ.get("KT_UVA_PARTIALS_MAXQ", "8"))  # a check can raise it to prefill windows
+_part_host = None  # pinned fp32 [2 slots (layer parity), 2 parts, PART_MAXQ, hidden]
+_part_dev = {}  # device -> the same shape on the GPU
+_part_on = {}  # id(wrapper) -> the C++ side accepted the buffers
+# KT_UVA_PREQUANT=1 (default): the stage kernel also writes each token as q8_K
+# (ggml's quantize_row_q8_K_reference, same arithmetic) into a pinned buffer that
+# kt-kernel reads as the experts' gate/up input (kt-moe-prequant-input.py,
+# set_prequant_input; the CPU side is the live knob KT_PREQUANT), for windows of
+# at most PQ_MAXQ tokens
+PREQUANT = os.environ.get("KT_UVA_PREQUANT", "1") == "1"
+PQ_MAXQ = int(os.environ.get("KT_UVA_PREQUANT_MAXQ", "8"))  # a check can raise it to prefill windows
+Q8K_BYTES = 292  # fp32 d, 256 int8, 16 int16 sums
+_pq_host = None  # pinned uint8 [2 slots (layer parity), PQ_MAXQ, hidden / 256 * 292]
+_pq_on = {}  # id(wrapper) -> the C++ side accepted the buffer
+
+
+@triton.jit
+def _stage_kernel(x_ptr, ids_ptr, w_ptr, hx, hids, hw, H, K,
+                  ids_is_64: tl.constexpr, BLOCK_H: tl.constexpr, BLOCK_K: tl.constexpr):
+    t = tl.program_id(0)
+    o = tl.arange(0, BLOCK_H)
+    m = o < H
+    dst_x = hx.to(tl.int64).to(tl.pointer_type(tl.bfloat16))
+    tl.store(dst_x + t * H + o, tl.load(x_ptr + t * H + o, mask=m), mask=m, cache_modifier=".wt")
+    k = tl.arange(0, BLOCK_K)
+    mk = k < K
+    ids = tl.load(ids_ptr + t * K + k, mask=mk)
+    if not ids_is_64:
+        ids = ids.to(tl.int64)
+    tl.store(hids.to(tl.int64).to(tl.pointer_type(tl.int64)) + t * K + k, ids, mask=mk, cache_modifier=".wt")
+    tl.store(hw.to(tl.int64).to(tl.pointer_type(tl.float32)) + t * K + k, tl.load(w_ptr + t * K + k, mask=mk).to(tl.float32),
+             mask=mk, cache_modifier=".wt")
+
+
+@triton.jit
+def _stage_q8k_kernel(x_ptr, ids_ptr, w_ptr, hx, hids, hw, hq, H, K, ROW,
+                      ids_is_64: tl.constexpr, BLOCK_K: tl.constexpr):
+    # one program per (token, 256-block): the bf16 slice as _stage_kernel writes
+    # it, and the q8_K block exactly as ggml's quantize_row_q8_K_reference builds
+    # it in kt-kernel: the first element of largest |x| gives max, iscale =
+    # -127/max and d = 1/iscale as IEEE divides, and the code is the low 23 bits
+    # of fma(iscale, x, 12582912) minus 0x400000 (the compiled reference fuses
+    # nearest_int's add into the multiply), capped at 127
+    t = tl.program_id(0)
+    b = tl.program_id(1)
+    o = tl.arange(0, 256)
+    xb = tl.load(x_ptr + t * H + b * 256 + o)
+    tl.store(hx.to(tl.int64).to(tl.pointer_type(tl.bfloat16)) + t * H + b * 256 + o, xb, cache_modifier=".wt")
+    x = xb.to(tl.float32)
+    ax = tl.abs(x)
+    amax = tl.max(ax, axis=0)
+    idx = tl.argmax(ax, axis=0, tie_break_left=True)
+    mx = tl.sum(tl.where(o == idx, x, 0.0), axis=0)
+    nz = amax > 0
+    iscale = tl.math.div_rn(tl.full([], -127.0, tl.float32), tl.where(nz, mx, 1.0))
+    f = tl.math.fma(tl.zeros([256], tl.float32) + iscale, x, tl.full([256], 12582912.0, tl.float32))
+    v = (f.to(tl.int32, bitcast=True) & 0x7FFFFF) - 0x400000
+    v = tl.where(nz, tl.minimum(v, 127), 0)
+    base = hq.to(tl.int64) + t.to(tl.int64) * ROW + b * 292
+    tl.store((base + 4).to(tl.pointer_type(tl.int8)) + o, v.to(tl.int8), cache_modifier=".wt")
+    bs = tl.sum(tl.reshape(v, (16, 16)), axis=1)
+    tl.store((base + 260).to(tl.pointer_type(tl.int16)) + tl.arange(0, 16), bs.to(tl.int16), cache_modifier=".wt")
+    d = tl.where(nz, tl.math.div_rn(tl.full([], 1.0, tl.float32), iscale), 0.0)
+    tl.store(base.to(tl.pointer_type(tl.float32)), d, cache_modifier=".wt")
+    if b == 0:
+        k = tl.arange(0, BLOCK_K)
+        mk = k < K
+        ids = tl.load(ids_ptr + t * K + k, mask=mk)
+        if not ids_is_64:
+            ids = ids.to(tl.int64)
+        tl.store(hids.to(tl.int64).to(tl.pointer_type(tl.int64)) + t * K + k, ids, mask=mk, cache_modifier=".wt")
+        tl.store(hw.to(tl.int64).to(tl.pointer_type(tl.float32)) + t * K + k,
+                 tl.load(w_ptr + t * K + k, mask=mk).to(tl.float32), mask=mk, cache_modifier=".wt")
+
+
+@triton.jit
+def _add_kernel(out_ptr, hout, H, BLOCK_H: tl.constexpr):
+    t = tl.program_id(0)
+    o = tl.arange(0, BLOCK_H)
+    m = o < H
+    src = hout.to(tl.int64).to(tl.pointer_type(tl.bfloat16))
+    a = tl.load(out_ptr + t * H + o, mask=m).to(tl.float32)
+    # volatile: the GPU caches system memory in L2, and this slot held the CPU's
+    # output of two layers back; a cached read adds that stale output
+    b = tl.load(src + t * H + o, mask=m, volatile=True).to(tl.float32)
+    tl.store(out_ptr + t * H + o, (a + b).to(tl.bfloat16), mask=m)
+
+
+@triton.jit
+def _sum2_kernel(out_ptr, a_ptr, b_ptr, H, ADD: tl.constexpr, BLOCK_H: tl.constexpr):
+    # bf16(a + b), optionally added into out: kt_kernel's merge_results sums the
+    # parts in fp32 and rounds to bf16 to nearest even, and the caller then adds
+    # that bf16 output; same operations here
+    t = tl.program_id(0)
+    o = tl.arange(0, BLOCK_H)
+    m = o < H
+    s = (tl.load(a_ptr + t * H + o, mask=m) + tl.load(b_ptr + t * H + o, mask=m)).to(
+        tl.bfloat16, fp_downcast_rounding="rtne")
+    if ADD:
+        s = (tl.load(out_ptr + t * H + o, mask=m).to(tl.float32) + s.to(tl.float32)).to(
+            tl.bfloat16, fp_downcast_rounding="rtne")
+    tl.store(out_ptr + t * H + o, s, mask=m)
+
+
+def active(wrapper) -> bool:
+    return (ENABLED and wrapper is not None and getattr(wrapper, "max_deferred_experts_per_token", 1) == 0
+            and hasattr(wrapper, "moe") and hasattr(wrapper, "cpu_infer"))
+
+
+def _buffers(wrapper, x):
+    from kt_kernel.experts_base import KExpertsCPUBuffer
+
+    bufs = KExpertsCPUBuffer.get_buffer(x, wrapper.num_experts_per_tok)
+    return bufs, wrapper.layer_idx % KExpertsCPUBuffer.buffer_depth
+
+
+def _partials(wrapper, H) -> bool:
+    """Give this layer's C++ MoE the partial-output buffers once; True if it took them."""
+    global _part_host
+    key = id(wrapper)
+    if key not in _part_on:
+        ok = False
+        if PARTIALS and active(wrapper) and hasattr(wrapper.moe, "set_partial_outputs"):
+            if _part_host is None:
+                _part_host = torch.zeros((2, 2, PART_MAXQ, H), dtype=torch.float32).pin_memory()
+            slot = wrapper.layer_idx % 2
+            ok = bool(wrapper.moe.set_partial_outputs(_part_host[slot, 0].data_ptr(), _part_host[slot, 1].data_ptr(),
+                                                      PART_MAXQ))
+        _part_on[key] = ok
+    return _part_on[key]
+
+
+def _prequant(wrapper, H) -> bool:
+    """Give this layer's C++ MoE the q8_K input rows once; True if it took them."""
+    global _pq_host
+    key = id(wrapper)
+    if key not in _pq_on:
+        ok = False
+        if PREQUANT and H % 256 == 0 and active(wrapper) and hasattr(wrapper.moe, "set_prequant_input"):
+            if _pq_host is None:
+                _pq_host = torch.zeros((2, PQ_MAXQ, H // 256 * Q8K_BYTES), dtype=torch.uint8).pin_memory()
+            ok = bool(wrapper.moe.set_prequant_input(_pq_host[wrapper.layer_idx % 2].data_ptr(), PQ_MAXQ))
+        _pq_on[key] = ok
+    return _pq_on[key]
+
+
+def partials_for(wrapper, x) -> bool:
+    """This call's CPU output is in the partial buffers (the C++ side's rule)."""
+    return _part_on.get(id(wrapper), False) and x.view(-1, x.shape[-1]).shape[0] <= PART_MAXQ
+
+
+def sync_partials(wrapper, x, output, stream):
+    """Wait for the CPU, copy both parts' rows, return bf16(p0 + p1), or add it
+    into `output` in place when it is given (bf16, contiguous)."""
+    flat = x.view(-1, x.shape[-1])
+    T, H = flat.shape
+    wrapper.cpu_infer.sync_with_cuda_stream(stream.cuda_stream, 0)
+    dev = _part_dev.get(flat.device)
+    if dev is None:
+        dev = _part_dev[flat.device] = torch.empty(_part_host.shape, dtype=torch.float32, device=flat.device)
+    slot = wrapper.layer_idx % 2
+    g = dev[slot]
+    g[0, :T].copy_(_part_host[slot, 0, :T], non_blocking=True)
+    g[1, :T].copy_(_part_host[slot, 1, :T], non_blocking=True)
+    add = output is not None and output.dtype == torch.bfloat16 and output.is_contiguous()
+    res = output.view(-1, H) if add else torch.empty((T, H), dtype=torch.bfloat16, device=flat.device)
+    if T:
+        _sum2_kernel[(T,)](res, g[0], g[1], H, ADD=add, BLOCK_H=triton.next_power_of_2(H))
+    if add:
+        return output
+    return res if output is None else output + res
+
+
+def submit(wrapper, x, topk_ids, topk_weights, stream) -> bool:
+    """Stage the inputs and signal the CPU; False if this wrapper is not handled."""
+    if not active(wrapper):
+        return False
+    _partials(wrapper, x.shape[-1])
+    pq = _prequant(wrapper, x.shape[-1])
+    from kt_kernel.experts_base import BaseMoEWrapper
+
+    x = x.view(-1, x.shape[-1])
+    if x.dtype != torch.bfloat16 or not x.is_contiguous():
+        if not pq:
+            return False
+        # kt-kernel reads the q8_K rows for small windows: never fall back here
+        x = x.to(torch.bfloat16).contiguous()
+    T, H = x.shape
+    (inp, ids_cpu, _deferred, w_cpu, out_cpu, bsz, _out_gpu), slot = _buffers(wrapper, x)
+    K = ids_cpu[slot].size(-1)
+    ids = topk_ids.contiguous()
+    w = topk_weights.contiguous()
+    if T and pq and T <= PQ_MAXQ:
+        hq = _pq_host[wrapper.layer_idx % 2]
+        _stage_q8k_kernel[(T, H // 256)](x, ids, w, inp[slot].data_ptr(), ids_cpu[slot].data_ptr(),
+                                         w_cpu[slot].data_ptr(), hq.data_ptr(), H, K, hq.shape[1],
+                                         ids_is_64=ids.dtype == torch.int64, BLOCK_K=triton.next_power_of_2(K))
+    elif T:
+        _stage_kernel[(T,)](x, ids, w, inp[slot].data_ptr(), ids_cpu[slot].data_ptr(), w_cpu[slot].data_ptr(),
+                            H, K, ids_is_64=ids.dtype == torch.int64,
+                            BLOCK_H=triton.next_power_of_2(H), BLOCK_K=triton.next_power_of_2(K))
+    incremental = BaseMoEWrapper._layer_has_pending_deferred.get(wrapper.layer_idx - 1, False)
+    wrapper.cpu_infer.submit_with_cuda_stream(
+        stream.cuda_stream,
+        wrapper.moe.forward_task(bsz[slot].data_ptr(), K, ids_cpu[slot].data_ptr(), w_cpu[slot].data_ptr(),
+                                 inp[slot].data_ptr(), out_cpu[slot].data_ptr(), incremental),
+    )
+    BaseMoEWrapper._layer_has_pending_deferred[wrapper.layer_idx] = False
+    return True
+
+
+def sync_add(wrapper, x, output, stream):
+    """Wait for the CPU and add its output into `output` (in place, returned)."""
+    if partials_for(wrapper, x):
+        return sync_partials(wrapper, x, output, stream)
+    if not ADD:
+        return output + wrapper.sync_forward(x, stream.cuda_stream)
+    flat = x.view(-1, x.shape[-1])
+    (_inp, _ids, _deferred, _w, out_cpu, _bsz, _out_gpu), slot = _buffers(wrapper, flat)
+    wrapper.cpu_infer.sync_with_cuda_stream(stream.cuda_stream, 0)
+    out = output.view(-1, output.shape[-1])
+    if not out.is_contiguous() or out.dtype != torch.bfloat16:
+        return output + _out_gpu[slot].copy_(out_cpu[slot], non_blocking=True)
+    T, H = out.shape
+    if T:
+        _add_kernel[(T,)](out, out_cpu[slot].data_ptr(), H, BLOCK_H=triton.next_power_of_2(H))
+    return output
