+static __device__ __forceinline__ float
+vec_dot_iq2_xs_q8_1(const void* __restrict__ vbq, const block_q8_1* __restrict__ bq8_1, const int& iqs) {
+  const block_iq2_xs* bq2 = (const block_iq2_xs*)vbq;
