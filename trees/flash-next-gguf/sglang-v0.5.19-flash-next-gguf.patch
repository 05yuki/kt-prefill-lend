+GGML_SIZES = {
+    GGMLQuantizationType.F32: (1, 4), GGMLQuantizationType.F16: (1, 2), GGMLQuantizationType.BF16: (1, 2),
+    GGMLQuantizationType.Q8_0: (32, 34), GGMLQuantizationType.Q4_K: (256, 144), GGMLQuantizationType.Q5_K: (256, 176),
+    GGMLQuantizationType.Q6_K: (256, 210), GGMLQuantizationType.IQ4_NL: (32, 18), GGMLQuantizationType.IQ4_XS: (256, 136),
+}
