{
  "name": "glm53-flash",
  "description": "GLM-5.3-Flash: fp8 dense checkpoint (--config-dir), NVFP4 experts beside it (--experts, KT NVFP4 method on the CPU, NVFP4 hot experts on the GPU), the full-GPU prefill above the KT threshold with the lend, fp8 KV, no MTP (measured not to pay). TP2 only as measured.",
  "tree": "kvcache-ai/sglang 541ddc3 + trees/glm53",
  "weights": {
    "gguf": false,
    "experts_from": true,
    "embed_host": 0,
    "draft": "none",
    "draft_bytes_assumed": 0
  },
  "defaults": {
    "2": {
      "context": 131072,
      "mem_fraction": 0.88,
      "kv_dtype": "fp8",
      "mamba_slots": 1,
      "pools": 2
    }
  },
  "command": [
    "-m",
    "sglang.launch_server",
    "--model-path",
    "{config_dir}",
    "--served-model-name",
    "{served_model_name}",
    "--host",
    "0.0.0.0",
    "--port",
    "{port}",
    "--tp",
    "{tp}",
    "--numa-node",
    "{numa_nodes}",
    "--disable-custom-all-reduce",
    "--kv-cache-dtype",
    "{kv_cache_dtype}",
    "--context-length",
    "{context}",
    "--mem-fraction-static",
    "{mem_fraction}",
    "--max-running-requests",
    "1",
    "--kt-gpu-prefill-token-threshold",
    "512",
    "--page-size",
    "64",
    "--trust-remote-code",
    "--kt-weight-path",
    "{experts_dir}",
    "--kt-method",
    "NVFP4",
    "--kt-cpuinfer",
    "{threads}",
    "--kt-threadpool-count",
    "{pools}",
    "--kt-num-gpu-experts",
    "{hot}",
