  "env": {
    "NCCL_P2P_DISABLE": "1",
    "NCCL_IB_DISABLE": "1",
    "SGLANG_V4_USE_TRITON_KERNELS": "0",
    "KT_GLM53_HOT_NVFP4": "1",
    "KT_LOAD_ALL_EXPERTS": "1",
    "KT_MXFP4_SCALE_CODES": "1",
    "KT_PREFILL_LEND": "1",
    "KT_PREFILL_LEND_CALIBRATE": "0",
    "KT_PREFILL_LEND_HINT": "{cache_dir}/lend-hint-{key}",
    "KT_GPU_EXPERTS": "{hot}",
    "KT_FAST_PINNED": "0",
    "KT_STREAM_MEMOPS": "1",
    "KT_TASKQUEUE_SPIN_US": "300",
    "SGLANG_MM_PROCESSOR_DEVICE": "cpu",
    "SGLANG_GLM53_FUSED_SINKHORN": "1",
    "TORCH_EXTENSIONS_DIR": "{cache_dir}/torch-ext",
    "TORCHINDUCTOR_CACHE_DIR": "{cache_dir}/inductor",
    "KT_LOAD_PREFETCH": "4",
    "KT_SWIGLU_CLAMP": "1",
    "SGLANG_NSA_FUSE_TOPK": "1",
    "SGLANG_NSA_TOPK_TORCH": "1"
  },
