{
  "name": "flash-next-nvfp4",
  "description": "Qwen3.8-Flash-Next from an NVFP4 checkpoint (NVIDIA's, or an in-house NVFP4 of an abliterated model): KT NVFP4 CPU experts, a static hot-expert placement, the NVFP4 streamer edition with the lend, the int8 hc mix, the token table in host memory, two-step MTP from the bf16 draft dir with fp8-padded experts. TP2 as measured (decode ~58, 38K prefill ~4,150 t/s).",
  "tree": "sglang-v0.5.19 + trees/flash-next-gguf (the same one patch; this profile uses its NVFP4 paths)",
  "weights": {
    "gguf": false,
    "experts_from": false,
    "embed_host": 1,
    "draft": "safetensors",
    "draft_bytes_assumed": 2.6
  },
  "defaults": {
    "2": {
      "context": 262144,
      "mem_fraction": 0.85,
      "kv_dtype": "bf16",
      "mamba_slots": 32,
      "pools": 2,
      "hot": 32,
      "chunk": 16384,
      "note": "hot 32 with the static placement JSON (--placement), chunk 16384 from the lend's calibration; measured 10-05/10-06"
    }
  },
  "command": [
    "-m",
    "sglang.launch_server",
    "--model-path",
    "{config_dir}",
    "--served-model-name",
    "{served_model_name}",
    "--model-impl",
    "sglang",
    "--load-format",
    "safetensors",
    "--dtype",
    "bfloat16",
    "--host",
    "0.0.0.0",
    "--port",
    "{port}",
    "--tp",
    "{tp}",
    "--numa-node",
    "{numa_nodes}",
    "--disable-custom-all-reduce",
    "--language-model-only",
    "--prefill-attention-backend",
    "triton",
    "--decode-attention-backend",
    "trtllm_mha",
    "--linear-attn-prefill-backend",
    "flashinfer",
    "--linear-attn-decode-backend",
    "flashinfer",
    "--fp4-gemm-backend",
    "flashinfer_cutlass",
    "--moe-runner-backend",
    "flashinfer_cutlass",
    "--ple-offload-embedding",
    "--mamba-ssm-dtype",
    "bfloat16",
    "--kv-cache-dtype",
    "{kv_cache_dtype}",
    "--mamba-radix-cache-strategy",
    "extra_buffer",
    "--max-mamba-cache-size",
    "{mamba_slots}",
    "--kt-weight-path",
    "{experts_dir}",
    "--kt-method",
    "NVFP4",
    "--kt-num-gpu-experts",
    "{hot}",
    "--kt-cpuinfer",
    "{threads}",
    "--kt-threadpool-count",
    "{pools}",
    "--kt-max-deferred-experts-per-token",
    "0",
    "--context-length",
    "{context}",
    "--max-total-tokens",
    "{context}",
    "--page-size",
    "64",
    "--chunked-prefill-size",
    "{chunk}",
    "--max-prefill-tokens",
    "{chunk}",
    "--max-running-requests",
    "1",
    "--cuda-graph-max-bs-decode",
    "1",
    "--mem-fraction-static",
    "{mem_fraction}",
    "--disable-flashinfer-autotune",
    "--sampling-backend",
    "pytorch",
    "--reasoning-parser",
    "qwen3",
    "--watchdog-timeout",
    "1800"
  ],
  "command_with_draft": [
    "--speculative-draft-model-path",
    "{draft_dir}",
    "--speculative-algorithm",
    "NEXTN",
    "--speculative-num-steps",
    "2",
    "--speculative-eagle-topk",
    "1",
    "--speculative-num-draft-tokens",
    "3"
  ],
  "command_with_placement": [
    "--init-expert-location",
    "{placement}"
  ],
  "env": {
    "NCCL_P2P_DISABLE": "1",
    "NCCL_IB_DISABLE": "1",
    "SGLANG_NUMA_BIND_V2": "True",
    "KT_EMBED_HOST": "1",
    "KT_FAST_PINNED": "1",
    "KT_CUTEDSL_CACHE": "{cache_dir}/cutedsl",
    "KT_GPU_STREAM_PREFILL": "256",
    "KT_GPU_STREAM_GROUP": "64",
    "KT_GPU_STREAM_EARLY_INIT": "1",
    "KT_GPU_STREAM_SCALE_BYTES": "1",
    "KT_GPU_STREAM_FIXED_ROWS": "1",
    "KT_GPU_STREAM_DROP_CACHE": "{config_dir}",
    "KT_STREAM_MEMOPS": "1",
    "KT_PREFILL_LEND": "1",
    "KT_PREFILL_LEND_CALIBRATE": "0",
    "KT_PREFILL_LEND_HINT": "{cache_dir}/lend-hint-{key}",
    "KT_GPU_EXPERTS": "{hot}",
    "KT_EXPERT_SHM": "1",
    "KT_MXFP4_SCALE_CODES": "0",
    "KT_HC_FP8": "int8",
    "KT_HC_FP8_ALL": "1",
    "KT_PREFILL_LEND_PFONLY": "input_mix_weight",
    "KT_TASKQUEUE_SPIN_US": "300",
    "SGLANG_HOST_STAGED_ALLREDUCE": "1",
    "SGLANG_LL_ALLREDUCE": "1"
  },
  "env_by_tp": {
    "2": {}
  },
  "env_with_draft": {
    "KT_NEXT_MTP_PAD_FP8": "1",
    "KT_NEXT_MTP_GPU_ONLY": "1"
  },
  "env_with_draft_hot": {
    "KT_DRAFT_HOT": "{draft_hot}"
  }
}
